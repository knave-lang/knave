(def twice (fn (x) (mul 2 x)))
(def halve (fn (x_2) (div x_2 2)))
(def twice-body "\n\nDoubles a number.")
(def halve-body "\n\nNo documentation.")
(def twice-page-agrees (equal "(defn twice (x))\n\nDoubles a number." ((rust "format!(\"{format 0}{format 1}\", {&0}, {&1})" (where ((part-type-0 printable) (part-type-1 printable)) (fn ((ref part-type-0) (ref part-type-1)) string))) "(defn twice (x))" "\n\nDoubles a number.")))
(def main (fn () ((rust "println!(\"{format 0}{format 1}{format 2}\", {&0}, {&1}, {&2})" (where ((part-type-0_2 printable) (part-type-1_2 printable) (part-type-2 printable)) (fn ((ref part-type-0_2) (ref part-type-1_2) (ref part-type-2)) unit))) twice-body halve-body twice-page-agrees)))
