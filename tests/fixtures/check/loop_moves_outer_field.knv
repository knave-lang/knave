(defstruct badge
  :label str
  :size u16)

(defstruct garage
  :owner str
  :badge badge)

(defn main ()
  (local g
    (->garage (str "karl")
              (->badge (str "Leaf") 12)))
  (println (loop (i 0)
             (if (< i 2)
               (do
                 (local bigger (assoc (:badge g) :size 14))
                 (recur (+ i 1)))
               i))))
