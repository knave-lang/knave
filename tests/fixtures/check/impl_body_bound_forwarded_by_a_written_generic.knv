(trait first-match
  (first-match
    (fn ((ref self)) bool)))

(impl first-match (vec a)
  (first-match (items)
    (local item (at items 0))
    (local first (clone item))
    (do (local _first first) true)))

(defn checks (items) (first-match items))

(type forwards
  (where ((b first-match))
    (fn ((ref b)) bool)))

(defn forwards (items) (checks items))

(defn main ()
  (println (forwards (ref (vec 1))))
  (println (checks (ref (vec "x")))))
