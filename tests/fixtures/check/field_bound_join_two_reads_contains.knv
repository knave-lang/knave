(defstruct cat
  :tags (vec string))

(defstruct dog
  :tags (vec string))

(defstruct tag
  :tag string)

(defstruct label
  :tag string)

(defn tagged? (x y)
  (contains? (:tags x) (:tag y)))

(defn main ()
  (println (tagged? (->cat (vec (str "a")))
                    (->tag (str "a"))))
  (println (tagged? (->dog (vec (str "b")))
                    (->label (str "c")))))
