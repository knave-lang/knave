(deftrait shout
  (loud (fn ((ref self)) string)))

(defstruct toy
  :size int)

(impl shout toy
  (loud (self) (str "toy " (:size self))))

(defstruct cat
  :toy toy)

(defstruct dog
  :toy toy)

(defn yell (x) (loud (:toy x)))

(defn main ()
  (println (yell (->cat (->toy 1))))
  (println (yell (->dog (->toy 2)))))
