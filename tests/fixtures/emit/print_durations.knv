(defn main ()
  (let (pause (millis 250)
        step 3)
    (println pause)
    (println pause " at step " step)
    (println "took " pause " at step " step)
    (println "step " step " took " pause)
    (print "took " pause "\n")
    (print pause)
    (println)
    (eprintln "took " pause " at step " step)
    (eprintln pause)
    (println (str pause))
    (println (str "took " pause " at step " step))
    (println (str step " " (seconds 2) " " "done"))))
