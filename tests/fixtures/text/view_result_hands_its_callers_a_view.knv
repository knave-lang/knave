(defstruct page
  :title string)

(defn label-of ((p (ref (ref page))))
  (as-str (:title p)))

(defn title-of ((p (ref page)))
  (:title p))

(defn main ()
  (local p (->page :title (str "Leaf")))
  (local label (label-of (ref (ref p))))
  (local title (title-of (ref p)))
  (local copied
    (clone (title-of (ref p))))
  (println label title copied))
