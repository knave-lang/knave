(defn direct-adder (x)
  (local value x)
  (fn (y) (+ value y)))

(defn let-adder (x)
  (let (value x) (fn (y) (+ value y))))

(defn called-adder (x)
  ((fn (value) (fn (y) (+ value y))) x))

(defn bound-adder (x)
  (let (value x
        add (fn (y) (+ value y)))
    (println (add 0))
    add))

(defn bound-measurer (limit)
  (let (most limit
        measure (fn ((name (ref str)))
                  (+ (len name) most)))
    (println (measure ""))
    measure))

(defn picked-adder (x flag)
  (let (value x
        add (fn (y) (+ value y)))
    (if flag add add)))

(defn main ()
  (println ((direct-adder 2) 3))
  (println ((let-adder 2) 3))
  (println ((called-adder 2) 3))
  (println ((bound-adder 2) 3))
  (println ((bound-measurer 3) "ab"))
  (println ((picked-adder 2 true) 3)))
