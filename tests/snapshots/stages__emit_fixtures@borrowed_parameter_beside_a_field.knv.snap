source: tests/stages.rs
expression: reports.report(path)
input_file: tests/fixtures/emit/borrowed_parameter_beside_a_field.knv
---
#[derive(Clone, PartialEq, Eq, Hash)]
struct Page {
    file: String,
    tags: Vec<String>,
}

fn make_page(file: String, tags: Vec<String>) -> Page {
    Page { file, tags }
}

fn is_holds(pages: &[Page], target: &String) -> bool {
    pages.iter().any(|p: &Page| p.file == *target)
}

fn is_names(p: &Page, target: &String) -> bool {
    p.file == *target
}

fn is_views(p: &Page, target: &str) -> bool {
    p.file.as_str() == target
}

fn labeled(p: &Page, target: &str) -> String {
    format!("{}: {}", p.file, target)
}

fn is_printed(p: &Page, target: &str) -> bool {
    println!("{}{}", p.file, target);
    p.file.as_str() == target
}

fn is_reversed(p: &Page, target: &String) -> bool {
    *target == p.file
}

fn is_before(p: &Page, target: &String) -> bool {
    *target < p.file
}

fn is_first_is(names: &[String], target: &String) -> bool {
    names[0] == *target
}

fn is_tag_first(p: &Page, target: &String) -> bool {
    *target == p.tags[0]
}

fn is_any_tag(pages: &[Page], target: &String) -> bool {
    pages.iter().any(|p: &Page| p.tags[0] == *target)
}

fn is_same_three(p: &Page, target: String) -> bool {
    let left = &p.file;
    let middle = target;
    *left == middle && middle == p.file
}

fn is_announced(p: &Page, target: &String) -> bool {
    println!("{}{}", p.file, target);
    p.file == *target
}

fn is_named_a(p: &Page) -> bool {
    p.file == "a"
}

fn is_held_file(p: &Page) -> bool {
    let name = "a".to_string();
    let held = &name;
    *held == p.file
}

#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct Window<'a> {
    title: &'a str,
}

fn make_window(title: &str) -> Window<'_> {
    Window { title }
}

fn is_titled(w: Window<'_>, target: &str) -> bool {
    w.title == target
}

fn is_titled_a(windows: &[Window<'_>]) -> bool {
    windows.iter().any(|w: &Window<'_>| w.title == "a")
}

fn retitle(p: &mut Page, target: &String) -> bool {
    p.file = "b".to_string();
    p.file == *target
}

fn is_owned_match(p: &Page, target: &String) -> bool {
    p.file == *target
}

fn is_borrowed_match(p: &Page) -> bool {
    let title = "a".to_string();
    p.file == title
}

fn is_written_match(p: &Page) -> bool {
    let title = "a".to_string();
    p.file == title
}

fn is_reversed_owned(p: &Page, target: &String) -> bool {
    target == &p.file
}

#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct Holder<Item> {
    item: Item,
}

fn make_holder(item: &str) -> Holder<&str> {
    Holder { item }
}

fn is_holds_view(h: &Holder<&str>, target: &str) -> bool {
    h.item == target
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let items = vec![make_page("a".to_string(), vec!["t".to_string()])];
    println!("{}", is_holds(&items, &"a".to_string()));
    println!("{}", is_names(&items[0], &"b".to_string()));
    println!("{}", is_views(&items[0], "a"));
    println!("{}", labeled(&items[0], "x"));
    println!("{}", is_printed(&items[0], "a"));
    println!("{}", is_reversed(&items[0], &"a".to_string()));
    println!("{}", is_before(&items[0], &"0".to_string()));
    println!("{}", is_first_is(&items[0].tags, &"t".to_string()));
    println!("{}", is_tag_first(&items[0], &"t".to_string()));
    println!("{}", is_any_tag(&items, &"u".to_string()));
    println!("{}", is_same_three(&items[0], "a".to_string()));
    println!("{}", is_announced(&items[0], &"a".to_string()));
    println!("{}", is_named_a(&items[0]));
    println!("{}", is_held_file(&items[0]));
    let title = "a".to_string();
    println!("{}", is_titled(make_window("a"), title.as_str()));
    let mut windows = vec![make_window("b")];
    windows.push(make_window("a"));
    println!("{}", is_titled_a(&windows));
    let mut page = make_page("a".to_string(), vec!["t".to_string()]);
    println!("{}", retitle(&mut page, &"b".to_string()));
    println!("{}", is_owned_match(&items[0], &title));
    println!("{}", is_written_match(&items[0]));
    println!("{}", is_reversed_owned(&items[0], &"a".to_string()));
    println!("{}", is_holds_view(&make_holder("a"), "a"));
    println!("{}", is_borrowed_match(&items[0]))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
