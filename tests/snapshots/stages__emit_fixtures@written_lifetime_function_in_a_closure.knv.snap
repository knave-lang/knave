fn lines_longer_than<'a>(text: &'a str, shortest: &str) -> impl Iterator<Item = &'a str> {
    text.lines()
        .filter(move |line: &&'a str| line.len() > shortest.len())
}

fn main() {
    crate::rt::restore_default_sigpipe();
    lines_longer_than("ab\nb", "b").for_each(|part: &str| println!("{}", part))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
