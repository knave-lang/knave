(use coins ->float float)

(export ->float apply-macro define-named float
        generate-named generate-with i64 make-int)

(defstruct i64
  :n bool)

(defmacro make-int ()
  (template (do
              (defstruct int
                :n bool))))

(defmacro define-named (name)
  (template (defstruct (unquote name)
              :n bool)))

(defmacro apply-macro (named)
  (template ((unquote named))))

(defmacro generate-named (name)
  (template (defmacro (unquote name) ()
              (template (defstruct float
                          :n bool)))))

(defmacro generate-with (name binder)
  (template (defmacro (unquote name) ()
              (template (defstruct (unquote binder)
                          :n bool)))))
