(use code first module-symbol pinned-at require-module
          symbol symbol-name)

(use code require-modules)

(def make-loader
  (macro (form)
    (template (def (unquote (symbol (first form) "load-written"))
                (macro (form)
                  ((unquote (symbol (module-symbol (quote prelude/syntax))
                                    "require-module"))
                   (quote noted/birds)))))))

(make-loader)

(def loaded (load-written))

(def make-internal-loader
  (macro (form)
    (template (def (unquote (symbol (first form) "load-internal"))
                (macro (form)
                  ((unquote (symbol (module-symbol (quote prelude/syntax))
                                    "require-module"))
                   (quote prelude/internal/macros)))))))

(make-internal-loader)

(def internal (load-internal))

(use prelude/internal/code require-module)

(def internal-code-symbol
  (macro (form)
    (symbol-name (module-symbol (quote prelude/internal/code)))))

(def internal-code (internal-code-symbol))
