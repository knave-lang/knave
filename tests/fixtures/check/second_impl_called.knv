(enum (wrap a) (wrapped a))

(trait labelled
  (label (fn ((ref self)) i64)))

(impl labelled (wrap i64) (label (w) 1))

(impl labelled (wrap a) (label (w) 2))

(trait consumed (take (fn (self) i64)))

(impl consumed str (take (t) 0))

(impl consumed str (take (t) 0))

(defn main ()
  (println (label (wrap/wrapped true))))
