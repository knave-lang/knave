fn bump(items: &mut [i64], i: i64) -> i64 {
    items[crate::rt::index(i)] += 1;
    items[crate::rt::index(i)]
}

fn bump_through(scores: &mut [i64], order: &[i64], k: i64) -> i64 {
    scores[crate::rt::index(order[crate::rt::index(k)])] += 1;
    scores[2]
}

fn bump_at(items: &mut [i64], j: i64) -> i64 {
    items[crate::rt::index(j)] += 1;
    items[crate::rt::index(j)]
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut items: Vec<i64> = vec![10_i64, 20_i64, 30_i64];
    let i: i64 = 1;
    let far: i64 = i + 1;
    let pick = |argument_0: &Vec<i64>, argument_1: i64| argument_0[crate::rt::index(argument_1)];
    println!("{}", items[crate::rt::index(i)]);
    println!("{}", items[0]);
    println!("{}", items[crate::rt::index(far - 1)]);
    println!("{}", pick(&items, far));
    println!("{}", items[1] + 5);
    println!("{}", items[1] + (if i == 1 { 5 } else { 6 }));
    println!("{}", bump(&mut items, i));
    {
        let mut order: Vec<i64> = vec![2_i64, 0_i64];
        order.push(1);
        println!("{}", bump_through(&mut items, &order, 0))
    }
    println!("{}", bump_at(&mut items, 2))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn index(value: i64) -> usize {
        match usize::try_from(value) {
            Ok(index) => index,
            Err(_) => negative(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn negative(value: i64) -> ! {
        panic!("attempt to use a negative value as an index or a size: {value}")
    }
}
