(enum app-error
  (io io-error)
  (parse (parse-error i64)))

(type read-number
  (fn ((ref str)) (result i64 app-error)))

(defn read-number (path)
  (local text (try (slurp path)))
  (ok (try (parse text))))

(defn main ()
  (local arguments (command-line-args))
  (local good (unwrap (get arguments 0)))
  (local bad (unwrap (get arguments 1)))
  (local missing (unwrap (get arguments 2)))
  (match (read-number good)
    ((ok number) (println number))
    ((err (app-error/io _reason)) (println "cannot read"))
    ((err (app-error/parse _reason)) (println "not a number")))
  (match (read-number bad)
    ((ok number) (println number))
    ((err (app-error/io _reason)) (println "cannot read"))
    ((err (app-error/parse _reason)) (println "not a number")))
  (match (read-number missing)
    ((ok number) (println number))
    ((err (app-error/io _reason)) (println "cannot read"))
    ((err (app-error/parse _reason)) (println "not a number"))))
