(defstruct bag
  :items (vec int))

(defstruct sack
  :items (vec int))

(defn count-items (x) (len (:items x)))

(defn first-item (x) (get (:items x) 0))

(defn main ()
  (println (count-items (->bag (vec 1 2))))
  (println (count-items (->sack (vec 1 2 3))))
  (prn (first-item (->bag (vec 7))))
  (prn (first-item (->sack (vec 8)))))
