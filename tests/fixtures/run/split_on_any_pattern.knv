(type part-count
  (where ((p pattern))
    (fn ((ref str) p) int)))

(defn part-count (text separator)
  (count (split text separator)))

(defn main ()
  (println (part-count "a,b,c" ","))
  (println (part-count "a b" (char "x")))
  (println (part-count "a1b2c" digit?))
  (let (strings (vec))
    (push! strings (str ";"))
    (for-each (iter strings)
      (fn (separator)
        (println (part-count "a;b" separator))
        (println (count (split "a;b;c" separator))))))
  (let (literals (vec))
    (push! literals ",")
    (push! literals ";")
    (for-each (iter literals)
      (fn (separator)
        (println (part-count "a,b;c" separator))
        (println (count (split "a,b;c" separator))))))
  (println (count (split "a,b" ",")))
  (println (count (split "a b" (char " "))))
  (println (count (split "a1b" digit?))))
