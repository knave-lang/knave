(defn local-greeter! (name)
  (set! name (str "pear"))
  (local value (clone name))
  (local greet (fn () (str "hi " value)))
  (println "ready")
  greet)

(defn loop-greeter! (name)
  (set! name (str "plum"))
  (local value (clone name))
  (loop (i 0)
    (if (> i 2)
      (fn () (str "hi " value))
      (recur (+ i 1)))))

(defn tagged! (name ys)
  (set! name (str "fig"))
  (local value (clone name))
  (map (iter ys)
    (fn (y) (+ (deref y) (len value)))))

(defn main ()
  (local name (str "apple"))
  (println ((local-greeter! name)) name)
  (println ((loop-greeter! name)) name)
  (local ys (vec 10 20))
  (for-each (tagged! name ys)
    (fn (v) (println v)))
  (println name))
