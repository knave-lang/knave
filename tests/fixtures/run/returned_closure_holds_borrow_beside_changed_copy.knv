(defn counter! (x items)
  (set! x (+ x 1))
  (local it (iter items))
  (fn () (count it)))

(defn adder! (x)
  (set! x (+ x 1))
  (local g (fn (y) (+ y 1)))
  (fn (y) (g y)))

(defn chained! (items)
  (push! items 1)
  (local it (iter items))
  (local twice
    (map it (fn (i) (* (deref i) 2))))
  (fn () (count twice)))

(defn shifted! (x items)
  (set! x (+ x 1))
  (local n (- x 1))
  (local it (take (iter items) n))
  (fn () (count it)))

(defn sizer! (items)
  (push! items 1)
  (local n (len items))
  (fn () (+ n 1)))

(defn main ()
  (local a 1)
  (local items (vec 0 0))
  (local c (counter! a items))
  (println a)
  (set! a 5)
  (println (c))
  (println a)
  (local b 1)
  (local add (adder! b))
  (println b)
  (println (add 2))
  (println ((chained! items)))
  (local d 1)
  (local s (shifted! d items))
  (println d)
  (println (s))
  (local size (sizer! items))
  (println (len items))
  (println (size)))
