(deftrait bigger
  (bigger?
    (fn ((ref self) (ref self)) bool)))

(impl bigger int
  (bigger? (self other)
    (> (deref self) (deref other))))

(defstruct cat
  :n int)

(defstruct dog
  :n int)

(defn wins? (x y)
  (bigger? (:n x) (:n y)))

(defn main ()
  (println (wins? (->cat 3) (->dog 2)))
  (println (wins? (->dog 1) (->cat 2))))
