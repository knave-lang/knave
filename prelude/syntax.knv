(use prelude/macros defmacro defrule document header-shape
                    map-list template)

(use prelude/internal/macros docstring-before-body?
                             docstring-before-parameters
                             note-docstring value-doc-key
                             whole-pairs?)

(use prelude/internal/syntax call-signature declared-forms
                             declared-name default-bindings
                             default-pairs defaults-clause?
                             definition find-keyword
                             has-argument? joined-names
                             key-names-one-of? keyword-of?
                             names-without-argument
                             pair-keys read-call
                             signature-defaults
                             signature-name signature-names
                             type-missing?
                             unknown-key-error)

(use code bool-not closest-name concat declare-definition
          drop empty? fail field-keyword first keyword-field
          keyword-name keyword-trim-end keyword? len list
          list? nth number-sub number? pattern-head? prepend
          rest same-binding? string string? symbol
          symbol-name symbol? take value-eq)

(export -> ->> comment defn let let-match let-try loop the
        try->)

(def let
  (macro (form)
    (prepend (quote do)
             (concat (local-steps (binding-list form))
                     (drop form 2)))))

(header-shape (let bindings) :bindings)

(document (let (name value
                ...)
            body ...)
  "Binds names to values for its body.

  Each value sees the names bound before it, and the value of the body
  is the value of its last form. To bind a name for the rest of the
  enclosing body, write `local`.")

(def local-steps
  (fn (bindings)
    (local-steps-onto (list) bindings)))

(def local-steps-onto
  (fn (steps bindings)
    (if (empty? bindings)
      steps
      (recur (concat steps (list (local-step bindings)))
             (drop bindings 2)))))

(def local-step
  (fn (bindings)
    (list (quote local)
          (first bindings)
          (nth bindings 1))))

(def binding-list
  (fn (form)
    (if (bindings-written? form)
      (checked-bindings form (nth form 1))
      (unlisted-bindings form))))

(def bindings-written?
  (fn (form)
    (if (empty? (rest form))
      false
      (list? (nth form 1)))))

(def checked-bindings
  (fn (form bindings)
    (if (parenthesized-pairs? bindings pair-list?)
      (parenthesized-pairs form bindings pair-list?)
      (if (whole-pairs? bindings)
        (bindings-with-body form bindings)
        (name-without-value form bindings)))))

(def bindings-with-body
  (fn (form bindings)
    (if (empty? (drop form 2))
      (bindings-without-body form bindings)
      bindings)))

(def form-name
  (fn (form) (symbol-name (first form))))

(def elided-call
  (fn (form bindings)
    (list (first form) bindings (quote ...))))

(def let-call?
  (fn (form)
    (same-binding? (first form) (quote let))))

(def parenthesized-pairs?
  (fn (bindings paired?)
    (if (whole-pairs? bindings)
      (bool-not (empty? (parenthesized-binders bindings paired?)))
      false)))

(def parenthesized-binders
  (fn (bindings paired?)
    (if (empty? bindings)
      bindings
      (if (parenthesized-pair? (first bindings) paired?)
        bindings
        (recur (drop bindings 2) paired?)))))

(def parenthesized-pair?
  (fn (binder paired?)
    (if (paired? binder)
      (literal? (nth binder 1))
      false)))

(def pair-list?
  (fn (item)
    (if (list? item)
      (value-eq (len item) 2)
      false)))

(def literal?
  (fn (item)
    (if (number? item)
      true
      (if (string? item) true (boolean-constant? item)))))

(def boolean-constant?
  (fn (item)
    (if (symbol? item)
      (if (same-binding? item (quote true))
        true
        (same-binding? item (quote false)))
      false)))

(def parenthesized-pairs
  (fn (form bindings paired?)
    (fail (string "each name and its value go straight into the binding "
                  "list of `"
                  (form-name form)
                  "`, without their own parentheses")
      (first (parenthesized-binders bindings paired?))
      (string "write it as `"
              (elided-call form (unwrapped-pairs bindings))
              "`")
      (quote (:code malformed-binding-list
                    :label "a name and its value in their own parentheses")))))

(def unwrapped-pairs
  (fn (bindings)
    (unwrapped-onto (list) bindings)))

(def unwrapped-onto
  (fn (unwrapped bindings)
    (if (empty? bindings)
      unwrapped
      (recur (concat unwrapped (unwrapped-item (first bindings)))
             (rest bindings)))))

(def unwrapped-item
  (fn (item)
    (if (pair-list? item) item (list item))))

(def name-without-value
  (fn (form bindings)
    (fail (string "a name in the binding list of `"
                  (form-name form)
                  "` has no value")
      (nth bindings (number-sub (len bindings) 1))
      (value-help form bindings pair-list?)
      (quote (:code binding-without-value
                    :label "this name has no value")))))

(def value-help
  (fn (form bindings paired?)
    (local with-value (with-value-help form bindings))
    (if (every-binder? bindings paired?)
      (string with-value
              ", or write each name and its value without their own "
              "parentheses, as `"
              (elided-call form (unwrapped-pairs bindings))
              "`")
      with-value)))

(def with-value-help
  (fn (form bindings)
    (string "write its value after it, as `"
            (elided-call form
                         (concat bindings (list (quote value))))
            "`")))

(def every-binder?
  (fn (items paired?)
    (if (empty? items)
      true
      (if (paired? (first items))
        (recur (rest items) paired?)
        false))))

(def bindings-without-body
  (fn (form bindings)
    (fail (string "`" (form-name form) "` has no body")
      form
      (body-help form bindings)
      (quote (:code bindings-without-body
                    :label "its bindings reach no form")))))

(def body-help
  (fn (form bindings)
    (if (let-call? form)
      (string "write the forms that use the bindings after the list; "
              "to bind a name for the rest of the body, write `"
              (first-local-step bindings)
              "`")
      "write the forms that use the bindings after the list")))

(def first-local-step
  (fn (bindings)
    (if (empty? bindings)
      (quote (local name value))
      (local-step bindings))))

(def unlisted-bindings
  (fn (form)
    (if (empty? (rest form))
      (fail (string "`" (form-name form) "` takes a list of bindings")
        form
        (generic-binding-help form)
        (quote (:code malformed-binding-list
                      :label "this has no list of bindings")))
      (fail (string "`" (form-name form) "` takes a list of bindings")
        (nth form 1)
        (unlisted-help form)
        (quote (:code malformed-binding-list
                      :label "not a list of bindings"))))))

(def unlisted-help
  (fn (form)
    (if (flat-binding? form)
      (flat-binding-help form)
      (generic-binding-help form))))

(def flat-binding?
  (fn (form)
    (if (name? (nth form 1))
      (bool-not (empty? (drop form 2)))
      false)))

(def name?
  (fn (form)
    (if (symbol? form)
      (bool-not (keyword? form))
      false)))

(def generic-binding-help
  (fn (form)
    (string "write it as `("
            (form-name form)
            " (name value) body ...)`")))

(def flat-binding-help
  (fn (form)
    (if (let-call? form)
      (flat-let-help form)
      (string "write the bindings in a list, as `"
              (elided-call form (flat-pair form))
              "`"))))

(def flat-pair
  (fn (form)
    (list (nth form 1) (nth form 2))))

(def flat-let-help
  (fn (form)
    (if (empty? (drop form 3))
      (string "to bind `"
              (symbol-name (nth form 1))
              "` for the rest of the body, write `"
              (prepend (quote local) (flat-pair form))
              "`; to define it for the module, write `"
              (prepend (quote def) (flat-pair form))
              "`")
      (string "write the bindings in a list, as `"
              (prepend (first form)
                       (prepend (flat-pair form) (drop form 3)))
              "`"))))

(defmacro defn (name parameters body ...)
  "Defines a function: (defn name (parameter ...) body ...).

  A string before at least one more body form is the docstring."
  (declare-definition name)
  (if (string? parameters)
    (docstring-before-parameters parameters)
    (if (docstring-before-body? body)
      (do
        (note-docstring (value-doc-key name) (first body))
        (function-definition name parameters (rest body)))
      (function-definition name parameters body))))

(header-shape (defn name parameters) :docstring)

(def function-definition
  (fn (name parameters body)
    (if (keyword-parameters? parameters)
      (keyword-function name parameters body)
      (template (def (unquote name)
                  (fn (unquote parameters) (splice body)))))))

(def keyword-parameters?
  (fn (parameters)
    (if (list? parameters)
      (if (empty? parameters)
        false
        (keyword? (first parameters)))
      false)))

(def keyword-function
  (fn (name parameters body)
    (local declared (declared-forms parameters))
    (local binders (parameter-binders declared))
    (local names (map-list binders binder-name))
    (check-distinct-parameters (parameter-keywords declared))
    (local defaults
      (default-bindings (default-pairs parameters)
                        (parameter-definition name)
                        names))
    (local signature (call-signature name names defaults))
    (local positional
      (symbol (quote function) (symbol-name name)))
    (template (do
                (def (unquote positional)
                  (fn (unquote binders) (splice body)))
                (def (unquote name)
                  (macro (form)
                    (keyword-call-expansion form
                                            (quote (unquote positional))
                                            (quote (unquote signature)))))))))

(def parameter-definition
  (fn (name)
    (definition name "parameter" field-keyword
                (quote unknown-parameter))))

(def parameter-binders
  (fn (forms)
    (if (empty? forms)
      (list)
      (prepend (parameter-binder (first forms) (rest forms))
               (parameter-binders (drop forms
                                        (parameter-width (rest forms))))))))

(def parameter-binder
  (fn (keyword more)
    (local name (parameter-name keyword))
    (if (type-missing? more)
      name
      (list name (first more)))))

(def parameter-name
  (fn (keyword)
    (if (keyword? keyword)
      (declared-name keyword "parameter")
      (parameter-start-error keyword))))

(def parameter-start-error
  (fn (form)
    (if (defaults-clause? form)
      (fail "a function takes one `defaults` clause, after its parameters"
        form "move the defaults to the end")
      (fail "a parameter must start with `:`"
        form
        (string "write each parameter as `:name type` or `:name`, as in "
                "(defn add (:x i64 :y i64) (+ x y))")))))

(def parameter-width
  (fn (more)
    (if (type-missing? more) 1 2)))

(def binder-name
  (fn (binder)
    (if (list? binder) (first binder) binder)))

(def parameter-keywords
  (fn (forms)
    (if (empty? forms)
      (list)
      (prepend (first forms)
               (parameter-keywords (drop forms
                                         (parameter-width (rest forms))))))))

(def check-distinct-parameters
  (fn (keywords)
    (if (empty? keywords)
      keywords
      (do
        (check-declared-once (first keywords) (rest keywords))
        (check-distinct-parameters (rest keywords))))))

(def check-declared-once
  (fn (keyword later-keywords)
    (local repeated (find-keyword keyword later-keywords))
    (if (empty? repeated)
      keyword
      (fail (string "`" (keyword-name keyword) "` is declared twice")
        (first repeated)
        "give each parameter its own name"))))

(def required-names
  (fn (signature)
    (names-without-default (signature-names signature)
                           (signature-defaults signature))))

(def names-without-default
  (fn (names defaults)
    (if (empty? names)
      (list)
      (if (empty? (default-of (first names) defaults))
        (prepend (first names)
                 (names-without-default (rest names) defaults))
        (names-without-default (rest names) defaults)))))

(def default-of
  (fn (name defaults)
    (if (empty? defaults)
      defaults
      (if (value-eq (symbol-name (first (first defaults)))
                    (symbol-name name))
        (first defaults)
        (default-of name (rest defaults))))))

(def keyword-call-expansion
  (fn (form positional signature)
    (if (symbol? form)
      positional
      (keyword-call form positional signature))))

(def keyword-call
  (fn (form positional signature)
    (local owner
      (parameter-definition (signature-name signature)))
    (read-call form positional signature owner
               (fn (form) (named-call form positional signature owner)))))

(def named-call
  (fn (form positional signature owner)
    (local pairs (rest form))
    (local keys (pair-keys pairs))
    (check-call-keys keys keys signature owner)
    (check-required-parameters form keys signature)
    (if (needs-temporaries? pairs (signature-names signature))
      (call-through-temporaries pairs positional signature)
      (prepend positional (positional-arguments pairs signature)))))

(def check-call-keys
  (fn (keys given-keys signature owner)
    (if (empty? keys)
      keys
      (do
        (check-call-key (first keys) given-keys signature owner)
        (check-given-once (first keys) (rest keys) signature)
        (check-call-keys (rest keys) given-keys signature owner)))))

(def check-call-key
  (fn (key keys signature owner)
    (if (key-names-one-of? key (signature-names signature))
      key
      (unknown-parameter-error key keys signature owner))))

(def unknown-parameter-error
  (fn (key keys signature owner)
    (unknown-key-error key owner
                       (signature-names signature)
                       keys)))

(def check-given-once
  (fn (key later-keys signature)
    (local repeated (find-keyword key later-keys))
    (if (empty? repeated)
      key
      (fail (string "`"
                    (symbol-name key)
                    "` is given twice in `"
                    (signature-name signature)
                    "`")
        (first repeated)
        (string "remove the second `"
                (symbol-name key)
                "` and its value")
        (template (:code repeated-parameter
                         :earlier (unquote key)
                         :label "given again here"
                         :earlier-label "first given here"))))))

(def check-required-parameters
  (fn (form keys signature)
    (local missing
      (names-without-argument (required-names signature) keys))
    (if (empty? missing)
      missing
      (fail (string (if (value-eq (len missing) 1)
                      "missing parameter "
                      "missing parameters ")
                    (joined-names missing "`")
                    " in `"
                    (signature-name signature)
                    "`")
        form
        (string "name every parameter without a default: "
                (joined-names missing ""))))))

(def positional-arguments
  (fn (pairs signature)
    (map-list (signature-names signature)
              (fn (name)
                (argument-for name pairs (signature-defaults signature))))))

(def argument-for
  (fn (name pairs defaults)
    (local given (pair-of name pairs))
    (if (empty? given)
      (nth (default-of name defaults) 1)
      (nth given 1))))

(def pair-of
  (fn (name pairs)
    (if (empty? pairs)
      pairs
      (if (keyword-of? (first pairs) name)
        pairs
        (pair-of name (drop pairs 2))))))

(def needs-temporaries?
  (fn (pairs names)
    (if (keys-in-order? (pair-keys pairs) names)
      false
      (any-compound-value? pairs))))

(def keys-in-order?
  (fn (keys names)
    (if (empty? keys)
      true
      (if (empty? names)
        false
        (if (keyword-of? (first keys) (first names))
          (keys-in-order? (rest keys) (rest names))
          (keys-in-order? keys (rest names)))))))

(def any-compound-value?
  (fn (pairs)
    (if (empty? pairs)
      false
      (if (list? (nth pairs 1))
        true
        (any-compound-value? (drop pairs 2))))))

(def call-through-temporaries
  (fn (pairs positional signature)
    (local call
      (prepend positional
               (positional-arguments (bound-pairs pairs) signature)))
    (list (quote let) (temporary-bindings pairs) call)))

(def bound-pairs
  (fn (pairs)
    (if (empty? pairs)
      (list)
      (concat (list (first pairs) (bound-value pairs))
              (bound-pairs (drop pairs 2))))))

(def bound-value
  (fn (pairs)
    (if (list? (nth pairs 1))
      (temporary (first pairs))
      (nth pairs 1))))

(def temporary
  (fn (key)
    (symbol (quote temporary) (keyword-name key))))

(def temporary-bindings
  (fn (pairs)
    (if (empty? pairs)
      (list)
      (if (list? (nth pairs 1))
        (prepend (temporary (first pairs))
                 (prepend (nth pairs 1)
                          (temporary-bindings (drop pairs 2))))
        (temporary-bindings (drop pairs 2))))))

(def loop
  (macro (form)
    (local bindings (binding-list form))
    (if (sequential-values? bindings)
      (template (let (unquote bindings)
                  (unquote (loop-call form bindings
                                      (map-list (binders bindings)
                                                binder-name)))))
      (loop-call form bindings (binding-values bindings)))))

(def loop-call
  (fn (form bindings arguments)
    (template ((fn (unquote (binders bindings))
                 (splice (drop form 2)))
               (splice arguments)))))

(header-shape (loop bindings) :bindings)

(def sequential-values?
  (fn (bindings)
    (names-earlier-binder? (list) bindings)))

(def names-earlier-binder?
  (fn (earlier bindings)
    (if (empty? bindings)
      false
      (if (mentions-any? (nth bindings 1) earlier)
        true
        (recur (prepend (binder-name (first bindings)) earlier)
               (drop bindings 2))))))

(def mentions-any?
  (fn (form names)
    (if (list? form)
      (any-mentions? form names)
      (if (symbol? form) (named-in? form names) false))))

(def any-mentions?
  (fn (forms names)
    (if (empty? forms)
      false
      (if (mentions-any? (first forms) names)
        true
        (recur (rest forms) names)))))

(def named-in?
  (fn (symbol names)
    (if (empty? names)
      false
      (if (value-eq (symbol-name symbol)
                    (symbol-name (first names)))
        true
        (recur symbol (rest names))))))

(def binding-values
  (fn (bindings)
    (binding-values-onto (list) bindings)))

(def binding-values-onto
  (fn (found bindings)
    (if (empty? bindings)
      found
      (recur (concat found (list (nth bindings 1)))
             (drop bindings 2)))))

(def binders
  (fn (bindings)
    (binders-onto (list) bindings)))

(def binders-onto
  (fn (found bindings)
    (if (empty? bindings)
      found
      (recur (concat found (list (first bindings)))
             (drop bindings 2)))))

(defrule the
  ((type-expression value)
   (let ((result type-expression) value) result)))

(defrule comment ((form ...) (do)))

(header-shape (comment))

(defrule ->
  ((value) value)
  ((value (head arguments ...) more ...)
   (-> (head value arguments ...) more ...))
  ((value head more ...) (-> (head value) more ...)))

(defrule ->>
  ((value) value)
  ((value (head arguments ...) more ...)
   (->> (head arguments ... value) more ...))
  ((value head more ...) (->> (head value) more ...)))

(def let-try
  (macro (form)
    (template (let (unquote (tried-bindings (binding-list form)))
                (splice (drop form 2))))))

(header-shape (let-try bindings) :bindings)

(def tried-bindings
  (fn (bindings)
    (tried-onto (list) bindings)))

(def tried-onto
  (fn (tried bindings)
    (if (empty? bindings)
      tried
      (recur (concat tried
                     (list (first bindings)
                           (list (quote try) (nth bindings 1))))
             (drop bindings 2)))))

(def let-match
  (macro (form)
    (prepend (quote do)
             (matched-body (reversed-bindings (pattern-binding-list form))
                           (drop form 2)))))

(header-shape (let-match bindings) :bindings)

(def pattern-binding-list
  (fn (form)
    (if (bindings-written? form)
      (checked-patterns form (nth form 1))
      (unlisted-bindings form))))

(def checked-patterns
  (fn (form bindings)
    (if (parenthesized-pairs? bindings name-pair-list?)
      (parenthesized-pairs form bindings name-pair-list?)
      (if (whole-pairs? bindings)
        (bindings-with-body form bindings)
        (pattern-without-value form bindings)))))

(def name-pair-list?
  (fn (item)
    (if (pair-list? item)
      (plain-name? (first item))
      false)))

(def plain-name?
  (fn (form)
    (if (name? form)
      (bool-not (pattern-head? form))
      false)))

(def pattern-without-value
  (fn (form bindings)
    (fail "a pattern in the binding list of `let-match` has no value"
      (nth bindings (number-sub (len bindings) 1))
      (value-help form bindings name-pair-list?)
      (quote (:code binding-without-value
                    :label "this pattern has no value")))))

(def matched-body
  (fn (bindings body)
    (if (empty? bindings)
      body
      (recur (rest bindings)
             (list (one-arm-match (first bindings) body))))))

(def one-arm-match
  (fn (binding body)
    (list (quote match)
          (nth binding 1)
          (prepend (first binding) body))))

(def reversed-bindings
  (fn (bindings)
    (reversed-bindings-onto (list) bindings)))

(def reversed-bindings-onto
  (fn (reversed bindings)
    (if (empty? bindings)
      reversed
      (recur (prepend (list (first bindings) (nth bindings 1))
                      reversed)
             (drop bindings 2)))))

(defrule try->
  ((value) value)
  ((value head) (head value))
  ((value head more ...) (try-> (try (head value)) more ...)))

(document (->> value form ...)
  "Threads a value through each form as its last argument.

  `(->> 3 (- 10) (* 2))` is `(* 2 (- 10 3))`. A bare name in place of a form
  is called with the value alone.")

(document (the type value)
  "Gives a value a written type.

  It binds the value with an annotated `let` and returns it, so a literal is
  checked against the type and a value that is not `copy` moves. A value of
  another type is an error, except that a borrowed `string`, `(ref name)`,
  passes as a `(ref str)`.")

(document (loop (name value
                 ...)
            body ...)
  "Binds names to values and runs a body that `recur` repeats.

  The list is the binding list of `let`, so each value sees the names bound
  before it. A name given twice is an error, because `recur` passes one value
  per name.

  `(recur new-value ...)` in tail position runs the body again with each name
  bound to its new value. The call returns the body's last value.

  The body is a function, so `try`, `let-try` and `try->` in it leave the loop
  with the failure, not the enclosing function.")

(document (let-try (name value
                    ...)
            body ...)
  "Binds each name to the value inside a `result` or an `option`, in order.

  The list is the binding list of `let`.

  Each value goes through `try`, so the first `err` or `none` returns from the
  enclosing function, or leaves the enclosing `loop`. That function must
  return a `result` or an `option` of the same kind.")

(document (let-match (pattern value
                      ...)
            body ...)
  "Binds the names of each pattern to the parts of its value, in order.

  The list is the binding list of `let`, with a `match` pattern in place of
  each name, so `(let-match ((pair word count) entry) body ...)` binds `word`
  and `count`. Each value sees the names bound before it. Each pattern is a
  one-arm `match`, so a pattern that some value fails, such as `(some x)`, is
  an error that names the missing case. On an owned value, each name moves its
  part unless the part is `copy`, and `_` leaves its part in place.")

(document (try-> value function ...)
  "Calls each function on the result of the one before, through `try`.

  `(try-> x f g)` is `(g (try (f x)))`, so the first `err` or `none` returns
  from the enclosing function, or leaves the enclosing `loop`, and the last
  result is returned as it is. With no function, the call returns the value.

  Unlike `->`, a step takes no extra arguments: a call form is a call whose
  result is the function, so `(try-> x (make-step))` is `((make-step) x)`.")

(document (comment form ...)
  "Keeps forms in the source that never expand, check or run.

  The call is unit, so a file can hold scratch expressions to evaluate one at
  a time from an editor.")

(document (-> value form ...)
  "Threads a value through each form as its first argument.

  `(-> 3 (- 10) (* 2))` is `(* (- 3 10) 2)`. A bare name in place of a form is
  called with the value alone.")
