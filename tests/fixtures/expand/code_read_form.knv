(use code first len nth read-form)

(defmacro read-at (text character)
  (first (read-form (quote here) text character)))

(defmacro end-of-form (text)
  (nth (read-form (quote here) text 0) 1))

(defmacro forms-read (text)
  (len (read-form (quote here) text 0)))

(def sum (read-at "(+ 1 1) tail" 0))

(def tail (read-at "(+ 1 1) 7" 8))

(def end (end-of-form "(+ 1 1) tail"))

(def nothing (forms-read "(+ 1"))
