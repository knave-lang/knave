fn shift(x: &mut i64, y: &mut i64) -> impl Fn(i64) -> i64 + use<> {
    *x += 1;
    *y += 1;
    let pad: i64 = 0;
    let x_2: i64 = *x;
    move |z: i64| z + x_2
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut a: i64 = 1;
    let mut b: i64 = 1;
    let add = shift(&mut a, &mut b);
    println!("{}{}", a, b);
    println!("{}", add(1))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
