fn count_years(years: &[i64]) -> i64 {
    crate::rt::length(years.len())
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let years: Vec<i64> = vec![2011_i64, 2019_i64, 2024_i64];
    println!("{}", crate::rt::length(years.len()));
    println!("{}", count_years(&years));
    let prices: std::collections::HashMap<&str, i64> = {
        let mut map = std::collections::HashMap::new();
        map.insert("leaf", 28000_i64);
        map.insert("ariya", 39000_i64);
        map
    };
    println!("{}", crate::rt::length(prices.len()));
    println!(
        "{}",
        crate::rt::count(years.iter().filter(|year: &&i64| **year > 2015))
    )
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn length(value: usize) -> i64 {
        match i64::try_from(value) {
            Ok(length) => length,
            Err(_) => too_long(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn too_long(value: usize) -> ! {
        panic!("length does not fit in int: {value}")
    }

    #[inline]
    #[track_caller]
    pub fn count(items: impl Iterator) -> i64 {
        let counted = items.count();
        match i64::try_from(counted) {
            Ok(count) => count,
            Err(_) => count_overflow(counted),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn count_overflow(counted: usize) -> ! {
        panic!("attempt to count with overflow: the count is {counted}")
    }
}
