(defn greeter (name)
  (fn () (println (str "hi " name))))

(defn main ()
  (let (s (str "a")
        extended-half (greeter (loop (p (pair (ref (str "zz")) (as-str s)))
                                 (let-match ((pair a _) p) a)))
        receiver-half (greeter (loop (p (pair (ref (as-str (str "yy")))
                                              (as-str s)))
                                 (let-match ((pair a _) p) a)))
        dying-half (greeter (loop (p (pair (ref (str "xx"))
                                           (as-str (str "ww"))))
                              (let-match ((pair _ b) p) b))))
    (extended-half)
    (receiver-half)
    (dying-half)))
