fn direct_adder(x: i64) -> impl Fn(i64) -> i64 {
    let value: i64 = x;
    move |y: i64| value + y
}

fn let_adder(x: i64) -> impl Fn(i64) -> i64 {
    let value: i64 = x;
    move |y: i64| value + y
}

fn called_adder(x: i64) -> impl Fn(i64) -> i64 {
    let value: i64 = x;
    move |y: i64| value + y
}

fn bound_adder(x: i64) -> impl Fn(i64) -> i64 {
    let value: i64 = x;
    let add = move |y: i64| value + y;
    println!("{}", add(0));
    add
}

fn bound_measurer(limit: i64) -> impl Fn(&str) -> i64 {
    let most: i64 = limit;
    let measure = move |name: &str| crate::rt::length(name.len()) + most;
    println!("{}", measure(""));
    measure
}

fn picked_adder(x: i64, flag: bool) -> impl Fn(i64) -> i64 {
    let value: i64 = x;
    let add = move |y: i64| value + y;
    if flag { add } else { add }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", direct_adder(2)(3));
    println!("{}", let_adder(2)(3));
    println!("{}", called_adder(2)(3));
    println!("{}", bound_adder(2)(3));
    println!("{}", bound_measurer(3)("ab"));
    println!("{}", picked_adder(2, true)(3))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn length(value: usize) -> i64 {
        match i64::try_from(value) {
            Ok(length) => length,
            Err(_) => too_long(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn too_long(value: usize) -> ! {
        panic!("length does not fit in int: {value}")
    }
}
