#[derive(Clone, PartialEq, Eq, Hash)]
struct Counter {
    hits: i64,
}

fn make_counter(hits: i64) -> Counter {
    Counter { hits }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut total: i64 = 1;
    total += 2;
    total = 10 - total;
    let mut tally = make_counter(0);
    tally.hits *= 3;
    println!("{}{}", total, tally.hits)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
