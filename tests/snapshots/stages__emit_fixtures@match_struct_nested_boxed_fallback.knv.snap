source: tests/stages.rs
expression: reports.report(path)
input_file: tests/fixtures/emit/match_struct_nested_boxed_fallback.knv
---
#[derive(Clone, PartialEq, Eq, Hash)]
enum Tree<A> {
    Node(Box<Tree<A>>, A, Box<Tree<A>>),
    Leaf,
}

#[derive(Clone, PartialEq, Eq, Hash)]
struct Holder {
    tree: Tree<i64>,
}

fn held_value(holder: &Holder) -> i64 {
    match holder {
        Holder {
            tree: Tree::Node(inner, _, _),
        } if matches!(&**inner, Tree::Node(_, _, _)) => {
            let Tree::Node(_, value, _) = &**inner else {
                unreachable!()
            };
            *value
        }
        Holder {
            tree: Tree::Node(inner, value, _),
        } if matches!(&**inner, Tree::Leaf) => *value,
        Holder { tree: Tree::Leaf } => 0,
        _ => unreachable!(),
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        held_value(&Holder {
            tree: Tree::Node(
                Box::new(Tree::Node(Box::new(Tree::Leaf), 7, Box::new(Tree::Leaf))),
                1,
                Box::new(Tree::Leaf)
            )
        })
    );
    println!(
        "{}",
        held_value(&Holder {
            tree: Tree::Node(Box::new(Tree::Leaf), 2, Box::new(Tree::Leaf))
        })
    );
    println!("{}", held_value(&Holder { tree: Tree::Leaf }))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
