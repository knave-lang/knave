fn main() {
    crate::rt::restore_default_sigpipe();
    let mut tricks = vec!["feint", "vanish"];
    tricks.iter().for_each(|trick: &&str| {
        let shown = {
            let template_argument_0 = *trick;
            format!("{} {}", "a,template_argument_0)", template_argument_0)
        };
        println!("{}", shown)
    });
    tricks.push("dash");
    println!("{}", crate::rt::length(tricks.len()))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn length(value: usize) -> i64 {
        match i64::try_from(value) {
            Ok(length) => length,
            Err(_) => too_long(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn too_long(value: usize) -> ! {
        panic!("length does not fit in int: {value}")
    }
}
