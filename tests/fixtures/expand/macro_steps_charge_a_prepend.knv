(use code number-gt number-sub prepend)

(defmacro grows (times)
  ((fn (items remaining)
     (if (number-gt remaining 0)
       (recur (prepend (quote a) items) (number-sub remaining 1))
       (quote 1)))
   (quote ())
   times))

(with-macro-steps 1000
                  (defn main () (println (grows 400))))
