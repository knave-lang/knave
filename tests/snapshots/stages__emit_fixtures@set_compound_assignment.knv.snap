input_file: tests/fixtures/emit/set_compound_assignment.knv
---
#[derive(Clone, PartialEq, Eq, Hash)]
struct Counter {
    hits: i64,
    misses: i64,
}

fn make_counter(hits: i64, misses: i64) -> Counter {
    Counter { hits, misses }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut total: i64 = 1;
    total += 2;
    total += 3;
    total = 10 - total;
    total -= 2_i64 * 3_i64;
    let mut tally = make_counter(0, 4);
    tally.hits *= 3;
    tally.hits = tally.misses + 1;
    let mut scores: Vec<i64> = vec![1_i64, 2_i64, 3_i64];
    scores[0] += scores[2];
    println!("{}{}{}", total, tally.hits, scores[0])
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
