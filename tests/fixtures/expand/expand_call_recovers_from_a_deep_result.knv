(use code empty? expand-call list number-gt number-sub)

(def bury
  (fn (form count)
    (if (number-gt count 0)
      (recur (list (quote do) form)
             (number-sub count 1))
      form)))

(defmacro too-deep () (bury 1 1100))

(defmacro probes ()
  (if (empty? (expand-call (list (quote too-deep))))
    "recovered" "expanded"))

(defn main () (println (probes)))
