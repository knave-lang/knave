(defn snap! (x)
  (set! x (+ x 1))
  (local g (fn () x))
  (set! x (+ x 10))
  g)

(defn shown-adder! (x)
  (set! x (+ x 1))
  (local f (fn (y) (+ y x)))
  (println (f 0))
  (set! x (+ x 1))
  f)

(defn walk! (x ys)
  (set! x (+ x 1))
  (local it
    (map (iter ys) (fn (y) (+ (deref y) x))))
  (set! x (+ x 100))
  it)

(defn branch-adder! (x up)
  (set! x (+ x 1))
  (local f (fn (y) (+ y x)))
  (if up
    (set! x (+ x 5))
    (set! x (- x 5)))
  f)

(defn bump! (n) (set! n (+ n 7)))

(defn bumped-adder! (x)
  (set! x (+ x 1))
  (local f (fn (y) (+ y x)))
  (bump! x)
  f)

(defn called-adder! (x)
  (set! x (+ x 1))
  (local g (fn () x))
  (fn (y) (+ y (g))))

(defn looped-adder! (x)
  (set! x (+ x 1))
  (loop (i 0)
    (if (> i 2)
      (fn (y) (+ y x))
      (recur (+ i 1)))))

(defn seeded-adder! (x)
  (set! x (+ x 1))
  (loop (f (fn (y) (+ y x))) f))

(defn main ()
  (local a 1)
  (local ys (vec 10 20))
  (println ((snap! a)))
  (println ((shown-adder! a) 1))
  (for-each (walk! a ys)
            (fn (v) (println v)))
  (println ((branch-adder! a true) 0))
  (println ((bumped-adder! a) 0))
  (println ((called-adder! a) 0))
  (println ((looped-adder! a) 0))
  (println ((seeded-adder! a) 0)))
