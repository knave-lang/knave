(defn nap-of (count) (millis count))

(defn main ()
  (let (start (now)
        nap (nap-of 5))
    (sleep nap)
    (println (>= (elapsed start) nap))
    (prn (seconds 2)
         (millis 1500)
         (micros 3)
         (nanos 1000000001)
         (seconds 0))
    (println (= (seconds 1) (millis 1000)))
    (println (< (micros 999) (millis 1)))
    (prn (collect (map (iter (vec 1 2)) seconds)))
    (println (unwrap-ok (the (result int duration) (ok 3))))))
