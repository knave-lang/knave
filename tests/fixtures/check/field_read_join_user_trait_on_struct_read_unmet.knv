(deftrait shout
  (loud (fn ((ref self)) string)))

(defstruct toy
  :size int)

(defstruct ball
  :size int)

(impl shout toy
  (loud (self) (str "toy " (:size self))))

(defstruct cat
  :toy ball)

(defstruct dog
  :toy ball)

(defn yell (x) (loud (:toy x)))

(defn main ()
  (println (yell (->cat (->ball 1))))
  (println (yell (->dog (->ball 2)))))
