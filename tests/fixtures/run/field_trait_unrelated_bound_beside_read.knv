(defstruct user
  :name string)

(defstruct animal
  :name string)

(defn named-and-holds? (x ys y)
  (and (contains? ys y)
       (> (len (:name x)) 0)))

(defn main ()
  (println (named-and-holds? (->user (str "ana"))
                             (vec 1 2)
                             2))
  (println (named-and-holds? (->animal (str "rex"))
                             (vec 3)
                             4)))
