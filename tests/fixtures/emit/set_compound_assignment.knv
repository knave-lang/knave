(defstruct counter
  :hits i64
  :misses i64)

(defstruct cursor
  :i usize)

(defn miss! (tally)
  (set! (:misses tally)
        (+ (:misses tally) 1))
  1)

(defn main ()
  (local total 1)
  (set! total (+ total 2))
  (set! total (+ 3 total))
  (set! total (- 10 total))
  (set! total (- total (* 2 3)))
  (local tally (->counter 0 4))
  (set! (:hits tally) (* (:hits tally) 3))
  (set! (:hits tally)
        (+ (:misses tally) 1))
  (set! (:misses tally)
        (- (:misses tally) (miss! tally)))
  (set! (:misses tally)
        (* (miss! tally) (:misses tally)))
  (local scores (vec 1 2 3))
  (set! (at scores 0)
        (+ (at scores 0) (at scores 2)))
  (local order (vec 2 0))
  (set! (at scores (at order 0))
        (+ (at scores (at order 0)) 1))
  (local index 1)
  (local by-index (ref index))
  (set! (at scores (deref by-index))
        (+ (at scores (deref by-index)) 1))
  (set! (at scores (deref (ref index)))
        (+ (at scores (deref (ref index))) 1))
  (local position (->cursor 1))
  (set! (at scores (:i (ref position)))
        (+ (at scores (:i (ref position))) 1))
  (set! (at scores (+ index 1))
        (+ (at scores (+ index 1)) 1))
  (local grid (vec (vec 1 2) (vec 3 4)))
  (set! (at (at grid (deref (ref index))) 0)
        (* 2
           (at (at grid (deref (ref index))) 0)))
  (local step (fn () 2))
  (set! (at scores 1)
        (+ (at scores 1) (step)))
  (println total
           (:hits tally)
           (:misses tally)
           (at scores 0)))
