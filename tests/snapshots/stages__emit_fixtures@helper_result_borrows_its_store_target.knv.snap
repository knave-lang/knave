fn store_and_first<'a>(names: &'a mut Vec<&'a str>, name: &'a str) -> &'a &'a str {
    names.push(name);
    &names[0]
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut ns = vec!["x"];
    let t = "a".to_string();
    let r = store_and_first(&mut ns, t.as_str());
    println!("{}", r)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
