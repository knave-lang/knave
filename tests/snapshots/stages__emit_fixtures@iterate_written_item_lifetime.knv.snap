fn count_long<'a>(names: impl Iterator<Item = &'a str>) -> i64 {
    crate::rt::count(names.filter(|name: &&'a str| crate::rt::length((*name).len()) > 4))
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let models: Vec<&str> = vec!["Leaf", "Ariya", "Sakura"];
    println!("{}", count_long(models.iter().copied()))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn length(value: usize) -> i64 {
        match i64::try_from(value) {
            Ok(length) => length,
            Err(_) => too_long(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn too_long(value: usize) -> ! {
        panic!("length does not fit in int: {value}")
    }

    #[inline]
    #[track_caller]
    pub fn count(items: impl Iterator) -> i64 {
        let counted = items.count();
        match i64::try_from(counted) {
            Ok(count) => count,
            Err(_) => count_overflow(counted),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn count_overflow(counted: usize) -> ! {
        panic!("attempt to count with overflow: the count is {counted}")
    }
}
