fn main() {
    crate::rt::restore_default_sigpipe();
    let name = "ea".to_string();
    let mut words = vec!["a", "b"];
    words.push("c");
    let mut numbers: Vec<i64> = vec![1_i64, 2_i64];
    numbers.push(4);
    let text = "pear".to_string();
    println!("{}", "pear".contains("ea"));
    println!("{}", text.contains("ea"));
    println!("{}", "pear".contains(name.as_str()));
    println!("{}", text.contains("ea"));
    println!("{}", words.contains(&"a"));
    println!("{}", numbers.contains(&3))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
