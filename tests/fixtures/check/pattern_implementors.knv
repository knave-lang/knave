(rust-trait shown "std::fmt::Display"
  i64 str
  (where ((a shown)) (ref a)))

(def describe
  (rust "{0}.to_string()"
    (where ((a shown)) (fn ((ref a)) str))))

(type twice-borrowed
  (fn ((ref (ref i64))) str))

(defn twice-borrowed (number) (describe number))

(defstruct (pair a b)
  :first a
  :second b)

(def origin (->pair 1 (str "one")))

(def copied (clone origin))

(defn main () (println (:first copied)))
