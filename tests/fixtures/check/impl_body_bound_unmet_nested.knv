(trait first-match
  (first-match
    (fn ((ref self)) bool)))

(impl first-match (vec a)
  (first-match (items)
    (local item (at items 0))
    (local first (clone item))
    (do (local _first first) true)))

(defn checks ((items (ref (vec (vec io-error)))))
  (first-match items))

(defn main ()
  (local errors (vec))
  (println (checks (ref errors))))
