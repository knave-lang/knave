(defn greeter (name)
  (fn () (println (str "hi " name))))

(defn keeper (o)
  (fn () (println (unwrap o))))

(defn main ()
  (let (s (str "a")
        pair-part (greeter (loop (p (pair (as-str (str "zz")) (as-str s)))
                             (let-match ((pair _ b) p) b)))
        block-tail (greeter (loop (p (let (k (str "q"))
                                       (println k)
                                       (pair (ref (str "zz")) (as-str s))))
                              (let-match ((pair _ b) p) b)))
        if-tail (greeter (loop (p (if (> (len s) 0)
                                    (pair (ref (str "zz")) (as-str s))
                                    (pair (ref (str "yy")) (as-str s))))
                           (let-match ((pair _ b) p) b)))
        nested (greeter (loop (p (pair (pair (ref (str "zz")) (as-str s))
                                       1))
                          (let-match ((pair (pair _ b) _) p) b)))
        from-local (greeter (let (q (pair (as-str (str "zz")) (as-str s)))
                              (loop (p q)
                                (let-match ((pair _ b) p) b))))
        repeated (greeter (loop (p (pair (as-str (str "zz")) (as-str s))
                                 i 0)
                            (if (< i 2)
                              (recur (pair (as-str s) (as-str s))
                                     (+ i 1))
                              (let-match ((pair _ b) p) b))))
        shadowed (keeper (loop (o (some (as-str (str "zz"))))
                           (println (unwrap o))
                           (let (o (some (as-str s))) o))))
    (pair-part)
    (block-tail)
    (if-tail)
    (nested)
    (from-local)
    (repeated)
    (shadowed)))
