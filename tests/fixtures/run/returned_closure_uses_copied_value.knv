(defn counter (start)
  (local count start)
  (fn () (set! count (+ count 1)) count))

(defn snap! (x)
  (set! x (+ x 1))
  (local value x)
  (set! x (+ x 10))
  (local pad 0)
  (fn () value))

(defn shown-adder! (x)
  (set! x (+ x 1))
  (local value x)
  (println value)
  (set! x (+ x 1))
  (local pad 0)
  (fn (y) (+ y value)))

(defn branch-adder! (x up)
  (set! x (+ x 1))
  (local value x)
  (if up
    (set! x (+ x 5))
    (set! x (- x 5)))
  (local pad 0)
  (fn (y) (+ y value)))

(defn bump! (n) (set! n (+ n 7)))

(defn bumped-adder! (x)
  (set! x (+ x 1))
  (local value x)
  (bump! x)
  (local pad 0)
  (fn (y) (+ y value)))

(defn main ()
  (local laps 0)
  (local next (counter laps))
  (println (next))
  (println (next))
  (println laps)
  (local a 1)
  (local g (snap! a))
  (println (g) a)
  (local b 1)
  (local add (shown-adder! b))
  (println b (add 1))
  (local d 1)
  (local branched (branch-adder! d true))
  (println d (branched 0))
  (local e 1)
  (local bumped (bumped-adder! e))
  (println e (bumped 0)))
