(use prelude/macros header-shape)
(use code len nth number-lt)

(export alpha beta delta epsilon eta gamma theta zeta)

(defmacro defpair (first-name second-name texts ...)
  (template (do
              (unquote (documented-definition first-name texts 0 1))
              (unquote (documented-definition second-name texts 1 2)))))

(def documented-definition
  (fn (name texts position value)
    (if (number-lt position (len texts))
      (template (def (unquote name)
                  (unquote (nth texts position))
                  (unquote value)))
      (template (def (unquote name) (unquote value))))))

(header-shape (defpair first-name second-name))

(defpair alpha beta "Comes first." "Comes second.")

(defpair gamma delta "Comes as a pair." "Comes as a pair.")

(defpair epsilon zeta)

(defpair eta theta "Only the first name has this.")
