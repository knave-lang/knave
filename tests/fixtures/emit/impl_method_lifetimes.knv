(export holder picker)

(struct holder (name str))

(trait picker
  (label (fn ((ref self)) (ref str)))
  (pick (fn ((ref holder) (ref holder))
          (ref str))))

(impl picker holder
  (label (someone) (field someone name))

  (pick (someone _) (field someone name)))

(defn main ()
  (local h (new holder (name (str "hi"))))
  (println (label h)))
