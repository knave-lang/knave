(defstruct pet
  :tags (vec int))

(defstruct owner
  :pet pet)

(defstruct keeper
  :pet pet)

(type add! (fn ((mut (vec int))) unit))

(defn add! (v) (push! v 1))

(defn tag-pet! (x)
  (add! (:tags (:pet x)))
  0)

(defn main ()
  (local o (->owner (->pet (vec 1))))
  (tag-pet! o)
  (prn (:tags (:pet o)))
  (local k (->keeper (->pet (vec 2))))
  (tag-pet! k)
  (prn (:tags (:pet k))))
