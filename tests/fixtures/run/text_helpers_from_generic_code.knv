(defn has? (whole part) (contains? whole part))

(defn glued (parts) (join parts "+"))

(defn begins? (text prefix) (starts-with? text prefix))

(defn main ()
  (local names (vec "ana" "bo"))
  (local owned (vec (str "c") (str "d")))
  (local scores (vec 1 2 3))
  (local fruit "fig")
  (println (has? "fig" "i"))
  (println (has? (str "pear") "ea"))
  (println (has? (vec 1 2) 2))
  (println (has? (ref fruit) "g"))
  (println (has? (ref names) "bo"))
  (println (has? (the (ref (slice i64)) (ref scores))
                 4))
  (println (contains? (the (ref (slice i64)) (ref scores))
                      3))
  (println (glued (vec "a" "b")))
  (println (glued (ref owned)))
  (println (glued (the (ref (slice string)) (ref owned))))
  (println (join (the (ref (slice (ref str)))
                      (ref names))
                 ", "))
  (println (begins? "pear" "pe"))
  (println (begins? (str "pear") "ar"))
  (println (begins? (ref fruit) "fi")))
