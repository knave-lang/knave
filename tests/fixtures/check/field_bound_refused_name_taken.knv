(deftrait named
  (name (fn ((ref self)) string)))

(defstruct user
  :name str)

(defstruct animal
  :name str)

(impl named user
  (name (self) (str "user")))

(impl named animal
  (name (self) (str "animal")))

(type hello
  (where ((a (has :name (ref str))))
    (fn ((ref a)) string)))

(defn hello (x)
  (str "hello " (:name x)))

(defn main ()
  (println (hello (->user "ana")))
  (println (name (->animal "rex"))))
