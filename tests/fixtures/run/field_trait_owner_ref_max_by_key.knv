(defstruct book
  :title string
  :pages int)

(defstruct film
  :title string
  :pages int)

(defn f (xs)
  (prn (max-by-key (iter xs)
         (fn (x) (len (:title x))))))

(defn main ()
  (local bs
    (vec (->book (str "dune") 1)
         (->book (str "it") 2)))
  (local fs (vec (->film (str "jaws") 3)))
  (f bs)
  (f fs))
