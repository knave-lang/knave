(defn direct-adder (x)
  (local value x)
  (fn (y) (+ value y)))

(defn let-adder (x)
  (let (value x) (fn (y) (+ value y))))

(defn called-adder (x)
  ((fn (value) (fn (y) (+ value y))) x))

(defn bound-adder (x)
  (let (value x
        add (fn (y) (+ value y)))
    add))

(defn bound-picker (limit)
  (let (most limit
        pick (fn ((name (ref str)))
               (if (> (len name) most) "long" name)))
    pick))

(defn picked-adder (x flag)
  (let (value x)
    (if flag
      (fn (y) (+ value y))
      (fn (y) (- value y)))))

(defn main ()
  (println ((direct-adder 2) 3))
  (println ((let-adder 2) 3))
  (println ((called-adder 2) 3))
  (println ((bound-adder 2) 3))
  (println ((bound-picker 3) "ab"))
  (println ((picked-adder 2 true) 3)))
