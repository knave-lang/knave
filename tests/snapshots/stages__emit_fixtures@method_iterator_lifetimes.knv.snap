#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct Depot {
    size: i64,
}

fn make_depot(size: i64) -> Depot {
    Depot { size }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let lot = make_depot(1);
    let models: Vec<&str> = vec!["Leaf", "Ariya"];
    println!("{}", lot.tally(models.iter().copied()));
    println!("{}", Counter::total(models.iter().copied(), &lot))
}

trait Counter {
    fn tally<'a>(&self, _: impl Iterator<Item = &'a str>) -> i64;
    fn total<'a>(_: impl Iterator<Item = &'a str>, _: &Self) -> i64;
}

impl Counter for Depot {
    fn tally<'a>(&self, names: impl Iterator<Item = &'a str>) -> i64 {
        self.size + crate::rt::count(names)
    }
    fn total<'a>(names: impl Iterator<Item = &'a str>, lot: &Depot) -> i64 {
        lot.size + crate::rt::count(names)
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn count(items: impl Iterator) -> i64 {
        let counted = items.count();
        match i64::try_from(counted) {
            Ok(count) => count,
            Err(_) => count_overflow(counted),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn count_overflow(counted: usize) -> ! {
        panic!("attempt to count with overflow: the count is {counted}")
    }
}
