(defstruct page
  :file string)

(defstruct (holder a)
  :item a)

(def same?
  (rust "{&0} == {1}"
    (where ((a (partial-eq b)) b)
      (fn (a b) bool))))

(type matches-view?
  (fn ((ref page) (ref (ref str))) bool))

(defn matches-view? (p view)
  (= (:file p) view))

(defn holds-literal? (h)
  (= (:item h) "a"))

(defn any-holds-literal? (hs)
  (any? (iter hs)
    (fn (h) (= (:item h) "a"))))

(defn holds-file? (h p)
  (= (:item h) (as-str (:file p))))

(defn holds-zero? (h) (= (:item h) 0))

(defn first-name? (p names)
  (same? (:file p) (at names 0)))

(type first-ref-named?
  (fn ((ref (vec (ref string))) (ref page))
    bool))

(defn first-ref-named? (refs p)
  (same? (:file p) (at refs 0)))

(defn named? (p target)
  (same? (:file p) (ref target)))

(defn main ()
  (local page (->page (str "a")))
  (local view "a")
  (println (matches-view? page (ref view)))
  (println (holds-literal? (->holder "a")))
  (local holders (vec (->holder "b")))
  (push! holders (->holder "a"))
  (println (any-holds-literal? holders))
  (println (holds-file? (->holder "a") page))
  (println (holds-zero? (->holder 0)))
  (local names (vec (str "a")))
  (push! names (str "b"))
  (println (first-name? page names))
  (local file (str "a"))
  (local refs (vec (ref file)))
  (push! refs (ref file))
  (println (first-ref-named? (ref refs) page))
  (println (named? page (str "a"))))
