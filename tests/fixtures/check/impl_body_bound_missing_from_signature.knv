(trait first-match
  (first-match
    (fn ((ref self)) bool)))

(impl first-match (vec a)
  (first-match (items)
    (local item (at items 0))
    (local first (clone item))
    (do (local _first first) true)))

(type checks (where (a) (fn (a) bool)))

(defn checks (item)
  (first-match (ref (vec item))))

(defn main () (println (checks 1)))
