(defstruct limit
  :n usize)

(defn counter! (x items)
  (set! x (+ x 1))
  (local it (iter items))
  (fn () (count it)))

(defn adder! (x)
  (set! x (+ x 1))
  (local g (fn (y) (+ y 1)))
  (fn (y) (g y)))

(defn chained! (items)
  (push! items 1)
  (local it (iter items))
  (local twice
    (map it (fn (i) (* (deref i) 2))))
  (fn () (count twice)))

(defn shifted! (x items)
  (set! x (+ x 1))
  (local n (- x 1))
  (local it (take (iter items) n))
  (fn () (count it)))

(defn taken! (x items)
  (set! x (+ x 1))
  (local it (take (iter items) x))
  (fn () (count it)))

(defn limited! (lim items)
  (set! lim (->limit (+ (:n lim) 1)))
  (local it (take (iter items) (:n lim)))
  (fn () (count it)))

(defn firsts (v n) (take (iter v) n))

(defn passed! (x items)
  (set! x (+ x 1))
  (local it (firsts items x))
  (fn () (count it)))

(defn matched! (x items)
  (set! x (+ x 1))
  (local it
    (match x
      (1 (take (iter items) 1))
      (_ (take (iter items) 2))))
  (fn () (count it)))

(defn viewer! (name)
  (set! name (str "pear"))
  (local v (some "none"))
  (when (> (len name) 0)
    (set! v (some (as-str name))))
  (fn ()
    (match v ((some s) (len s)) (none 0))))

(defn referred! (x)
  (set! x (+ x 1))
  (local r (ref x))
  (local g (fn () (deref r)))
  (fn () (+ (g) 10)))

(defn field-referred! (lim)
  (set! lim (->limit (+ (:n lim) 1)))
  (local r (ref (:n lim)))
  (fn () (deref r)))

(defn bound-taken! (x items)
  (set! x (+ x 1))
  (match x
    (v (do (local it (take (iter items) v)) (fn () (count it))))))

(defn pushed! (name)
  (set! name (str "plum"))
  (local views (vec "none"))
  (push! views (as-str name))
  (fn () (len views)))

(defn sizer! (items)
  (push! items 1)
  (local n (len items))
  (fn () (+ n 1)))

(defn main ()
  (local a 1)
  (local items (vec 0 0))
  (local c (counter! a items))
  (println a)
  (set! a 5)
  (println (c))
  (println a)
  (local b 1)
  (local add (adder! b))
  (println b)
  (println (add 2))
  (println ((chained! items)))
  (local d 1)
  (local s (shifted! d items))
  (println d)
  (println (s))
  (local e 1)
  (local taken (taken! e items))
  (println e)
  (println (taken))
  (local lim (->limit 1))
  (local limited (limited! lim items))
  (println (:n lim))
  (println (limited))
  (local f 1)
  (local passed (passed! f items))
  (println f)
  (println (passed))
  (local g 0)
  (local matched (matched! g items))
  (println g)
  (println (matched))
  (local name (str "apple"))
  (println ((viewer! name)))
  (println name)
  (println ((referred! e)))
  (println ((field-referred! lim)))
  (local bt (bound-taken! e items))
  (println e)
  (println (bt))
  (println ((pushed! name)))
  (println name)
  (local size (sizer! items))
  (println (len items))
  (println (size)))
