(defstruct car
  :model str
  :range u16)

(defstruct garage
  :models (vec str))

(trait labeled
  (label (fn ((ref self)) str)))

(impl labeled car
  (label (self)
    (str (:model self) " " (:range self))))

(type shout-first
  (fn ((ref (vec str))) str))

(defn shout-first (names)
  (upper-case (at names 0)))

(type trimmed-length
  (fn ((ref (vec str))) usize))

(defn trimmed-length (names)
  (len (trim (at names 0))))

(type shout-corner
  (fn ((ref (vec (vec str)))) str))

(defn shout-corner (grid)
  (upper-case (at (at grid 0) 1)))

(defn first-model (g)
  (lower-case (at (:models g) 0)))

(defn first-label (cars)
  (label (at cars 0)))

(defn main ()
  (local names
    (vec (str " Leaf ") (str "Ariya")))
  (push! names (str "Sakura"))
  (local grid
    (vec (vec (str "Leaf") (str "Ariya"))))
  (push! grid (vec (str "Kicks")))
  (local cars
    (vec (->car (str "Leaf") 240)))
  (push! cars (->car (str "Ariya") 300))
  (println (shout-first names))
  (println (trimmed-length names))
  (println (shout-corner grid))
  (println (first-model (->garage :models (vec (str "Leaf")))))
  (println (first-label cars)))
