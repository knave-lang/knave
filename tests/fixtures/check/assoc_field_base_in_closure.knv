(defstruct badge
  :text str
  :size u16)

(defstruct garage
  :name str
  :badge badge)

(defn main ()
  (local g
    (->garage (str "Leaf Garage")
              (->badge (str "open") 12)))
  (for-each (range 0 2)
    (fn (i)
      (local b (assoc (:badge g) :size 14))
      (println i " " (:size b)))))
