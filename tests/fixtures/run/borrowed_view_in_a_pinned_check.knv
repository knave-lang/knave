(defstruct page
  :file str
  :html str
  :tags (vec str))

(defstruct site
  :pages (vec page))

(defn holds? (s target id)
  (local suffix (str " id=" id))
  (any? (iter (:pages s))
    (fn (p)
      (and (= (:file p) target)
           (= (:html p) suffix)))))

(defn tagged? (s target id)
  (local suffix (str " id=" id))
  (any? (iter (:pages s))
    (fn (p)
      (and (= target (at (:tags p) 0))
           (= suffix (:html p))))))

(defn main ()
  (local all
    (->site (vec (->page (str "a")
                         (str " id=x")
                         (vec (str "t"))))))
  (local target (str "a"))
  (println (holds? (ref all) target "x"))
  (println (tagged? (ref all) (str "t") "x")))
