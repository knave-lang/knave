(use prelude/macros document)
(use modules/prose)

(def module-docstring 1)

(document module-docstring "Not the module docstring.")

(def module 2)

(document module "Not the module docstring either.")

(def prose-docstring (docstring (module modules/prose)))

(def entry-header
  (doc-header (module doc_module_key_is_no_name)))

(def entry-body
  (doc-body (module doc_module_key_is_no_name)))
