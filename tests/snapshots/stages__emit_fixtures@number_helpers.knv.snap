fn step<N: crate::rt::Number>(x: N) -> N {
    x + N::from_literal(1)
}

fn is_balanced<N: crate::rt::Number>(x: N) -> bool {
    x == N::from_literal(0)
}

fn is_halfway<N: crate::rt::Integer>(x: N) -> bool {
    crate::rt::is_even(x - N::from_literal(1))
}

fn is_lopsided<N: crate::rt::Integer>(x: N) -> bool {
    !crate::rt::is_even(x + N::from_literal(1))
}

fn is_steady<N: crate::rt::Integer>(x: N) -> bool {
    crate::rt::is_even(x)
}

const LIMIT: i64 = 7;

const FLAG: bool = LIMIT % 2 == 0;

static UNSIGNED_FLAG: std::sync::LazyLock<bool> =
    std::sync::LazyLock::new(|| !u8::is_multiple_of(3_u8, 2));

fn main() {
    crate::rt::restore_default_sigpipe();
    let size: usize = 4;
    let whole: i64 = 3;
    let part = -2.5;
    let empty: i64 = 0;
    let numbers: Vec<i64> = vec![-1_i64, 0_i64, 3_i64, 4_i64];
    let sizes: Vec<usize> = vec![1_usize, 2_usize, 3_usize];
    println!(
        "{} {} {} {}",
        crate::rt::Shown(&(whole + 1)),
        crate::rt::Shown(&(whole - 1)),
        crate::rt::Shown(&(part + 1.0)),
        crate::rt::Shown(&(size - 1))
    );
    println!(
        "{} {} {} {}",
        crate::rt::Shown(&(empty == 0)),
        crate::rt::Shown(&(part == 0.0)),
        crate::rt::Shown(&(whole > 0)),
        crate::rt::Shown(&(part < 0.0))
    );
    println!(
        "{} {} {} {}",
        crate::rt::Shown(&(whole % 2 == 0)),
        crate::rt::Shown(&(whole % 2 != 0)),
        crate::rt::Shown(&((whole + 1) % 2 == 0)),
        crate::rt::Shown(&!usize::is_multiple_of(size, 2))
    );
    println!(
        "{} {} {} {} {} {}",
        crate::rt::Shown(&step(whole)),
        crate::rt::Shown(&step(part)),
        crate::rt::Shown(&is_balanced(part)),
        crate::rt::Shown(&is_halfway(size)),
        crate::rt::Shown(&is_lopsided(whole)),
        crate::rt::Shown(&is_steady(whole))
    );
    println!(
        "{} {}",
        crate::rt::Shown(&FLAG),
        crate::rt::Shown(&*UNSIGNED_FLAG)
    );
    println!(
        "{}",
        crate::rt::Shown(&numbers.iter().map(|x: &i64| *x + 1).collect::<Vec<_>>())
    );
    println!(
        "{}",
        crate::rt::Shown(&numbers.iter().map(|x: &i64| *x - 1).collect::<Vec<_>>())
    );
    println!(
        "{} {} {} {} {}",
        crate::rt::Shown(&crate::rt::count(
            numbers.iter().filter(|x: &&i64| **x == 0)
        )),
        crate::rt::Shown(&crate::rt::count(numbers.iter().filter(|x: &&i64| **x > 0))),
        crate::rt::Shown(&crate::rt::count(numbers.iter().filter(|x: &&i64| **x < 0))),
        crate::rt::Shown(&crate::rt::count(
            numbers.iter().filter(|x: &&i64| **x % 2 == 0)
        )),
        crate::rt::Shown(&crate::rt::count(
            numbers.iter().filter(|x: &&i64| **x % 2 != 0)
        ))
    );
    println!(
        "{} {}",
        crate::rt::Shown(&crate::rt::count(
            sizes
                .iter()
                .filter(|x: &&usize| usize::is_multiple_of(**x, 2))
        )),
        crate::rt::Shown(&crate::rt::count(
            sizes
                .iter()
                .filter(|x: &&usize| !usize::is_multiple_of(**x, 2))
        ))
    )
}

mod rt {
    use std::ops::{
        Add, AddAssign, Div, DivAssign, Mul, MulAssign, Rem, RemAssign, Sub, SubAssign,
    };

    pub trait Number:
        Copy
        + PartialOrd
        + Add<Output = Self>
        + Sub<Output = Self>
        + Mul<Output = Self>
        + Div<Output = Self>
        + Rem<Output = Self>
        + AddAssign
        + SubAssign
        + MulAssign
        + DivAssign
        + RemAssign
    {
        fn from_literal(value: i128) -> Self;
    }

    macro_rules! numbers {
        ($($number:ty),*) => {
            $(
                impl Number for $number {
                    fn from_literal(value: i128) -> Self {
                        value as Self
                    }
                }
            )*
        };
    }

    numbers!(
        i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64
    );

    pub trait Integer:
        Number + std::fmt::Display + TryFrom<i128> + TryFrom<u128> + TryInto<i128> + TryInto<u128>
    {
    }

    macro_rules! integers {
        ($($integer:ty),*) => {
            $(
                impl Integer for $integer {}
            )*
        };
    }

    integers!(
        i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize
    );

    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    use std::fmt::{Display, Formatter, Result, Write};

    pub trait Show {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result;
    }

    pub struct Shown<'v, T: Show + ?Sized>(pub &'v T);

    impl<T: Show + ?Sized> Display for Shown<'_, T> {
        fn fmt(&self, out: &mut Formatter<'_>) -> Result {
            self.0.write_form(out)
        }
    }

    pub struct Record<'r, 'f> {
        out: &'r mut Formatter<'f>,
        written: Result,
    }

    impl<'r, 'f> Record<'r, 'f> {
        pub fn open(out: &'r mut Formatter<'f>, head: &str) -> Self {
            let written = write!(out, "({head}");
            Record { out, written }
        }

        pub fn part<T: Show + ?Sized>(self, value: &T) -> Self {
            self.write(|out| {
                out.write_char(' ')?;
                value.write_form(out)
            })
        }

        pub fn text(self, written: &str) -> Self {
            self.write(|out| write!(out, " {written}"))
        }

        pub fn close(self) -> Result {
            self.written?;
            self.out.write_char(')')
        }

        fn write(mut self, part: impl FnOnce(&mut Formatter<'f>) -> Result) -> Self {
            self.written = self.written.and_then(|()| part(self.out));
            self
        }
    }

    struct Quoted<'t>(&'t str);

    impl Display for Quoted<'_> {
        fn fmt(&self, out: &mut Formatter<'_>) -> Result {
            out.write_char('"')?;
            for character in self.0.chars() {
                match character {
                    '"' => out.write_str("\\\"")?,
                    '\\' => out.write_str("\\\\")?,
                    '\n' => out.write_str("\\n")?,
                    '\r' => out.write_str("\\r")?,
                    '\t' => out.write_str("\\t")?,
                    '\0' => out.write_str("\\0")?,
                    control if control.is_control() => write!(out, "\\u{{{:x}}}", control as u32)?,
                    printable => out.write_char(printable)?,
                }
            }
            out.write_char('"')
        }
    }

    macro_rules! shown_as_display {
        ($($shown:ty),*) => {
            $(
                impl Show for $shown {
                    fn write_form(&self, out: &mut Formatter<'_>) -> Result {
                        write!(out, "{self}")
                    }
                }
            )*
        };
    }

    shown_as_display!(
        bool, i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize
    );

    macro_rules! shown_as_float {
        ($($shown:ty),*) => {
            $(
                impl Show for $shown {
                    fn write_form(&self, out: &mut Formatter<'_>) -> Result {
                        if self.is_nan() {
                            out.write_str("(/ 0.0 0.0)")
                        } else if self.is_infinite() && self.is_sign_positive() {
                            out.write_str("(/ 1.0 0.0)")
                        } else if self.is_infinite() {
                            out.write_str("(/ -1.0 0.0)")
                        } else {
                            write!(out, "{self:?}")
                        }
                    }
                }
            )*
        };
    }

    shown_as_float!(f32, f64);

    macro_rules! shown_as_message {
        ($($shown:ty => $head:literal),*) => {
            $(
                impl Show for $shown {
                    fn write_form(&self, out: &mut Formatter<'_>) -> Result {
                        Record::open(out, $head).part(self.to_string().as_str()).close()
                    }
                }
            )*
        };
    }

    shown_as_message!(
        std::io::Error => "io-error",
        std::str::ParseBoolError => "parse-bool-error",
        std::char::ParseCharError => "parse-char-error",
        std::num::ParseIntError => "parse-int-error",
        std::num::ParseFloatError => "parse-float-error"
    );

    impl Show for std::convert::Infallible {
        fn write_form(&self, _: &mut Formatter<'_>) -> Result {
            match *self {}
        }
    }

    impl Show for char {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            let mut text = [0; 4];
            Record::open(out, "char")
                .part(&*self.encode_utf8(&mut text))
                .close()
        }
    }

    impl Show for str {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            write!(out, "{}", Quoted(self))
        }
    }

    impl Show for String {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.as_str().write_form(out)
        }
    }

    impl Show for () {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            out.write_str("(do)")
        }
    }

    impl<T: Show + ?Sized> Show for &T {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            T::write_form(self, out)
        }
    }

    impl<T: Show + ?Sized> Show for Box<T> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            Record::open(out, "box").part(&**self).close()
        }
    }

    impl<T: Show> Show for [T] {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.iter()
                .fold(Record::open(out, "vec"), Record::part)
                .close()
        }
    }

    impl<T: Show> Show for Vec<T> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.as_slice().write_form(out)
        }
    }

    impl<T: Show> Show for Option<T> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            match self {
                Some(value) => Record::open(out, "some").part(value).close(),
                None => out.write_str("none"),
            }
        }
    }

    impl<T: Show, E: Show> Show for std::result::Result<T, E> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            match self {
                Ok(value) => Record::open(out, "ok").part(value).close(),
                Err(error) => Record::open(out, "err").part(error).close(),
            }
        }
    }

    impl<A: Show, B: Show> Show for (A, B) {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            Record::open(out, "pair")
                .part(&self.0)
                .part(&self.1)
                .close()
        }
    }

    impl<K: Show, V: Show> Show for std::collections::BTreeMap<K, V> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.iter()
                .fold(Record::open(out, "sorted-map"), |record, (key, value)| {
                    record.part(key).part(value)
                })
                .close()
        }
    }

    impl<K: Show, V: Show, S> Show for std::collections::HashMap<K, V, S> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            let mut entries: Vec<(String, &V)> = self
                .iter()
                .map(|(key, value)| (Shown(key).to_string(), value))
                .collect();
            entries.sort_by(|(left, _), (right, _)| left.cmp(right));
            entries
                .iter()
                .fold(Record::open(out, "hash-map"), |record, (key, value)| {
                    record.text(key).part(*value)
                })
                .close()
        }
    }

    pub fn is_even<N: Integer>(value: N) -> bool {
        value % N::from_literal(2) == N::from_literal(0)
    }

    #[inline]
    #[track_caller]
    pub fn count(items: impl Iterator) -> i64 {
        let counted = items.count();
        match i64::try_from(counted) {
            Ok(count) => count,
            Err(_) => count_overflow(counted),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn count_overflow(counted: usize) -> ! {
        panic!("attempt to count with overflow: the count is {counted}")
    }
}
