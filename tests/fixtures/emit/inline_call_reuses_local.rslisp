(defrule with-n
  ((value body) ((fn (n) body) value)))

(type tried-count
  (fn () (result i64 string)))

(defn tried-count ()
  (local n 0)
  ((fn (n)
     (if (< n
            (try (the (result i64 string) (ok 3))))
       (recur (+ n 1))
       (ok n)))
   n))

(defn count-up ()
  (local n 0)
  ((fn (n) (if (< n 3) (recur (+ n 1)) n))
   n))

(defn other-name (n)
  (local m n)
  ((fn (k) (+ k 1)) m))

(defn parameter-not-local (n)
  ((fn (n) (if (< n 3) (recur (+ n 1)) n))
   n))

(defn read-after-the-call ()
  (local n 0)
  ((fn (n) (if (< n 3) (recur (+ n 1)) n))
   n)
  n)

(defn read-by-another-argument ()
  (local n 1)
  ((fn (n total)
     (if (< n 3)
       (recur (+ n 1) total)
       (+ n total)))
   n n))

(defn read-in-the-body ()
  (local n 2)
  (with-n n (+ n n)))

(defn borrowed-before-the-call ()
  (local count 0)
  (local start (ref count))
  ((fn (count start)
     (if (< count 3)
       (recur (+ count 1) start)
       (+ count (deref start))))
   count start))

(defn borrowed-and-read-after-the-call ()
  (local count 0)
  (local start (ref count))
  ((fn (count)
     (if (< count 3)
       (recur (+ count 1))
       count))
   count)
  (deref start))

(defn captured-before-the-call ()
  (local count 0)
  (local read-count (fn () count))
  ((fn (count)
     (if (< count 3)
       (recur (+ count 1))
       count))
   count)
  (read-count))

(defn borrowed-argument ()
  (local readings (vec 1 2))
  ((fn ((readings (ref (vec i64))))
     (len readings))
   readings))

(defn changed-in-place ()
  (local readings (vec 1))
  ((fn (readings) (push! readings 2) readings)
   readings))

(defn borrowed-into-a-container ()
  (local refs (vec))
  (local count 0)
  (push! refs (ref count))
  ((fn (count)
     (if (< count 3)
       (recur (+ count 1))
       count))
   count)
  (len refs))

(defn borrowed-through-a-second-binder ()
  (local count 0)
  (local first-ref (ref count))
  (local second-ref first-ref)
  (loop (count count)
    (if (< count 3)
      (recur (+ count 1))
      count))
  (deref second-ref))

(type peek (fn ((ref i64)) i64))

(defn peek (value) (deref value))

(defn borrowed-by-an-argument ()
  (local count 0)
  (peek count)
  ((fn (count)
     (if (< count 3)
       (recur (+ count 1))
       count))
   count))

(defn copied-before-the-call (limit)
  (local top (* limit 2))
  (local step top)
  ((fn (top step)
     (if (> step 0)
       (recur top (- step 1))
       top))
   top step))

(defn main ()
  (println (unwrap-ok (tried-count)))
  (println (count-up))
  (println (other-name 4))
  (println (parameter-not-local 1))
  (println (read-after-the-call))
  (println (read-by-another-argument))
  (println (read-in-the-body))
  (println (borrowed-before-the-call))
  (println (borrowed-and-read-after-the-call))
  (println (captured-before-the-call))
  (println (borrowed-argument))
  (println (len (changed-in-place)))
  (println (borrowed-into-a-container))
  (println (borrowed-through-a-second-binder))
  (println (borrowed-by-an-argument))
  (println (copied-before-the-call 2)))
