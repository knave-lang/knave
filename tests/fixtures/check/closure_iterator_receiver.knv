(defn main ()
  (local years (vec 2019 2021 2024))
  (local found (fn (it) (some? (max it))))
  (println (found (iter years)))
  (local not-empty
    (fn (it) (not (none? (max it)))))
  (println (not-empty (iter years)))
  (local alias-found
    (fn (it)
      (local items it)
      (some? (max items))))
  (println (alias-found (iter years)))
  (local nested-alias-found
    (fn (it)
      (not (do
             (local items it)
             (none? (max items))))))
  (println (nested-alias-found (iter years))))
