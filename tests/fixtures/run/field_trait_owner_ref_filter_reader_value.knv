(defstruct book
  :title string
  :pages int)

(defstruct film
  :title string
  :pages int)

(defn long? (x) (> (len (:title x)) 3))

(defn f (xs)
  (count (filter (iter xs) long?)))

(defn main ()
  (local bs
    (vec (->book (str "dune") 1)
         (->book (str "it") 2)))
  (local fs (vec (->film (str "jaws") 3)))
  (println (f bs))
  (println (f fs)))
