fn main() {
    crate::rt::restore_default_sigpipe();
    let mut offsets = vec![-2_i32, 9_i32, 10_i32];
    let nothing: Option<i64> = None;
    let small = 5;
    offsets.push(11);
    println!("{}", offsets.len());
    println!("{}", nothing.is_none());
    println!("{}", small)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
