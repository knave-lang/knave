(defstruct cat
  :tags (vec int))

(defstruct dog
  :tags (vec int))

(type add! (fn ((mut (vec int))) unit))

(defn add! (v) (push! v 1))

(defn grow! (x)
  (add! (mut (:tags x)))
  (len (:tags x)))

(defn main ()
  (let (c (->cat (vec)))
    (println (grow! c)))
  (let (d (->dog (vec)))
    (println (grow! d))))
