fn set_next(years: &mut [i64], i: i64, year: i64) {
    years[crate::rt::index(i + 1)] = year
}

fn fill(years: &mut [i64], mut i: i64, n: i64) {
    loop {
        if i < n {
            years[crate::rt::index(i)] = 2020;
            i += 1;
            continue;
        } else {
            return;
        }
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut years: Vec<i64> = vec![2011_i64, 2015_i64, 2019_i64];
    set_next(&mut years, 0, 2016);
    println!("{}", years[1]);
    fill(&mut years, 1, 3);
    println!("{} {} {}", years[0], years[1], years[2])
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn index(value: i64) -> usize {
        match usize::try_from(value) {
            Ok(index) => index,
            Err(_) => negative(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn negative(value: i64) -> ! {
        panic!("attempt to use a negative value as an index or a size: {value}")
    }
}
