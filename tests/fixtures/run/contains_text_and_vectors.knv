(defn has? (items item) (contains? items item))

(defn has-three? ((scores (ref (vec i64))))
  (contains? scores 3))

(defn main ()
  (local names (vec "ana" "bo"))
  (local wanted "bo")
  (local title (str "pear tree"))
  (println (contains? "pear" "ea"))
  (println (contains? title "tree"))
  (println (contains? names wanted))
  (println wanted)
  (println (contains? (vec 1 2) 3))
  (println (has-three? (ref (vec 3 4))))
  (println (has? (vec 1 2) 2))
  (println (has? "fig" "i")))
