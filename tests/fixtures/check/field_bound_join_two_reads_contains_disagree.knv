(defstruct cat
  :tags (vec int))

(defstruct dog
  :tags (vec int))

(defstruct tag
  :tag string)

(defstruct label
  :tag string)

(defn tagged? (x y)
  (contains? (:tags x) (:tag y)))

(defn main ()
  (println (tagged? (->cat (vec 1))
                    (->tag (str "a"))))
  (println (tagged? (->dog (vec 2))
                    (->label (str "c")))))
