(type pick (where ('a 'b) (fn ((ref 'a str) (ref 'b str)) (ref 'a str))))
(defn pick (a b) (if (> (len b) 0) a a))
(type outer (where ('a 'b) (fn ((ref 'a str) (ref 'b str)) (ref 'a str))))
(defn outer (a b) (pick a b))
(defn main ()
  (local x (str "a"))
  (local y (str "b"))
  (local r (outer (as-str x) (as-str y)))
  (push! y (char "c"))
  (println r))
