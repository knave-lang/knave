(use doc_dir/geometry area)
(use doc_dir/empty)

(defn own-helper () (area 2 3))

(def own-names (doc-page (dir)))

(def geometry-names (doc-page (dir doc_dir/geometry)))

(def no-names (doc-page (dir doc_dir/empty)))

