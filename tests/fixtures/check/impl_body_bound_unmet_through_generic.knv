(trait first-match
  (first-match
    (fn ((ref self)) bool)))

(impl first-match (vec a)
  (first-match (items)
    (local item (at items 0))
    (local first (clone item))
    (do (local _first first) true)))

(defn checks (items) (first-match items))

(defn errors-match ((errors (ref (vec io-error))))
  (checks errors))

(defn main ()
  (local errors (vec))
  (println (errors-match (ref errors))))
