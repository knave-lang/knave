(defstruct user
  :name str)

(defstruct animal
  :name str)

(deftrait named
  (name (fn ((ref self)) string)))

(impl named user
  (name (self) (str "user")))

(impl named animal
  (name (self) (str "animal")))

(defn hello (x)
  (str (:name x) " is a " (name x)))

(defn main ()
  (println (hello (->user "ana")))
  (println (hello (->animal "rex"))))
