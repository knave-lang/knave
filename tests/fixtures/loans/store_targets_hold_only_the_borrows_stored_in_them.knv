(defn store-both! (first second name extra)
  (push! first name)
  (push! second name)
  (println extra))

(defn main ()
  (local xs (vec "x"))
  (local ys (vec "y"))
  (local t (str "a"))
  (local u (str "u"))
  (store-both! xs ys (as-str t) (as-str u))
  (push! u (char "v"))
  (push! xs "q")
  (push! ys "q")
  (println (len xs) (len ys) t))
