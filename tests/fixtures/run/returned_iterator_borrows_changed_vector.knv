(defn grow! (items)
  (push! items 1)
  (iter items))

(defn doubled! (items)
  (push! items 4)
  (map (iter items)
       (fn (i) (* (deref i) 2))))

(defn evens! (items)
  (push! items 4)
  (filter (iter items)
          (fn (i) (= (rem (deref i) 2) 0))))

(defn main ()
  (local items (vec 0))
  (println (count (grow! items)))
  (println (len items))
  (local more (vec 1))
  (for-each (doubled! more)
            (fn (v) (println v)))
  (println (len more))
  (local mixed (vec 1 2))
  (println (count (evens! mixed))))
