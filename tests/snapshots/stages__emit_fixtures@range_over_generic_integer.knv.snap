expression: reports.report(path)
input_file: tests/fixtures/emit/range_over_generic_integer.knv
---
fn count_to<N: crate::rt::Integer>(n: N) -> i64
where
    std::ops::Range<N>: Iterator<Item = N>,
{
    crate::rt::count(N::from_literal(0)..n)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", count_to(4_i64));
    println!("{}", count_to(3_u8))
}

mod rt {
    use std::ops::{
        Add, AddAssign, Div, DivAssign, Mul, MulAssign, Rem, RemAssign, Sub, SubAssign,
    };

    pub trait Number:
        Copy
        + PartialOrd
        + Add<Output = Self>
        + Sub<Output = Self>
        + Mul<Output = Self>
        + Div<Output = Self>
        + Rem<Output = Self>
        + AddAssign
        + SubAssign
        + MulAssign
        + DivAssign
        + RemAssign
    {
        fn from_literal(value: i128) -> Self;
    }

    macro_rules! numbers {
        ($($number:ty),*) => {
            $(
                impl Number for $number {
                    fn from_literal(value: i128) -> Self {
                        value as Self
                    }
                }
            )*
        };
    }

    numbers!(
        i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64
    );

    pub trait Integer:
        Number + std::fmt::Display + TryFrom<i128> + TryFrom<u128> + TryInto<i128> + TryInto<u128>
    {
    }

    macro_rules! integers {
        ($($integer:ty),*) => {
            $(
                impl Integer for $integer {}
            )*
        };
    }

    integers!(
        i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize
    );

    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn count(items: impl Iterator) -> i64 {
        let counted = items.count();
        match i64::try_from(counted) {
            Ok(count) => count,
            Err(_) => count_overflow(counted),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn count_overflow(counted: usize) -> ! {
        panic!("attempt to count with overflow: the count is {counted}")
    }
}
