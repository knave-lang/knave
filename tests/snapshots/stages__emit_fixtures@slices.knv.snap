fn total<A: crate::rt::Number>(numbers: &[A]) -> A {
    crate::prelude::iterator::sum(numbers.iter().copied())
}

fn first_number<A>(numbers: &[A]) -> &A {
    &numbers[0]
}

fn count_pairs<A>(numbers: &[A]) -> i64 {
    crate::rt::count(numbers.windows(2))
}

fn total_from<A: crate::rt::Number>(numbers: &[A], mut index: i64) -> A {
    loop {
        if index < crate::rt::length(numbers.len()) {
            index += 1;
            continue;
        } else {
            return total(numbers);
        }
    }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let numbers: Vec<i64> = vec![2_i64, 3_i64, 5_i64, 7_i64, 11_i64];
    println!("{}", total(&numbers));
    println!("{}", numbers[0]);
    println!("{}", first_number(&numbers));
    println!("{}", count_pairs(&numbers));
    println!("{}", total_from(&numbers, 0));
    let floats = vec![1.5_f64, 2.5_f64, 3.5_f64];
    println!("{}", first_number(&floats));
    println!("{}", count_pairs(&floats));
    println!("{}", total_from(&floats, 0))
}

mod prelude {

    pub(crate) mod iterator {
        pub fn sum<N: crate::rt::Number>(values: impl Iterator<Item = N>) -> N {
            values.fold(N::from_literal(0), |argument_0: N, argument_1: N| {
                argument_0 + argument_1
            })
        }
    }
}

mod rt {
    use std::ops::{
        Add, AddAssign, Div, DivAssign, Mul, MulAssign, Rem, RemAssign, Sub, SubAssign,
    };

    pub trait Number:
        Copy
        + PartialOrd
        + Add<Output = Self>
        + Sub<Output = Self>
        + Mul<Output = Self>
        + Div<Output = Self>
        + Rem<Output = Self>
        + AddAssign
        + SubAssign
        + MulAssign
        + DivAssign
        + RemAssign
    {
        fn from_literal(value: i128) -> Self;
    }

    macro_rules! numbers {
        ($($number:ty),*) => {
            $(
                impl Number for $number {
                    fn from_literal(value: i128) -> Self {
                        value as Self
                    }
                }
            )*
        };
    }

    numbers!(
        i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize, f32, f64
    );

    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn length(value: usize) -> i64 {
        match i64::try_from(value) {
            Ok(length) => length,
            Err(_) => too_long(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn too_long(value: usize) -> ! {
        panic!("length does not fit in int: {value}")
    }

    #[inline]
    #[track_caller]
    pub fn count(items: impl Iterator) -> i64 {
        let counted = items.count();
        match i64::try_from(counted) {
            Ok(count) => count,
            Err(_) => count_overflow(counted),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn count_overflow(counted: usize) -> ! {
        panic!("attempt to count with overflow: the count is {counted}")
    }
}
