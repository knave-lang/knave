(defstruct pet
  :age int)

(defstruct owner
  :pet pet)

(defstruct keeper
  :pet pet)

(defn age-pet! (x)
  (set! (:age (:pet x)) 9)
  0)

(defn main ()
  (local o (->owner (->pet 1)))
  (age-pet! o)
  (println (:age (:pet o)))
  (local k (->keeper (->pet 2)))
  (age-pet! k)
  (println (:age (:pet k))))
