#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct Label<'a> {
    text: &'a str,
}

#[derive(Clone, PartialEq, Eq, Hash)]
struct Page {
    title: String,
}

fn checked(text: &str) -> Result<&str, std::io::Error> {
    Ok(text)
}

fn first_letter(text: &str) -> &str {
    &text[0..1]
}

fn title_of(page: &Page) -> &str {
    page.title.as_str()
}

fn announced(text: &str) -> String {
    println!("{}", text);
    text.to_string()
}

fn prefix(size: usize, text: &str) -> &str {
    &text[0..size]
}

fn through_as_str(name: &str) {
    let owner = format!("{}-a", name);
    let letter = first_letter(owner.as_str());
    println!("{}", letter)
}

fn through_borrowed_argument(name: &str) {
    let owner = Page {
        title: format!("{}-b", name),
    };
    let letter = title_of(&owner);
    println!("{}", letter)
}

fn through_ref(name: &str) {
    let owner = Page {
        title: format!("{}-c", name),
    };
    let letter = title_of(&owner);
    println!("{}", letter)
}

fn through_field(name: &str) {
    let owner = format!("{}-d", name);
    let tag = Label {
        text: owner.as_str(),
    };
    println!("{}", tag.text)
}

fn through_variant(name: &str) {
    let owner = format!("{}-e", name);
    let found = Some(owner.as_str());
    println!("{}", found.unwrap())
}

fn through_nested_str(name: &str) {
    let owner = format!("{}-g", format!("{}-f", name).as_str());
    let letter = first_letter(owner.as_str());
    println!("{}", letter)
}

fn through_try(name: &str) -> Result<usize, std::io::Error> {
    let owner = format!("{}-j", name);
    let letter = checked(owner.as_str())?;
    Ok(letter.len())
}

fn label_text<'a>(tag: &'a Label<'a>) -> &'a str {
    tag.text
}

fn lent_inside_lifted(name: &str) {
    let owner = format!("{}-k", name);
    let owner_2 = Label {
        text: owner.as_str(),
    };
    let text = label_text(&owner_2);
    println!("{}", text)
}

fn written_borrow_of_struct(name: &str) {
    let owner = format!("{}-l", name);
    let tag = &Label {
        text: owner.as_str(),
    };
    println!("{}", tag.text)
}

fn in_written_order() {
    let owner;
    let shown = prefix(
        announced("first").len(),
        {
            owner = announced("second");
            &owner
        }
        .as_str(),
    );
    println!("{}", shown)
}

fn make_page(name: &str) -> Page {
    println!("{}", name);
    Page {
        title: format!("{}-m", name),
    }
}

fn label_of<'a>(page: &'a &'a Page) -> &'a str {
    page.title.as_str()
}

fn field_of_ref(name: &str) {
    let owner = &make_page(name);
    let letter = first_letter(owner.title.as_str());
    println!("{}", letter)
}

fn field_of_ref_local(name: &str) {
    let page = make_page(name);
    let letter = first_letter(page.title.as_str());
    println!("{}", letter)
}

fn ref_of_ref_argument(name: &str) {
    let owner = &make_page(name);
    let letter = label_of(&owner);
    println!("{}", letter)
}

fn explicit_ref_of_ref_argument(name: &str) {
    let page = make_page(name);
    let borrowed = &page;
    let letter = label_of(&borrowed);
    println!("{}", letter)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    through_as_str("ada");
    through_borrowed_argument("bea");
    through_ref("cy");
    through_field("dee");
    through_variant("eve");
    through_nested_str("fay");
    println!("{}", crate::rt::unwrap_ok(through_try("jo")));
    lent_inside_lifted("kim");
    written_borrow_of_struct("lu");
    in_written_order();
    field_of_ref("mo");
    field_of_ref_local("mo");
    ref_of_ref_argument("ned");
    explicit_ref_of_ref_argument("ned")
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    use std::fmt::{Display, Formatter, Result, Write};

    pub trait Show {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result;
    }

    pub struct Shown<'v, T: Show + ?Sized>(pub &'v T);

    impl<T: Show + ?Sized> Display for Shown<'_, T> {
        fn fmt(&self, out: &mut Formatter<'_>) -> Result {
            self.0.write_form(out)
        }
    }

    pub struct Record<'r, 'f> {
        out: &'r mut Formatter<'f>,
        written: Result,
    }

    impl<'r, 'f> Record<'r, 'f> {
        pub fn open(out: &'r mut Formatter<'f>, head: &str) -> Self {
            let written = write!(out, "({head}");
            Record { out, written }
        }

        pub fn part<T: Show + ?Sized>(self, value: &T) -> Self {
            self.write(|out| {
                out.write_char(' ')?;
                value.write_form(out)
            })
        }

        pub fn text(self, written: &str) -> Self {
            self.write(|out| write!(out, " {written}"))
        }

        pub fn close(self) -> Result {
            self.written?;
            self.out.write_char(')')
        }

        fn write(mut self, part: impl FnOnce(&mut Formatter<'f>) -> Result) -> Self {
            self.written = self.written.and_then(|()| part(self.out));
            self
        }
    }

    struct Quoted<'t>(&'t str);

    impl Display for Quoted<'_> {
        fn fmt(&self, out: &mut Formatter<'_>) -> Result {
            out.write_char('"')?;
            for character in self.0.chars() {
                match character {
                    '"' => out.write_str("\\\"")?,
                    '\\' => out.write_str("\\\\")?,
                    '\n' => out.write_str("\\n")?,
                    '\r' => out.write_str("\\r")?,
                    '\t' => out.write_str("\\t")?,
                    '\0' => out.write_str("\\0")?,
                    control if control.is_control() => write!(out, "\\u{{{:x}}}", control as u32)?,
                    printable => out.write_char(printable)?,
                }
            }
            out.write_char('"')
        }
    }

    macro_rules! shown_as_display {
        ($($shown:ty),*) => {
            $(
                impl Show for $shown {
                    fn write_form(&self, out: &mut Formatter<'_>) -> Result {
                        write!(out, "{self}")
                    }
                }
            )*
        };
    }

    shown_as_display!(
        bool, i8, i16, i32, i64, i128, isize, u8, u16, u32, u64, u128, usize
    );

    macro_rules! shown_as_float {
        ($($shown:ty),*) => {
            $(
                impl Show for $shown {
                    fn write_form(&self, out: &mut Formatter<'_>) -> Result {
                        if self.is_nan() {
                            out.write_str("(/ 0.0 0.0)")
                        } else if self.is_infinite() && self.is_sign_positive() {
                            out.write_str("(/ 1.0 0.0)")
                        } else if self.is_infinite() {
                            out.write_str("(/ -1.0 0.0)")
                        } else {
                            write!(out, "{self:?}")
                        }
                    }
                }
            )*
        };
    }

    shown_as_float!(f32, f64);

    macro_rules! shown_as_message {
        ($($shown:ty => $head:literal),*) => {
            $(
                impl Show for $shown {
                    fn write_form(&self, out: &mut Formatter<'_>) -> Result {
                        Record::open(out, $head).part(self.to_string().as_str()).close()
                    }
                }
            )*
        };
    }

    shown_as_message!(
        std::io::Error => "io-error",
        std::str::ParseBoolError => "parse-bool-error",
        std::char::ParseCharError => "parse-char-error",
        std::num::ParseIntError => "parse-int-error",
        std::num::ParseFloatError => "parse-float-error"
    );

    impl Show for std::convert::Infallible {
        fn write_form(&self, _: &mut Formatter<'_>) -> Result {
            match *self {}
        }
    }

    impl Show for char {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            let mut text = [0; 4];
            Record::open(out, "char")
                .part(&*self.encode_utf8(&mut text))
                .close()
        }
    }

    impl Show for str {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            write!(out, "{}", Quoted(self))
        }
    }

    impl Show for String {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.as_str().write_form(out)
        }
    }

    impl Show for () {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            out.write_str("(do)")
        }
    }

    impl<T: Show + ?Sized> Show for &T {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            T::write_form(self, out)
        }
    }

    impl<T: Show + ?Sized> Show for Box<T> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            Record::open(out, "box").part(&**self).close()
        }
    }

    impl<T: Show> Show for [T] {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.iter()
                .fold(Record::open(out, "vec"), Record::part)
                .close()
        }
    }

    impl<T: Show> Show for Vec<T> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.as_slice().write_form(out)
        }
    }

    impl<T: Show> Show for Option<T> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            match self {
                Some(value) => Record::open(out, "some").part(value).close(),
                None => out.write_str("none"),
            }
        }
    }

    impl<T: Show, E: Show> Show for std::result::Result<T, E> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            match self {
                Ok(value) => Record::open(out, "ok").part(value).close(),
                Err(error) => Record::open(out, "err").part(error).close(),
            }
        }
    }

    impl<A: Show, B: Show> Show for (A, B) {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            Record::open(out, "pair")
                .part(&self.0)
                .part(&self.1)
                .close()
        }
    }

    impl<K: Show, V: Show> Show for std::collections::BTreeMap<K, V> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            self.iter()
                .fold(Record::open(out, "sorted-map"), |record, (key, value)| {
                    record.part(key).part(value)
                })
                .close()
        }
    }

    impl<K: Show, V: Show, S> Show for std::collections::HashMap<K, V, S> {
        fn write_form(&self, out: &mut Formatter<'_>) -> Result {
            let mut entries: Vec<(String, &V)> = self
                .iter()
                .map(|(key, value)| (Shown(key).to_string(), value))
                .collect();
            entries.sort_by(|(left, _), (right, _)| left.cmp(right));
            entries
                .iter()
                .fold(Record::open(out, "hash-map"), |record, (key, value)| {
                    record.text(key).part(*value)
                })
                .close()
        }
    }

    #[track_caller]
    pub fn unwrap_ok<T, E: Show>(result: std::result::Result<T, E>) -> T {
        match result {
            Ok(value) => value,
            Err(error) => panic!("called unwrap-ok on (err {})", Shown(&error)),
        }
    }
}
