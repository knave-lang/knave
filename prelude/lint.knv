(use prelude/macros document module)

(use code bool-not empty? first list? nth number-sub rest
          same-binding? string string-strip-prefix
          symbol-name symbol? value-eq warn)

(use prelude/internal/code introducing-macro)

(module
  "Holds the lint rules that `knave lint` runs.")

(export check-rule rule-names)

(document (unused-binding table)
  "Reports a local binding that nothing reads: a `local`, or a parameter of a `fn` applied where it is written, as `loop` writes one.

  The rule reports each name that a `local` binds and that no form of the
  definition reads, at the name. A `let` binds its names with `local`, so
  its names count. A read inside a closure counts. A read that
  a macro discards, such as `(ignore unused)` with a macro `ignore` that
  expands to `(do)`, is no read, because the program that runs never reads
  the binding. A name that starts with `_` is left out, and so is a name that
  a macro's expansion binds.

  Only `knave lint` runs the rule, and it exits with status 1 when the rule
  reports a binding. `knave check`, `knave build` and `knave run` do not run
  it.

  ## Erroneous example

  ```
  ;; knave lint main.knv
  ;; main.knv
  (defn area (width height)
    (let (unused (+ width 1))
      (* width height)))

  (defn main () (println (area 2 3)))
  ```

  ## Fixes

  Remove the binding:

  ```
  ;; knave lint main.knv
  ;; main.knv
  (defn area (width height) (* width height))

  (defn main () (println (area 2 3)))
  ```

  Or start its name with `_`, to keep the binding:

  ```
  ;; knave lint main.knv
  ;; main.knv
  (defn area (width height)
    (let (_unused (+ width 1))
      (* width height)))

  (defn main () (println (area 2 3)))
  ```")

(document (unused-parameter table)
  "Reports a function parameter that nothing in its body reads.

  ## Erroneous example

  ```lisp
  (defn area (width height)
    (* width 2))
  ```

  ## Fixes

  Remove the parameter:

  ```lisp
  (defn area (width)
    (* width 2))
  ```

  Or start its name with `_` to keep it:

  ```lisp
  (defn area (width _height)
    (* width 2))
  ```

  A parameter whose name starts with `_` is allowed. A parameter that a macro's expansion introduced, or that the compiler named, as in a trait's default method, is never reported. A parameter of a `fn` applied where it is written is a local binding, which `unused-binding` reports. The rule covers every other function, closures and `impl` methods included, so its help offers only the `_` name, which never changes how the function is called.")

(document rule-names
  "Lists the name of each lint rule, as a symbol.

  `knave lint` runs each listed rule over each definition of the program's
  own modules, and `knave doc` finds a rule's page by a listed name.")

(def rule-names (quote (unused-binding unused-parameter)))

(document (check-rule rule table)
  "Runs the lint rule that `rule` names over `table`, which holds one
  definition read back as kernel forms.

  The rule reports what it finds with `warn`. A name that [rule-names] does
  not list runs nothing. `knave lint` calls it once for each rule and each
  definition.")

(def check-rule
  (fn (rule table)
    (if (value-eq rule (quote unused-binding))
      (unused-binding table)
      (if (value-eq rule (quote unused-parameter))
        (unused-parameter table)
        (do)))))

(def ignored-prefix "_")

(def unused-binding
  (fn (table)
    (warn-each table table unread-local? warn-unread-local)))

(def unused-parameter
  (fn (table)
    (warn-each table table unread-parameter?
               warn-unread-parameter)))

(def entry-form
  (fn (entry) (first entry)))

(def entry-parent
  (fn (entry) (nth entry 1)))

(def entry-role
  (fn (entry) (nth entry 3)))

(def entry-reads
  (fn (entry) (nth entry 4)))

(def parent-entry
  (fn (table entry)
    (nth table (entry-parent entry))))

(def warn-each
  (fn (table entries chosen? report)
    (if (empty? entries)
      (do)
      (do
        (if (reported? table (first entries) chosen?)
          (report (entry-form (first entries)))
          (do))
        (recur table (rest entries) chosen? report)))))

(def warn-unread-local
  (fn (binder)
    (warn (string "`" (symbol-name binder) "` is never read")
      binder
      (string "if the binding must stay, name it `"
              ignored-prefix
              (symbol-name binder)
              "`")
      (quote (:code unused-binding :label "bound here and never read")))))

(def warn-unread-parameter
  (fn (binder)
    (warn (string "parameter `"
                  (symbol-name binder)
                  "` is never read")
      binder
      (string "if the parameter must stay, name it `"
              ignored-prefix
              (symbol-name binder)
              "`")
      (quote (:code unused-parameter
                    :label "this parameter is never read")))))

(def reported?
  (fn (table entry chosen?)
    (if (chosen? table entry)
      (if (ignored? (entry-form entry))
        false
        (empty? (introducing-macro (entry-form entry))))
      false)))

(def unread-binder?
  (fn (entry)
    (if (value-eq (entry-role entry) (quote binds))
      (value-eq (entry-reads entry) 0)
      false)))

(def unread-local?
  (fn (table entry)
    (if (unread-binder? entry)
      (local-binder? table entry)
      false)))

(def local-binder?
  (fn (table entry)
    (if (kernel-form? (entry-form (parent-entry table entry))
                      (quote local))
      true
      (applied-parameter? table entry))))

(def unread-parameter?
  (fn (table entry)
    (if (unread-binder? entry)
      (if (parameter-list? table (parent-entry table entry))
        (bool-not (applied-fn? table (parent-entry table entry)))
        false)
      false)))

(def applied-parameter?
  (fn (table entry)
    (if (parameter-list? table (parent-entry table entry))
      (applied-fn? table (parent-entry table entry))
      false)))

(def applied-fn?
  (fn (table parameters)
    (value-eq (entry-parent (nth table (entry-parent parameters)))
              (number-sub (entry-parent parameters) 1))))

(def parameter-list?
  (fn (table entry)
    (if (kernel-headed? (entry-form entry))
      false
      (kernel-form? (entry-form (parent-entry table entry))
                    (quote fn)))))

(def ignored?
  (fn (binder)
    (bool-not (value-eq (string-strip-prefix (symbol-name binder)
                                             ignored-prefix)
                        (symbol-name binder)))))

(def kernel-headed?
  (fn (form)
    (if (list? form)
      (if (empty? form)
        false
        (kernel-symbol? (first form)))
      false)))

(def kernel-form?
  (fn (form name)
    (if (kernel-headed? form)
      (value-eq (first form) name)
      false)))

(def kernel-symbol?
  (fn (head)
    (if (symbol? head)
      (bool-not (same-binding? head head))
      false)))
