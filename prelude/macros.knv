(use prelude/internal/code set-macro-step-limit)

(use prelude/internal/docstrings arrow-line? closes-fence?
                                 fence-holds-code?
                                 opening-fence)

(use prelude/internal/macros add-docstring-note
                             docstring-before-body?
                             docstring-before-parameters
                             docstrings-key documented-body?
                             documented-terms-key head-of
                             map-list module-docstring-notes
                             note-docstring noted-term
                             term-docstrings-key
                             type-doc-key value-doc-key
                             value-docstring-note)

(use code add-module-note bool-not closest-name concat
          current-module declare-macro-definition
          definition-call definition-symbol
          distinct-leading-lines drop empty? expand-call
          fail field-keyword first keyword-field
          keyword-name keyword? len list list?
          module-definitions module-exports module-notes
          module-symbol nth number-add number-lt number-sub
          prepend program-modules rest same-binding?
          sorted-names string string-contains? string-drop
          string-length string-lines string-lowercase
          string-strip-prefix string-strip-suffix
          string-trim-start string? symbol symbol-name
          symbol? take type-definition-call
          type-definition-symbol value-eq warn)

(export defmacro defrule defrule-with-value doc-body
        doc-header doc-page docstring docstring-form
        docstrings-key document header-shape map-list module
        template with-macro-steps)

(def map-count
  (fn (count function)
    (map-from (list) 0 count function)))

(def map-from
  (fn (mapped index count function)
    (if (number-lt index count)
      (recur (concat mapped (list (function index)))
             (number-add index 1)
             count function)
      mapped)))

(def concat-all
  (fn (lists) (concat-onto (list) lists)))

(def concat-onto
  (fn (joined lists)
    (if (empty? lists)
      joined
      (recur (concat joined (first lists))
             (rest lists)))))

(def headed-by?
  (fn (form name)
    (if (list? form)
      (if (empty? form)
        false
        (if (symbol? (first form))
          (same-binding? (first form) name)
          false))
      false)))

(def ellipsis?
  (fn (form)
    (if (symbol? form)
      (same-binding? form (quote ...))
      false)))

(def literal-pattern?
  (fn (pattern)
    (if (headed-by? pattern (quote quote))
      (value-eq (len pattern) 2)
      false)))

(def followed-by-ellipsis?
  (fn (forms)
    (if (number-lt 1 (len forms))
      (ellipsis? (nth forms 1))
      false)))

(def entry-kind?
  (fn (entry kind)
    (if (list? entry)
      (value-eq (first entry) kind)
      false)))

(def lookup
  (fn (variable bindings)
    (if (empty? bindings)
      false
      (if (value-eq (nth (first bindings) 1) variable)
        (first bindings)
        (recur variable (rest bindings))))))

(def entry-value
  (fn (entry)
    (if (entry-kind? entry (quote many))
      (map-list (nth entry 2) entry-value)
      (nth entry 2))))

(def binding-value
  (fn (bindings variable)
    (entry-value (lookup variable bindings))))

(def pattern-variables
  (fn (pattern)
    (if (literal-pattern? pattern)
      (list)
      (if (pattern-variable? pattern)
        (list pattern)
        (if (list? pattern)
          (concat-all (map-list pattern pattern-variables))
          (list))))))

(def template-variables
  (fn (template)
    (if (symbol? template)
      (if (ellipsis? template)
        (list)
        (list template))
      (if (list? template)
        (concat-all (map-list template template-variables))
        (list)))))

(def join-matches
  (fn (left right)
    (if (list? left)
      (if (list? right) (concat left right) false)
      false)))

(def append-match
  (fn (matches match)
    (if (list? match)
      (concat matches (list match))
      false)))

(def match-pattern
  (fn (pattern input)
    (if (literal-pattern? pattern)
      (if (symbol? input)
        (if (same-binding? input (nth pattern 1))
          (list)
          false)
        false)
      (if (symbol? pattern)
        (list (list (quote one) pattern input))
        (if (list? pattern)
          (if (list? input) (match-list pattern input) false)
          (if (value-eq pattern input) (list) false))))))

(def match-list
  (fn (patterns inputs)
    (if (empty? patterns)
      (if (empty? inputs) (list) false)
      (if (followed-by-ellipsis? patterns)
        (match-ellipsis (first patterns) (drop patterns 2) inputs)
        (if (empty? inputs)
          false
          (join-matches (match-pattern (first patterns) (first inputs))
                        (match-list (rest patterns) (rest inputs))))))))

(def match-ellipsis
  (fn (repeated tail inputs)
    (local repeat-count
      (number-sub (len inputs) (len tail)))
    (if (number-lt repeat-count 0)
      false
      (join-matches (match-repeated repeated (take inputs repeat-count))
                    (match-list tail (drop inputs repeat-count))))))

(def match-repeated
  (fn (repeated inputs)
    (if (pattern-variable? repeated)
      (list (list (quote forms) repeated inputs))
      (group-matches repeated (match-each repeated inputs)))))

(def group-matches
  (fn (repeated matches)
    (if (list? matches)
      (map-list (pattern-variables repeated)
        (fn (variable)
          (list (quote many)
                variable
                (map-list matches
                  (fn (bindings) (lookup variable bindings))))))
      false)))

(def pattern-variable?
  (fn (pattern)
    (if (symbol? pattern)
      (bool-not (ellipsis? pattern))
      false)))

(def match-each
  (fn (pattern inputs)
    (match-each-onto (list) pattern inputs)))

(def match-each-onto
  (fn (matches pattern inputs)
    (if (empty? inputs)
      matches
      (if (list? matches)
        (recur (append-match matches
                             (match-pattern pattern (first inputs)))
               pattern
               (rest inputs))
        false))))

(def fill-template
  (fn (template bindings)
    (if (symbol? template)
      (fill-symbol template bindings)
      (if (list? template) (fill-list template bindings) template))))

(def fill-symbol
  (fn (template bindings)
    (local entry (lookup template bindings))
    (if (entry-kind? entry (quote one))
      (nth entry 2)
      (if (repeated-entry? entry)
        (fail "this pattern variable needs `...` after it"
          template "write `...` after it"
          (quote (:once-per definition)))
        template))))

(def fill-list
  (fn (templates bindings)
    (if (empty? templates)
      (list)
      (if (followed-by-ellipsis? templates)
        (concat (fill-repeated (first templates) bindings)
                (fill-list (drop templates 2) bindings))
        (prepend (fill-template (first templates) bindings)
                 (fill-list (rest templates) bindings))))))

(def fill-repeated
  (fn (template bindings)
    (local entries
      (repeated-entries (template-variables template) bindings))
    (if (empty? entries)
      (fail "nothing before this `...` repeats"
        template
        "remove this `...`, or repeat a variable that the pattern repeats"
        (quote (:once-per definition)))
      (if (lone-slice? template (first entries))
        (nth (first entries) 2)
        (do
          (local fill-iteration
            (fn (index)
              (fill-template template
                             (iteration-bindings entries bindings index))))
          (map-count (repetition-count template entries fill-iteration)
                     fill-iteration))))))

(def lone-slice?
  (fn (template leader)
    (if (symbol? template)
      (entry-kind? leader (quote forms))
      false)))

(def repetition-count
  (fn (repeated entries fill-iteration)
    (local count (entry-length (first entries)))
    (local mismatched (mismatched-entry count (rest entries)))
    (if (list? mismatched)
      (do
        (map-count (shortest-length count (rest entries))
                   fill-iteration)
        (unequal-repetitions repeated (first entries) mismatched))
      count)))

(def entry-length
  (fn (entry) (len (nth entry 2))))

(def mismatched-entry
  (fn (count entries)
    (if (empty? entries)
      false
      (if (value-eq (entry-length (first entries)) count)
        (recur count (rest entries))
        (first entries)))))

(def shortest-length
  (fn (shortest entries)
    (if (empty? entries)
      shortest
      (recur (shorter-length shortest (first entries))
             (rest entries)))))

(def shorter-length
  (fn (shortest entry)
    (if (number-lt (entry-length entry) shortest)
      (entry-length entry)
      shortest)))

(def unequal-repetitions
  (fn (repeated leader mismatched)
    (local names
      (string "`" (nth leader 1) "` and `" (nth mismatched 1) "`"))
    (local label
      (if (number-lt (entry-length leader) (entry-length mismatched))
        (unpaired-label repeated names mismatched leader)
        (unpaired-label repeated names leader mismatched)))
    (fail (string "`"
                  (nth leader 1)
                  "` has length "
                  (entry-length leader)
                  " but `"
                  (nth mismatched 1)
                  "` has length "
                  (entry-length mismatched))
      (first label)
      (string "give " names " the same length")
      (list (quote :code)
            (quote unequal-repetitions)
            (quote :label)
            (nth label 1)))))

(def unpaired-label
  (fn (repeated names longer shorter)
    (if (entry-kind? longer (quote forms))
      (list (nth (nth longer 2) (entry-length shorter))
            (string "this `"
                    (nth longer 1)
                    "` has no matching `"
                    (nth shorter 1)
                    "`"))
      (list repeated (string names " repeat together here")))))

(def repeated-entries
  (fn (candidates bindings)
    (if (empty? candidates)
      (list)
      (prepend-repeated (lookup (first candidates) bindings)
                        (repeated-entries (rest candidates) bindings)))))

(def prepend-repeated
  (fn (entry entries)
    (if (repeated-entry? entry) (prepend entry entries) entries)))

(def repeated-entry?
  (fn (entry)
    (if (entry-kind? entry (quote many))
      true
      (entry-kind? entry (quote forms)))))

(def iteration-bindings
  (fn (entries bindings index)
    (concat (map-list entries
              (fn (entry) (iteration-entry entry index)))
            bindings)))

(def iteration-entry
  (fn (entry index)
    (local item (nth (nth entry 2) index))
    (if (entry-kind? entry (quote forms))
      (list (quote one) (nth entry 1) item)
      item)))

(def expand-rules
  (fn (clauses form) (try-rules clauses clauses form)))

(def try-rules
  (fn (remaining clauses form)
    (if (empty? remaining)
      (fail (string "no rule of `" (first form) "` matches this form")
        form
        (string "write it as " (rule-shapes (first form) clauses)))
      (try-clause (first remaining) (rest remaining) clauses form))))

(def try-clause
  (fn (clause others clauses form)
    (local bindings
      (match-list (first clause) (rest form)))
    (if (list? bindings)
      (fill-template (nth clause 1) bindings)
      (try-rules others clauses form))))

(def rule-shapes
  (fn (name clauses)
    (join-shapes (map-list clauses
                   (fn (clause)
                     (prepend name (first clause)))))))

(def join-shapes
  (fn (shapes)
    (if (empty? (rest shapes))
      (string "`" (first shapes) "`")
      (string "`"
              (first shapes)
              "`, or "
              (join-shapes (rest shapes))))))

(def defrule
  (macro (form)
    (local name (nth form 1))
    (local body (drop form 2))
    (if (documented-body? body)
      (do
        (note-docstring (value-doc-key name) (first body))
        (rule-definition name (rest body)))
      (rule-definition name body))))

(def defrule-with-value
  (macro (form)
    (local name (nth form 1))
    (list (quote def)
          name
          (list (quote macro)
                (list (quote rule-form))
                (list (quote if)
                      (list (quote symbol?) (quote rule-form))
                      (list (quote quote) (nth form 2))
                      (rule-expansion (drop form 3)))))))

(def rule-definition
  (fn (name rules)
    (list (quote def)
          name
          (list (quote macro)
                (list (quote rule-form))
                (rule-expansion rules)))))

(def rule-expansion
  (fn (rules)
    (list (quote expand-rules)
          (list (quote quote) rules)
          (quote rule-form))))

(def build-template
  (fn (template)
    (if (headed-by? template (quote unquote))
      (nth template 1)
      (if (list? template)
        (prepend (quote concat)
                 (map-list template build-template-element))
        (list (quote quote) template)))))

(def build-template-element
  (fn (element)
    (if (headed-by? element (quote splice))
      (nth element 1)
      (list (quote list) (build-template element)))))

(def template
  (macro (form)
    (build-template (nth form 1))))

(def match-or-fail
  (fn (pattern form)
    (local bindings (match-list pattern (rest form)))
    (if (list? bindings)
      bindings
      (fail (string "this use of `"
                    (first form)
                    "` does not match its shape")
        form
        (string "write it as `" (prepend (first form) pattern) "`")))))

(def pattern-lets
  (fn (pattern)
    (map-list (pattern-variables pattern)
      (fn (variable)
        (list (quote local)
              variable
              (list (quote binding-value)
                    (quote macro-bindings)
                    (list (quote quote) variable)))))))

(def defmacro
  (macro (form)
    (local name (nth form 1))
    (declare-macro-definition name)
    (local pattern (nth form 2))
    (local body (drop form 3))
    (if (string? pattern)
      (docstring-before-parameters pattern)
      (if (docstring-before-body? body)
        (do
          (note-docstring (value-doc-key name) (first body))
          (macro-definition name pattern (rest body)))
        (macro-definition name pattern body)))))

(def macro-definition
  (fn (name pattern body)
    (list (quote def)
          name
          (concat (list (quote macro)
                        (list (quote macro-form))
                        (list (quote local)
                              (quote macro-bindings)
                              (list (quote match-or-fail)
                                    (list (quote quote) pattern)
                                    (quote macro-form))))
                  (pattern-lets pattern)
                  body))))

(defmacro header-shape (shape markers ...)
  "States the header of a form's calls: (header-shape (form name ...)).

  The page of a definition that a definer made shows as many leading
  forms of its call as the shape lists. A `:docstring` after the shape
  states that the form takes a docstring right after its header, a
  `:one-per-line` states that the formatter puts each later form of a
  call on its own line, an `:arms` states that each list after the
  header, other than a keyword's value, is an arm, which stays on one
  line up to the fill width, and a `:bindings` states that the header's
  last form is a binding list, which the formatter lays out one name and
  its value per line.

  ```
  (use prelude/macros header-shape)

  (header-shape (twice x))
  ```"
  (if (header-shape? shape)
    (stated-header-shape shape markers)
    (malformed-header-shape shape)))

(def header-shape?
  (fn (shape)
    (if (list? shape)
      (if (empty? shape)
        false
        (symbol? (first shape)))
      false)))

(def stated-header-shape
  (fn (shape markers)
    (require-bound-form (first shape))
    (check-shape-markers markers (list))
    (add-module-note (quote header-shapes) shape)
    (note-docstring-form (first shape) markers)
    (quote (do))))

(def note-docstring-form
  (fn (form-name markers)
    (if (documents-form? markers)
      (add-module-note (quote docstring-forms) form-name)
      (do))))

(def documents-form?
  (fn (markers)
    (if (holds-marker? markers "docstring")
      true
      (holds-marker? markers "docstring-only"))))

(def holds-marker?
  (fn (markers name)
    (if (empty? markers)
      false
      (if (marker-named? (first markers) name)
        true
        (holds-marker? (rest markers) name)))))

(def marker-named?
  (fn (form name)
    (if (keyword? form)
      (value-eq (keyword-name form) name)
      false)))

(def require-bound-form
  (fn (form-name) (definition-symbol form-name "shape")))

(def malformed-header-shape
  (fn (shape)
    (fail "a header shape is a list that starts with the form's name"
      shape "write it as `(header-shape (form name ...))`"
      (quote (:code malformed-header-shape
                    :label "not a list that starts with a name")))))

(def shape-marker-names
  (quote (docstring docstring-only one-per-line arms bindings)))

(def check-shape-markers
  (fn (markers seen)
    (if (empty? markers)
      (do)
      (check-shape-marker (first markers) (rest markers) seen))))

(def check-shape-marker
  (fn (marker more seen)
    (if (known-shape-marker? marker shape-marker-names)
      (if (holds-marker? seen (keyword-name marker))
        (extra-header-shape-marker marker)
        (check-shape-markers more (prepend marker seen)))
      (unknown-header-shape-marker marker
                                   (sole-marker? more seen)))))

(def sole-marker?
  (fn (more seen)
    (if (empty? more) (empty? seen) false)))

(def known-shape-marker?
  (fn (marker names)
    (if (empty? names)
      false
      (if (marker-named? marker (symbol-name (first names)))
        true
        (known-shape-marker? marker (rest names))))))

(def unknown-header-shape-marker
  (fn (marker sole)
    (if (keyword? marker)
      (suggested-or-extra-marker marker
                                 (closest-marker marker sole))
      (extra-header-shape-marker marker))))

(def closest-marker
  (fn (marker sole)
    (local closest
      (closest-name (keyword-field marker) shape-marker-names))
    (if (empty? closest)
      (if sole (list (first shape-marker-names)) closest)
      closest)))

(def suggested-or-extra-marker
  (fn (marker closest)
    (if (empty? closest)
      (extra-header-shape-marker marker)
      (misspelled-header-shape-marker marker (first closest)))))

(def misspelled-header-shape-marker
  (fn (marker name)
    (fail unexpected-header-shape-marker-title
      marker
      (marker-help name)
      (template (:code unexpected-header-shape-marker
                       :label (unquote (string "not `:" (symbol-name name) "`"))
                       :suggest (unquote (field-keyword name)))))))

(def marker-help
  (fn (name)
    (if (value-eq (symbol-name name) "docstring")
      "write `:docstring` to state that the form takes a docstring"
      (if (value-eq (symbol-name name) "docstring-only")
        "write `:docstring-only` to state that the form's last form is a docstring"
        (if (value-eq (symbol-name name) "arms")
          "write `:arms` to state that each list after the header is an arm"
          (if (value-eq (symbol-name name) "bindings")
            (string "write `:bindings` to state that the header's last form "
                    "is a binding list")
            (string "write `:one-per-line` to state that a call of the form "
                    "does not fill runs of atoms")))))))

(def extra-header-shape-marker
  (fn (marker)
    (fail unexpected-header-shape-marker-title
      marker
      (string "remove it: only `:docstring`, `:docstring-only`, "
              "`:one-per-line`, `:arms` and `:bindings` may follow a "
              "header shape, each once")
      (quote (:code unexpected-header-shape-marker
                    :label "not expected here")))))

(def unexpected-header-shape-marker-title
  "unexpected form after a header shape")

(defmacro document (header text)
  "Documents a term that no definer documents, such as a `def` of a macro.

  The header is the term's call form, as in `(document (twice x) text)`, or
  the bare name of a term that takes no arguments. The page shows the header
  as written, and the header's head names the term.

  ```
  (use prelude/macros document)

  (def twice (fn (x) (* 2 x)))

  (document (twice x)
    \"Doubles a number.\")

  (docstring twice)
  => \"Doubles a number.\"
  ```"
  (local note
    (value-docstring-note (documented-name header) header text))
  (noted-docstring (fn () (add-docstring-note note))
                   text))

(def documented-name
  (fn (header)
    (local name (header-name header))
    (if (symbol? name)
      name
      (fail "a `document` header must name a term"
        name
        "start the header with the term's name, as in `(document (name part ...) text)`"
        (quote (:label "not a name"))))))

(def noted-docstring
  (fn (add-note text)
    (if (string? text)
      (do (add-note) (quote (do)))
      (fail "a docstring is a string"
        text "write it as a string literal"
        (quote (:label "not a string"))))))

(def header-name
  (fn (header)
    (if (empty-list? header) header (head-of header))))

(def empty-list?
  (fn (form)
    (if (list? form) (empty? form) false)))

(header-shape (document header) :docstring-only)

(header-shape (defrule name) :docstring :arms)

(header-shape (defrule-with-value name value) :arms)

(header-shape (defmacro name pattern) :docstring)

(document (defrule name
            (pattern template)
            ...)
  "Defines a macro by rules that each rewrite a call of one shape.

  The first rule whose pattern matches the call's arguments gives the
  expansion, its template filled with the pattern's variables. In a pattern,
  `name ...` matches zero or more forms. A docstring may follow the name.

  ```
  (defrule swap ((a b) (pair b a)))

  (swap 1 2)
  => (pair 2 1)
  ```")

(document (defrule-with-value name value (pattern template) ...)
  "Defines a macro by rules, which is also a value where it is not called.

  A call takes the rules, as in [defrule]. A bare `name` expands to `value`,
  so `+` is a macro whose value is a function of two numbers.

  ```
  (use prelude/macros defrule-with-value)

  (defrule-with-value twice (fn (x) (* 2 x))
    ((x) (* 2 x)))

  (twice 4)
  => 8
  ```")

(document (defmacro name pattern
            body ...)
  "Defines a macro whose body computes the expansion of a call.

  The pattern binds the call's arguments as a [defrule] pattern does, and the
  body's last form is the expansion. A docstring may lead the body when
  another form follows it.

  ```
  (use code list)

  (defmacro twice (x)
    (list (quote *) 2 x))

  (twice 4)
  => 8
  ```")

(document (template form)
  "Builds a form from a quoted form with holes in it.

  `(unquote x)` puts the value of `x` in place, and `(splice xs)` puts each
  form of the list `xs` in place, as in
  `(template (def (unquote name) (splice body)))`.

  ```
  (defmacro twice (x)
    (template (* 2 (unquote x))))

  (twice 4)
  => 8
  ```")

(header-shape (fail message))

(header-shape (warn message))

(document (warn message form help description)
  "Reports a warning at `form` and lets expansion continue.

  It takes the arguments of `fail`, but `help` may be left out and
  `description` must name the warning's lint with `:code`, as in
  `(:code unmatched-link)`. The lint's name and code go with the warning.

  ```
  (use code nth warn)

  (def parked
    (macro (form)
      (warn \"the van is parked on a link\"
        (nth form 1)
        \"move the van\"
        (quote (:code unmatched-link)))
      (nth form 1)))

  (parked 3)
  => 3
  ```")

(defmacro module (text)
  (noted-docstring (fn ()
                     (add-module-note (quote module-docstrings) text))
                   text))

(header-shape (module) :docstring-only)

(document (module text)
  "Documents the module it is written in.

  `(doc (module path))` prints the page: the module header, the docstring,
  then the exported names in name order. Each entry is a name's header and
  summary, and names with one header and one docstring share an entry. The
  first `module` of a file wins.

  ```
  (module
    \"Shapes on a grid.\")
  ```")

(module
  "Defines macros, and documents and looks up terms.

  It holds the definers of macros, the docstring lookups, and the helpers
  that macro code builds forms with, such as [template] and [map-list].")

(defmacro doc-page (term)
  "Returns the page of a term as a string.

  The page is its header, a blank line, then its docstring. A term without a
  docstring has `No documentation.` in its place. The page is the text of
  (doc-header term) followed by the text of (doc-body term). A term may be
  (module path), whose page also lists the module's exports, or a listing:
  (dir), (dir module), (apropos text) or (find-doc text), whose page is the
  form and its results.

  (= (doc-page digit?)
     (str (doc-header digit?) (doc-body digit?)))
  => true"
  (documentation-part (quote page) term))

(defmacro doc-body (term)
  "Returns a term's page after its header: a blank line, then its docstring.

  A term without a docstring has `No documentation.` in its place.

  (subs (doc-body digit?) 2 9)
  => \"Returns\""
  (documentation-part (quote doc-body) term))

(defmacro docstring (term)
  "Returns the docstring of a term as a string.

  (subs (docstring digit?) 0 7)
  => \"Returns\""
  (documentation-part (quote docstring) term))

(def docstring-form
  (fn (term)
    (local docstrings
      (note-docstrings (if (module-lookup? term)
                         (module-note (nth term 1))
                         (term-note term))))
    (if (empty? docstrings) docstrings (take docstrings 1))))

(document (docstring-form term)
  "Returns a list that holds a term's docstring as written, with its location
  in the source, or an empty list for a term without one.

  The term is a name or `(module path)`, as for `docstring`. Macro code calls
  it to point a diagnostic into a docstring.

  ```
  (use code first string?)
  (use prelude/macros defmacro docstring-form)

  (defmacro documented? (term)
    (string? (first (docstring-form term))))

  (documented? digit?)
  => true
  ```")

(defmacro doc-header (term)
  "Returns the first line of a term's definition as written.

  For example, (defn area (width height)).

  (doc-header digit?)
  => \"(digit? character)\""
  (documentation-part (quote doc-header) term))

(def documentation-part
  (fn (part term)
    (if (symbol? term)
      (term-part part term)
      (if (module-lookup? term)
        (module-part part (nth term 1))
        (if (listing-lookup? term)
          (listing-part part term)
          (malformed-term term))))))

(def module-lookup?
  (fn (term)
    (if (list? term)
      (if (value-eq (len term) 2)
        (if (value-eq (first term) (quote module))
          (symbol? (nth term 1))
          false)
        false)
      false)))

(def listing-lookup?
  (fn (term)
    (if (list? term)
      (if (empty? term)
        false
        (if (dir-listing? term)
          true
          (if (value-eq (first term) (quote apropos))
            true
            (value-eq (first term) (quote find-doc)))))
      false)))

(def dir-listing?
  (fn (term)
    (value-eq (first term) (quote dir))))

(def listing-part
  (fn (part term)
    (if (listing-arguments? term)
      (listing-page part term)
      (malformed-listing term))))

(def listing-arguments?
  (fn (term)
    (local written (rest term))
    (if (dir-listing? term)
      (if (empty? written)
        true
        (if (value-eq (len written) 1)
          (symbol? (first written))
          false))
      (if (value-eq (len written) 1)
        (if (symbol? (first written))
          true
          (string? (first written)))
        false))))

(def malformed-listing
  (fn (term)
    (local head (first term))
    (if (dir-listing? term)
      (fail "`dir` takes one module name, or nothing"
        term
        "write `(dir)`, or a module as in `(dir geometry)`"
        (quote (:label "not one module name")))
      (fail (string "`" head
                    "` takes one symbol or string to search for")
        term
        (string "write `(" head " sort)`, or `(" head
                " \"sorted map\")` " "for text with spaces")
        (quote (:label "not one search text"))))))

(def listing-page
  (fn (part term)
    (if (value-eq part (quote doc-header))
      (string term)
      (if (value-eq part (quote docstring))
        (undocumented term "a listing has no docstring"
                      "read its results with `doc-page`")
        (if (value-eq part (quote doc-body))
          (string "\n\n" (listing-text term))
          (string term "\n\n" (listing-text term)))))))

(def listing-text
  (fn (term)
    (if (dir-listing? term)
      (dir-text term)
      (if (value-eq (first term) (quote apropos))
        (apropos-text (nth term 1))
        (find-doc-text (nth term 1))))))

(def dir-text
  (fn (term)
    (local names
      (if (empty? (rest term))
        (module-definitions (current-module))
        (module-exports (nth term 1))))
    (if (empty? names) "No names." (join-with " " names))))

(def apropos-text
  (fn (text)
    (local wanted (string-lowercase (string text)))
    (local names
      (sorted-names (items-where (fn (name) (name-holds? wanted name))
                                 (searched-names))))
    (if (empty? names)
      (string "No matches. Try "
              (list (quote find-doc) text)
              " to search docstrings.")
      (join-with " " names))))

(def find-doc-text
  (fn (text)
    (local wanted (string-lowercase (string text)))
    (local named
      (items-where (fn (name) (name-holds? wanted name))
                   (searched-names)))
    (local documented
      (concat (documented-program-names wanted)
              (items-where (fn (name)
                             (if (name-holds? wanted name)
                               false
                               (docstring-holds? wanted name)))
                           (module-exports (quote prelude)))))
    (local entries
      (without-repeated-headers
        (distinct-entries (map-list (concat named documented) listing-entry))))
    (if (empty? entries) "No matches." (join-lines entries))))

(def documented-program-names
  (fn (wanted)
    (local noted-in
      (fn (names paths)
        (if (empty? paths)
          names
          (recur (concat names
                         (sorted-names
                           (map-list (items-where
                                       (fn (note)
                                         (only-note-holds? wanted note))
                                       (module-docstring-notes (first paths)))
                                     noted-term)))
                 (rest paths)))))
    (noted-in (list) (program-modules))))

(def only-note-holds?
  (fn (wanted note)
    (if (name-holds? wanted (noted-term note))
      false
      (note-holds? wanted note))))

(def searched-names
  (fn ()
    (local definitions-of
      (fn (names paths)
        (if (empty? paths)
          names
          (recur (concat names (module-definitions (first paths)))
                 (rest paths)))))
    (concat (definitions-of (list) (program-modules))
            (module-exports (quote prelude)))))

(def items-where
  (fn (matches? names)
    (local kept-of
      (fn (kept remaining)
        (if (empty? remaining)
          kept
          (recur (if (matches? (first remaining))
                   (concat kept (list (first remaining)))
                   kept)
                 (rest remaining)))))
    (kept-of (list) names)))

(def name-holds?
  (fn (wanted name)
    (string-contains? (string-lowercase (symbol-name name))
                      wanted)))

(def docstring-holds?
  (fn (wanted name)
    (local values
      (docstring-notes (definition-symbol name "doc")
                       (value-doc-key name)))
    (local notes
      (if (empty? values)
        (docstring-notes (type-definition-symbol name "doc")
                         (type-doc-key name))
        values))
    (if (empty? notes)
      false
      (note-holds? wanted (first notes)))))

(def note-holds?
  (fn (wanted note)
    (string-contains? (string-lowercase (nth note (number-sub (len note) 1)))
                      wanted)))

(def module-part
  (fn (part path)
    (local note (module-note path))
    (if (missing-docstring? part note)
      (undocumented path "no docstring for this module"
                    "write `(module \"...\")` in the module's file")
      (string (doc-part part note)
              (if (value-eq part (quote doc-header))
                ""
                (if (value-eq part (quote docstring))
                  ""
                  (export-listing path)))))))

(def module-note
  (fn (path)
    (prepend (list (quote module) path)
             (written-texts (module-notes (module-symbol path)
                                          (quote module-docstrings))))))

(def written-texts
  (fn (texts)
    (if (empty? texts)
      texts
      (if (value-eq (clean-docstring (first texts)) "")
        (list)
        (take texts 1)))))

(def export-listing
  (fn (path)
    (local entries
      (distinct-entries (map-list (module-exports path) listing-entry)))
    (if (empty? entries)
      ""
      (string "\n\n" (join-lines entries)))))

(def listing-entry
  (fn (term)
    (local note (term-note term))
    (local docstrings (written-texts (note-docstrings note)))
    (if (empty? docstrings)
      (string (note-header note))
      (string (note-header note)
              "\n    "
              (first (string-lines (clean-docstring (first docstrings))))))))

(def distinct-entries
  (fn (entries)
    (reversed (distinct-leading-lines (reversed entries)))))

(def without-repeated-headers
  (fn (entries) (distinct-leading-lines entries)))

(def reversed
  (fn (items)
    (local last-index (number-sub (len items) 1))
    (map-count (len items)
      (fn (index)
        (nth items (number-sub last-index index))))))

(def malformed-term
  (fn (term)
    (fail "a documentation lookup takes a name, a module or a listing"
      term
      (string "write a name, a module as in `(module geometry)`, or a "
              "listing as in `(dir geometry)`")
      (quote (:label "not a name, a module or a listing")))))

(def term-part
  (fn (part term)
    (local note (term-note term))
    (if (missing-docstring? part note)
      (undocumented term "no docstring for this name"
                    (string "write a docstring where it is defined, as the "
                            "first form after the parameter list or the "
                            "header"))
      (doc-part part note))))

(def missing-docstring?
  (fn (part note)
    (if (value-eq part (quote docstring))
      (empty? (note-docstrings note))
      false)))

(def term-note
  (fn (term)
    (local documented-values (value-notes term))
    (local notes
      (if (empty? documented-values)
        (type-notes term)
        documented-values))
    (if (empty? notes)
      (list (written-header term))
      (first notes))))

(def value-notes
  (fn (term)
    (map-list (docstring-notes (definition-symbol term "doc")
                               (value-doc-key term))
              (fn (note)
                (value-page term (drop note 2))))))

(def value-page
  (fn (term page)
    (if (empty? (rest page))
      (prepend (written-header term) page)
      page)))

(def type-notes
  (fn (term)
    (local context (type-definition-symbol term "doc"))
    (map-list (docstring-notes context (type-doc-key term))
      (fn (note)
        (prepend (calls-header term context (type-definition-call term))
                 (drop note 2))))))

(def docstring-notes
  (fn (context key)
    (local noted
      (notes-with-key key
                      (module-notes context
                                    (term-docstrings-key (noted-term key)))))
    (if (empty? noted)
      (notes-with-key key (module-notes context docstrings-key))
      noted)))

(def notes-with-key
  (fn (key notes)
    (if (empty? notes)
      notes
      (if (same-doc-key? key (first notes))
        (take notes 1)
        (recur key (rest notes))))))

(def same-doc-key?
  (fn (key note)
    (if (value-eq (first key) (first note))
      (same-binding? (noted-term key) (noted-term note))
      false)))

(def written-header
  (fn (term)
    (calls-header term
                  (definition-symbol term "doc")
                  (definition-call term))))

(def calls-header
  (fn (term context written-calls)
    (local calls (scoped-form context written-calls))
    (if (empty? calls)
      term
      (call-header term
                   (first calls)
                   (fn () (expand-call (first calls)))
                   header-expansion-limit))))

(def header-expansion-limit 32)

(def scoped-form
  (fn (context form)
    (if (symbol? form)
      (symbol context form)
      (if (list? form)
        (map-list form
          (fn (item) (scoped-form context item)))
        form))))

(def call-header
  (fn (term call expand expansions-left)
    (local shapes (header-shapes (first call)))
    (if (empty? shapes)
      (expansion-header term expand expansions-left)
      (shaped-header (first shapes) call))))

(def shaped-header
  (fn (shape call)
    (if (number-lt (len call) (len shape))
      call
      (take call (len shape)))))

(def expansion-header
  (fn (term expand expansions-left)
    (if (number-lt 0 expansions-left)
      (expanded-header term
                       (expand)
                       (number-sub expansions-left 1))
      term)))

(def expanded-header
  (fn (term expansions expansions-left)
    (if (empty? expansions)
      term
      (macro-call-header term
                         (first expansions)
                         (expand-call (first expansions))
                         expansions-left))))

(def macro-call-header
  (fn (term call expansions expansions-left)
    (if (empty? expansions)
      term
      (call-header term call (fn () expansions) expansions-left))))

(def header-shapes
  (fn (definer)
    (shapes-of definer
               (module-notes (definition-symbol definer "doc")
                             (quote header-shapes)))))

(def shapes-of
  (fn (definer shapes)
    (if (empty? shapes)
      shapes
      (if (same-binding? definer (first (first shapes)))
        (take shapes 1)
        (recur definer (rest shapes))))))

(def note-header
  (fn (note) (first note)))

(def note-docstrings
  (fn (note) (rest note)))

(def undocumented
  (fn (term label help)
    (fail (string "`" term "` has no docstring")
      term help
      (list (quote :code)
            (quote undocumented-term)
            (quote :label)
            label))))

(def doc-part
  (fn (part note)
    (if (value-eq part (quote doc-header))
      (string (note-header note))
      (if (value-eq part (quote docstring))
        (clean-docstring (first (note-docstrings note)))
        (if (value-eq part (quote doc-body))
          (page-body-text note)
          (string (note-header note) (page-body-text note)))))))

(def page-body-text
  (fn (note)
    (local docstrings (note-docstrings note))
    (string "\n\n"
            (if (empty? docstrings)
              "No documentation."
              (clean-docstring (first docstrings))))))

(def clean-docstring
  (fn (text)
    (local lines (string-lines text))
    (local margin (shared-indentation (rest lines)))
    (local continuation
      (unindented-regions margin
                          (docstring-regions (rest lines)
                                             (list)
                                             (list)
                                             (list))
                          (list)))
    (local first-line (string-trim-start (first lines)))
    (without-trailing-newlines
      (join-lines (without-leading-blanks (prepend first-line continuation))))))

(def shared-indentation
  (fn (lines)
    (smallest (map-list (written-lines lines) indentation))))

(def indentation
  (fn (line)
    (number-sub (string-length line)
                (string-length (string-trim-start line)))))

(def blank?
  (fn (line)
    (value-eq (string-trim-start line) "")))

(def written-lines
  (fn (lines)
    (if (empty? lines)
      lines
      (if (blank? (first lines))
        (written-lines (rest lines))
        (prepend (first lines)
                 (written-lines (rest lines)))))))

(def smallest
  (fn (numbers)
    (if (empty? numbers)
      0
      (smallest-from (first numbers) (rest numbers)))))

(def smallest-from
  (fn (least numbers)
    (if (empty? numbers)
      least
      (recur (if (number-lt (first numbers) least)
               (first numbers)
               least)
             (rest numbers)))))

(def unindent
  (fn (margin line)
    (if (blank? line) "" (string-drop line margin))))

(def docstring-regions
  (fn (lines fence current found)
    (if (empty? lines)
      (concat found (open-regions fence current))
      (if (empty? fence)
        (if (bool-not (empty? (opening-fence (first lines))))
          (recur (rest lines)
                 (list (opening-fence (first lines))
                       (fence-kind (opening-fence (first lines))
                                   (first lines)))
                 (list)
                 (concat (concat found (paragraph-regions current))
                         (list (prose-region (first lines)))))
          (if (blank? (first lines))
            (recur (rest lines)
                   fence
                   (list)
                   (concat (concat found (paragraph-regions current))
                           (list (prose-region (first lines)))))
            (recur (rest lines)
                   fence
                   (concat current (list (first lines)))
                   found)))
        (if (closes-fence? (first fence) (first lines))
          (recur (rest lines)
                 (list)
                 (list)
                 (concat (concat found
                                 (list (list (nth fence 1) current)))
                         (list (prose-region (first lines)))))
          (recur (rest lines)
                 fence
                 (concat current (list (first lines)))
                 found))))))

(def open-regions
  (fn (fence current)
    (if (empty? fence)
      (paragraph-regions current)
      (list (list (quote prose) current)))))

(def paragraph-regions
  (fn (lines)
    (if (empty? lines)
      (list)
      (list (list (paragraph-kind lines) lines)))))

(def paragraph-kind
  (fn (lines)
    (if (holds-arrow-line? lines)
      (quote code)
      (quote prose))))

(def fence-kind
  (fn (fence line)
    (if (fence-holds-code? fence line)
      (quote code)
      (quote prose))))

(def holds-arrow-line?
  (fn (lines)
    (if (empty? lines)
      false
      (if (arrow-line? (first lines))
        true
        (recur (rest lines))))))

(def prose-region
  (fn (line)
    (list (quote prose) (list line))))

(def unindented-regions
  (fn (margin regions done)
    (if (empty? regions)
      done
      (recur margin
             (rest regions)
             (concat done (unindented-region margin (first regions)))))))

(def unindented-region
  (fn (margin region)
    (if (value-eq (first region) (quote code))
      (unindented-lines margin (nth region 1) false (list))
      (map-list (nth region 1)
        (fn (line) (unindent margin line))))))

(def unindented-lines
  (fn (margin lines in-string done)
    (if (empty? lines)
      done
      (recur margin
             (rest lines)
             (string-open-after? in-string (first lines))
             (concat done
                     (list (if in-string
                             (first lines)
                             (unindent margin (first lines)))))))))

(def string-open-after?
  (fn (in-string line)
    (if (string-contains? line string-quote)
      (string-open-after-text? in-string line)
      in-string)))

(def string-open-after-text?
  (fn (in-string text)
    (if (value-eq text "")
      in-string
      (if (starts-with-escape? text)
        (recur in-string (string-drop text 2))
        (recur (if (value-eq (string-strip-prefix text string-quote) text)
                 in-string
                 (bool-not in-string))
               (string-drop text 1))))))

(def starts-with-escape?
  (fn (text)
    (bool-not (value-eq (string-strip-prefix text string-escape) text))))

(def string-quote "\"")

(def string-escape "\\")

(def without-leading-blanks
  (fn (lines)
    (if (empty? lines)
      lines
      (if (blank? (first lines))
        (recur (rest lines))
        lines))))

(def join-lines
  (fn (lines) (join-with "\n" lines)))

(def join-with
  (fn (separator parts)
    (if (empty? parts)
      ""
      (pairs-joined separator (map-list parts string)))))

(def pairs-joined
  (fn (separator parts)
    (if (empty? (rest parts))
      (first parts)
      (recur separator
             (adjacent-pairs-joined separator (list) parts)))))

(def adjacent-pairs-joined
  (fn (separator joined parts)
    (if (empty? parts)
      joined
      (if (empty? (rest parts))
        (concat joined parts)
        (recur separator
               (concat joined
                       (list (string (first parts) separator (nth parts 1))))
               (drop parts 2))))))

(def without-trailing-newlines
  (fn (text)
    (local stripped (string-strip-suffix text "\n"))
    (if (value-eq stripped text) text (recur stripped))))

(defmacro with-macro-steps (count form)
  "Sets the macro step limit of the enclosing top-level form to `count`, then
  expands to `form`. A function call or a [recur] of macro code costs one
  step for each expression of the body it runs. An `expand-call` costs 64
  steps and one for each form it returns. A closure costs one step and one
  for each binding in scope where it is made. A read of a variable that an
  enclosing `fn` or `let` binds costs one step for each binding in scope
  that is newer than its own, and a read of a global or a built-in costs no
  step. A built-in costs one step for each list item it copies or reads and
  one for every 16 bytes of text it reads, and `closest-name` one step for
  each pair of bytes it compares between the name and the candidates. The
  limit stays set for the rest of the top-level form, so a smaller `count`
  lowers it.

  (with-macro-steps 1000000000 (+ 1 2))
  => 3"
  (if (set-macro-step-limit count)
    form
    (fail "`with-macro-steps` takes a whole number of steps"
      count
      "write a whole number from 0 to 18446744073709551615"
      (quote (:label "not a number of steps")))))
