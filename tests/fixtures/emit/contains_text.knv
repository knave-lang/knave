(defn main ()
  (local name (str "ea"))
  (local words (vec "a" "b"))
  (push! words "c")
  (local numbers (vec 1 2))
  (push! numbers 4)
  (local text (str "pear"))
  (println (contains? "pear" "ea"))
  (println (contains? text "ea"))
  (println (contains? "pear" (as-str name)))
  (println (contains? (ref text) "ea"))
  (println (contains? words "a"))
  (println (contains? numbers 3)))
