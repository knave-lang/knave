(type flip
  (fn ((pair i64 i128)) (pair i64 i128)))

(defn flip (p)
  (match p
    ((pair a b) (pair (the i64 (+ 1 a)) b))))

(type first-of
  (fn ((pair i64 i128)) i64))

(defn first-of (p)
  (match p ((pair first _) first)))

(defn step! (p) (set! p (flip p)))

(defn step-and-read! (p)
  (set! p (flip p))
  (first-of p))

(defn main ()
  (local miles (pair 120 (the i128 340)))
  (step! miles)
  (println (first-of miles))
  (println (step-and-read! miles))
  (println (first-of miles)))
