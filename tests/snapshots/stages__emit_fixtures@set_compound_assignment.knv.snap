---
#[derive(Clone, PartialEq, Eq, Hash)]
struct Counter {
    hits: i64,
    misses: i64,
}

fn make_counter(hits: i64, misses: i64) -> Counter {
    Counter { hits, misses }
}

#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct Cursor {
    i: i64,
}

fn make_cursor(i: i64) -> Cursor {
    Cursor { i }
}

fn miss(tally: &mut Counter) -> i64 {
    tally.misses += 1;
    1
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut total: i64 = 1;
    total += 2;
    total += 3;
    total = 10 - total;
    total -= 2_i64 * 3_i64;
    let mut tally = make_counter(0, 4);
    tally.hits *= 3;
    tally.hits = tally.misses + 1;
    tally.misses = {
        let current = tally.misses;
        let value = miss(&mut tally);
        current - value
    };
    tally.misses = {
        let value = miss(&mut tally);
        value * tally.misses
    };
    let mut scores: Vec<i64> = vec![1_i64, 2_i64, 3_i64];
    scores[0] += scores[2];
    let order: Vec<i64> = vec![2_i64, 0_i64];
    scores[crate::rt::index(order[0])] += 1;
    let index: i64 = 1;
    let by_index = &index;
    scores[crate::rt::index(*by_index)] += 1;
    scores[crate::rt::index(index)] += 1;
    let position = make_cursor(1);
    scores[crate::rt::index(position.i)] += 1;
    scores[crate::rt::index(index + 1)] += 1;
    let mut grid: Vec<Vec<i64>> = vec![vec![1_i64, 2_i64], vec![3_i64, 4_i64]];
    grid[crate::rt::index(index)][0] *= 2;
    let step = || 2_i64;
    scores[1] = {
        let current = scores[1];
        let value = step();
        current + value
    };
    println!("{}{}{}{}", total, tally.hits, tally.misses, scores[0])
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn index(value: i64) -> usize {
        match usize::try_from(value) {
            Ok(index) => index,
            Err(_) => negative(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn negative(value: i64) -> ! {
        panic!("attempt to use a negative value as an index or a size: {value}")
    }
}
