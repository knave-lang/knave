(defstruct book
  :title string
  :pages int)

(defstruct film
  :title string
  :pages int)

(defn long-titles (xs)
  (count (filter (iter xs)
           (fn (x) (> (len (:title x)) 3)))))

(defn main ()
  (println (long-titles (vec (->book (str "dune") 1)
                             (->book (str "it") 2))))
  (println (long-titles (vec (->film (str "jaws") 3)))))
