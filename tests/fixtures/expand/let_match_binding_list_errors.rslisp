(defn no-list () (let-match))

(defn flat (text)
  (let-match text (parse text) (ok text)))

(defn flat-without-body (text)
  (let-match text (parse text)))

(defn no-body (text)
  (let-match (value (parse text))))

(defn name-without-value (text)
  (let-match (value) (ok value)))

(defn old-list (text)
  (let-match ((value (parse text)))
    (ok value)))

(defn pattern-without-value ()
  (let-match ((some x)) (println x)))

(defn old-pairs ()
  (let-match ((a 1) (b 2))
    (println (+ a b))))

(defn old-pair-without-value ()
  (let-match ((a 1)) (println a)))

(defn value-and-body-missing ()
  (let-match ((some x))))

(defn number-head ()
  (let-match ((1 2) (pair 1 2))
    (println "one")))
