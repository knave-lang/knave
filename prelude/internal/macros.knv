(use code add-module-note concat drop empty? fail first len
          list nth number-lt prepend rest string string? symbol
          symbol? take value-eq)

(export add-docstring-note docstring-before-body?
        docstring-before-parameters docstrings-key
        documented-body? documented-terms-key joined-texts
        kernel-definition note-docstring noted-term
        term-docstrings-key type-doc-key value-doc-key
        whole-pairs?)

(def documented-body?
  (fn (body)
    (if (empty? body)
      false
      (string? (first body)))))

(def docstring-before-parameters
  (fn (docstring)
    (fail "a docstring goes after the parameter list"
      docstring
      "write it as the first body form, after the parameter list"
      (quote (:code docstring-before-parameters
                    :label "a docstring in place of the parameter list")))))

(def docstring-before-body?
  (fn (body)
    (if (number-lt 1 (len body))
      (string? (first body))
      false)))

(def docstrings-key (quote docstrings))

(def documented-terms-key (quote documented-terms))

(def noted-term
  (fn (note) (nth note 1)))

(def note-docstring
  (fn (key text)
    (add-docstring-note (concat key (list text)))))

(def add-docstring-note
  (fn (note)
    (add-module-note documented-terms-key (take note 2))
    (add-module-note (term-docstrings-key (noted-term note))
                     note)))

(def term-docstrings-key
  (fn (term) (symbol docstrings-key "docstrings-of-" term)))

(def value-doc-key
  (fn (name) (list "value" name)))

(def kernel-definition
  (fn (form)
    (if (symbol? form)
      (quote def)
      (if (value-eq (len form) 4)
        (four-form-definition form)
        (prepend (quote def) (rest form))))))

(def four-form-definition
  (fn (form)
    (if (string? (nth form 2))
      (do
        (note-docstring (value-doc-key (nth form 1))
                        (nth form 2))
        (list (quote def)
              (nth form 1)
              (nth form 3)))
      (prepend (quote def) (rest form)))))

(def whole-pairs?
  (fn (arguments)
    (if (empty? arguments)
      true
      (if (empty? (rest arguments))
        false
        (recur (drop arguments 2))))))

(def type-doc-key
  (fn (name) (list "type" name)))

(def joined-texts
  (fn (texts)
    (if (empty? texts)
      ""
      (if (empty? (rest texts))
        (first texts)
        (recur (joined-pairs-onto (list) texts))))))

(def joined-pairs-onto
  (fn (joined texts)
    (if (empty? texts)
      joined
      (if (empty? (rest texts))
        (concat joined texts)
        (recur (concat joined
                       (list (string (first texts) (nth texts 1))))
               (drop texts 2))))))
