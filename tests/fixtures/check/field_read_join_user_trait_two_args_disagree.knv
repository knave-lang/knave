(deftrait bigger
  (bigger?
    (fn ((ref self) (ref self)) bool)))

(impl bigger int
  (bigger? (self other)
    (> (deref self) (deref other))))

(defstruct cat
  :n int)

(defstruct dog
  :n int)

(defstruct fox
  :m float)

(defstruct owl
  :m float)

(defn wins? (x y)
  (bigger? (:n x) (:m y)))

(defn main ()
  (println (wins? (->cat 3) (->fox 2.0)))
  (println (wins? (->dog 1) (->owl 2.0))))
