(defstruct car
  :make str
  :year u16)

(defn build (year)
  (local assemble
    (fn ()
      (local make (str "Nissan"))
      (->car :make make :year year)))
  (assemble))

(defn build-maybe (year)
  (local assemble
    (fn ()
      (local make (str "Nissan"))
      (some (->car :make make :year year))))
  (assemble))

(defn main ()
  (println (:year (build 2024)))
  (match (build-maybe 2024)
    ((some built) (println (:year built)))
    (none (println 0))))
