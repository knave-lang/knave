(defn initial ((names (ref (pair string string))))
  (first names))

(defn age-then-name ((person (pair string i64)))
  (let (age (second person))
    (println (+ age (second person))))
  (first person))

(defn deep ((entry (ref (ref (pair i64 i64)))))
  (first entry))

(defn add-parts! ((scores (mut (pair i64 i64))))
  (+ (first scores) (second scores)))

(defn main ()
  (let (names (pair (str "ana") (str "bo"))
        scores (vec 3 4)
        totals (pair 5 6)
        nested (pair (pair 1 2) 3)
        rows (vec (pair 4 5)))
    (println (initial (ref names)))
    (println (second (ref names)))
    (prn (first scores))
    (prn (second scores))
    (prn (collect (map (windows scores 2) first)))
    (prn (collect (map (windows scores 2) second)))
    (println (first (pair 1 2.5)))
    (println (add-parts! (mut totals)))
    (println (second (first (ref nested))))
    (println (+ (first (at rows 0)) 1))
    (println (deep (ref (ref (pair 6 7)))))
    (println (age-then-name (pair (str "cy") 9)))
    (let (kept (pair (str "x") (str "y"))
          take (fn () (first kept)))
      (println (take)))
    (println (first names))
    (let (left (first names)
          right (second names))
      (println left right))
    (let (ranked (vec (pair (str "b") 2)
                      (pair (str "a") 1))
          kept (pair (str "c") 3)
          count (second (ref kept)))
      (sort-by! ranked
        (fn (entry) (second entry)))
      (prn ranked)
      (prn (collect (map (iter ranked)
                      (fn (entry) (second entry)))))
      (println (+ count 1)))))
