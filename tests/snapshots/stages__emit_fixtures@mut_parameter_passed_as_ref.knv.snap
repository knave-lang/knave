input_file: tests/fixtures/emit/mut_parameter_passed_as_ref.knv
---
fn shown(x: &i64) {
    println!("{}", x)
}

fn bump_and_show(n: &mut i64) {
    shown(n)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut count: i64 = 1;
    bump_and_show(&mut count);
    println!("{}", count)
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
