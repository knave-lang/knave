(defn keep (v) v)

(defn add (a b) (+ a b))

(defn first-or (xs d)
  (unwrap-or (get xs 0) d))

(defstruct point
  :x i64
  :y i64)

(defn main ()
  (local n 4)
  (local r (ref n))
  (println (keep r))
  (println (add (deref r) 1))
  (println (first-or (vec 1 2) 9))
  (local p (->point 1 2))
  (println (:x (keep p))))
