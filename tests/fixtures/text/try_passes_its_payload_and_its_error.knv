(defstruct label
  :text str)

(type read-name
  (fn ((ref str))
    (result string io-error)))

(defn read-name (path)
  (local text (try (slurp path)))
  (ok text))

(defn checked (count)
  (if (> count 0)
    (ok count)
    (err (str "bad " count))))

(defn doubled (count)
  (local value (try (checked count)))
  (ok (* value 2)))

(defn shortened (text)
  (if (empty? text)
    (err (str "empty"))
    (ok (trim text))))

(defn labeled (text)
  (ok (->label :text (try (shortened text)))))

(defn main ()
  (println (ok? (read-name "name.txt"))
           (ok? (doubled 2))
           (ok? (labeled " a "))
           (:text (->label :text (as-str (str "made" 1))))))
