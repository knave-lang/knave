#[derive(Clone, PartialEq, Eq, Hash)]
struct Book {
    title: String,
}

fn make_book(title: String) -> Book {
    Book { title }
}

#[derive(Clone, PartialEq, Eq, Hash)]
struct Film {
    title: String,
}

fn make_film(title: String) -> Film {
    Film { title }
}

fn measure<A: field_traits::HasTitle>(x: &A) -> i64 {
    crate::rt::length(field_traits::HasTitle::title(x).len())
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", measure(&make_book("dune".to_string())));
    println!("{}", measure(&make_film("jaws!".to_string())))
}

mod field_traits {
    pub trait HasTitle {
        fn title(&self) -> &String;
    }

    impl<T: HasTitle + ?Sized> HasTitle for &T {
        fn title(&self) -> &String {
            T::title(self)
        }
    }

    impl<T: HasTitle + ?Sized> HasTitle for &mut T {
        fn title(&self) -> &String {
            T::title(self)
        }
    }
}

impl field_traits::HasTitle for Book {
    fn title(&self) -> &String {
        &self.title
    }
}

impl field_traits::HasTitle for Film {
    fn title(&self) -> &String {
        &self.title
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn length(value: usize) -> i64 {
        match i64::try_from(value) {
            Ok(length) => length,
            Err(_) => too_long(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn too_long(value: usize) -> ! {
        panic!("length does not fit in int: {value}")
    }
}
