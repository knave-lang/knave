(def byte-count
  (rust "{0}.len()"
    (fn ((ref str)) usize)))

(type twice (fn (int) int))

(defn twice (n) (* n 2))

(defn main ()
  (println (twice (+ (byte-count "pear pear pear pear pear")
                     (byte-count "fig fig fig fig fig fig")
                     (byte-count "plum plum plum plum")))))
