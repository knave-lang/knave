(trait container
  (type item)
  (size (fn ((ref self)) usize)))

(trait producer
  (type output)
  (produce (fn ((ref self)) usize)))

(struct shelf (count usize))

(impl container shelf
  (type item usize)
  (size (s) (field s count)))

(struct counter (count usize))

(impl producer counter
  (type output usize)
  (produce (c) (field c count)))

(defn main ()
  (println (size (new shelf (count 2))))
  (println (produce (new counter (count 3)))))
