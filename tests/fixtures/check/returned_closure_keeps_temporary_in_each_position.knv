(defn sizer (items) (fn () (len items)))

(defn later () (fn () (sizer (vec 7))))

(defn main ()
  (let (pick (if (> 2 1)
               (sizer (vec 1))
               (sizer (vec 2 3))))
    (println (pick)))
  (let (chosen (match (some 1)
                 ((some n) (sizer (vec n)))
                 (none (sizer (vec 0)))))
    (println (chosen)))
  (let (blocked (do (println "x") (sizer (vec 4))))
    (println (blocked)))
  (let (looped (loop (i 0) (sizer (vec 8))))
    (println (looped)))
  (loop (size (sizer (vec 5))
         i 0)
    (if (< i 1)
      (recur (sizer (vec 6)) (+ i 1))
      (println (size))))
  (match (some 2)
    ((some n) (let (inner (sizer (vec n))) (println (inner))))
    (none (println 0)))
  (println (((later)))))
