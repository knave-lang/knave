fn framed<A: std::fmt::Display + ?Sized>(x: &A) -> String {
    format!("[{}]", x)
}

fn shout<A: std::fmt::Display + ?Sized>(x: &A) {
    println!("{} {}", framed(x), x)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    shout(&3_i64);
    shout("three")
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
