(deftrait holds
  (rust "Holds")
  (where (item) (with (vec item) item)))

(def holds?
  (rust "{0}.holds(&{&1})"
    (where ((whole (holds part)) part)
      (fn ((ref whole) part) bool))))

(defn has? (items item) (holds? items item))

(defn same? (left right) (= left right))

(defn has-two? ((scores (vec i64)))
  (has? scores 2))

(defn has-ana? ((names (vec (ref str))))
  (has? names "ana"))
