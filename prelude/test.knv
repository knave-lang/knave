(use prelude/macros docstrings-key document header-shape
                    map-list template)

(use prelude/internal/macros docstring-before-body?)
(use prelude/types vec)
(use prelude/number =)
(use prelude/vec vec)
(use prelude/text display show str)

(use code add-module-note bool-not concat definition-symbol
          empty? expand-call fail first form-location
          keyword-name keyword? len list list? located
          module-exports module-notes module-symbol nth
          number-add number-lt number-sub prepend
          program-modules project-modules read-form rest
          same-binding? string string-drop string-length
          string-lines string-strip-prefix
          string-strip-suffix string-trim-end
          string-trim-start string? symbol symbol-name
          symbol? value-eq)

(export assert check-library-examples deftest doctest
        run-tests)

(def deftest
  (macro (form)
    (check-test-shape form)
    (local name (nth form 1))
    (local body (rest (rest form)))
    (local documented (docstring-before-body? body))
    (local forms (if documented (rest body) body))
    (local function
      (symbol (quote test) "test-" (symbol-name name)))
    (template (do
                (def (unquote function)
                  (fn () (splice forms) (do)))
                (note-test (unquote function)
                           (unquote name)
                           (unquote (summary documented body))
                           (unquote (form-location form))
                           (unquote forms))))))

(header-shape (deftest name) :docstring)

(document (deftest name)
  "Defines a test that `knave test` runs when its module belongs to the
  project, not to a library.

  A string before at least one more body form is the docstring, whose first
  line a failure prints after the test's name. The test's function has an
  introduced name, so no name of the program collides with it.

  ```
  (deftest addition
    (assert (= (+ 1 2) 3)))
  ```")

(def check-test-shape
  (fn (form)
    (if (number-lt 1 (len form))
      (if (test-name? (nth form 1))
        form
        (misshapen-test form))
      (misshapen-test form))))

(def test-name?
  (fn (name)
    (if (symbol? name)
      (bool-not (keyword? name))
      false)))

(def misshapen-test
  (fn (form)
    (fail "this use of `deftest` does not match its shape"
      form "write it as `(deftest name body ...)`")))

(def summary
  (fn (documented body)
    (if documented
      (string-trim-start (first (string-lines (first body))))
      "")))

(def note-test
  (macro (form)
    (local name (nth form 2))
    (local key
      (symbol (quote test) "test " (symbol-name name)))
    (local module (definition-symbol (nth form 1) "tests"))
    (check-new-test name (module-notes module key))
    (add-module-note key name)
    (add-module-note (quote tests) (rest form))
    (template (do))))

(def check-new-test
  (fn (name earlier)
    (if (empty? earlier)
      name
      (duplicate-test name (first earlier)))))

(def duplicate-test
  (fn (name earlier)
    (fail (string "test `"
                  (symbol-name name)
                  "` is defined more than once")
      name "rename one of the tests"
      (template (:code duplicate-test
                       :label "defined again here"
                       :earlier (unquote earlier)
                       :earlier-label "first defined here")))))

(def note-function
  (fn (note) (nth note 0)))

(def note-name (fn (note) (nth note 1)))

(def note-summary
  (fn (note) (nth note 2)))

(def note-location
  (fn (note) (nth note 3)))

(def note-body (fn (note) (nth note 4)))

(def assert
  (macro (form)
    (check-assert-shape form)
    (local checked (nth form 1))
    (local written
      (list (form-location form) (string form)))
    (local message
      (map-list (rest (rest form)) deferred-message))
    (if (equality? checked)
      (equal-assertion (equal-check message)
                       written checked message)
      (concat (prepend (true-check message) written)
              (prepend checked message)))))

(def deref-call?
  (fn (side)
    (if (list? side)
      (if (empty? side)
        false
        (if (symbol? (first side))
          (if (same-binding? (first side) (quote deref))
            true
            (expands-to-deref? (expand-call side)))
          false))
      false)))

(def expands-to-deref?
  (fn (expansion)
    (if (empty? expansion)
      false
      (deref-call? (first expansion)))))

(def deferred-message
  (fn (message)
    (if (string? message)
      (template (fn () (unquote message)))
      (template (fn () (str (unquote message)))))))

(def equal-assertion
  (fn (check written checked message)
    (comparison-call check written checked
                     (comparison-closure)
                     message)))

(def comparison-closure
  (fn ()
    (template (fn (left right) (= left right)))))

(def comparison-call
  (fn (check written checked closure message)
    (template ((unquote check)
               (splice written)
               (unquote (passed-side (nth checked 1)))
               (unquote (passed-side (nth checked 2)))
               (unquote closure)
               (splice message)))))

(def passed-side
  (fn (side)
    (if (deref-call? side)
      (list (quote do) side)
      side)))

(document (assert form)
  "Ends the test with a failure unless `form` is true.

  `(assert form \"message\")` adds a message to the failure. When `form` is
  `(= left right)`, the failure shows both sides in their printed form.

  ```
  (deftest addition
    (assert (= (+ 1 2) 3))
    (assert (> 2 1) \"two is larger\"))
  ```")

(def check-assert-shape
  (fn (form)
    (if (number-lt 1 (len form))
      (if (number-lt (len form) 4)
        form
        (misshapen-assert form))
      (misshapen-assert form))))

(def misshapen-assert
  (fn (form)
    (fail "this use of `assert` does not match its shape"
      form
      "write it as `(assert form)` or `(assert form \"message\")`")))

(def equality?
  (fn (checked)
    (if (list? checked)
      (if (value-eq (len checked) 3)
        (equal-head? (first checked))
        false)
      false)))

(def equal-head?
  (fn (head)
    (if (symbol? head)
      (same-binding? head (quote =))
      false)))

(def equal-check
  (fn (message)
    (if (empty? message)
      (quote check-equal)
      (quote check-equal-with))))

(def true-check
  (fn (message)
    (if (empty? message)
      (quote check-true)
      (quote check-true-with))))

(def run-tests
  (macro (form)
    (check-run-tests-shape form)
    (local marker (nth form 2))
    (local modules (project-modules))
    (local notes
      (concat (program-tests modules) (program-doc-tests modules)))
    (template (do
                (splice (untested-records marker (untested-option form) notes))
                (start-run (unquote marker)
                           (vec (splice (map-list notes test-full-name))))
                (splice (map-list notes
                                  (fn (note) (test-run marker note))))
                (finish-run (unquote marker))))))

(def library-modules
  (fn (own)
    (mapped-concat (fn (module)
                     (if (loaded-module? own module)
                       (list)
                       (list module)))
                   (program-modules))))

(def check-library-examples
  (macro (form)
    (check-library-examples-shape form)
    (local examples
      (program-doc-tests (library-modules (project-modules))))
    (template (do
                (splice (library-example-definitions examples 0 (list)))))))

(def check-library-examples-shape
  (fn (form)
    (if (value-eq (len form) 1)
      form
      (fail "this use of `check-library-examples` does not match its shape"
        form "write it as `(check-library-examples)`"))))

(header-shape (check-library-examples))

(document (check-library-examples)
  "Checks the docstring examples of every library the program loads, without
  running them.

  Each example becomes a definition with an introduced name that nothing
  calls, so the examples emit nothing. `knave test` writes it in the module
  it generates beside its runner.")

(def library-example-definitions
  (fn (notes index found)
    (if (empty? notes)
      found
      (recur (rest notes)
             (number-add index 1)
             (concat found
                     (list (library-example-definition (first notes)
                                                       index)))))))

(def library-example-definition
  (fn (module-note index)
    (template (def (unquote (symbol (quote check-library-examples)
                                    "library-example-"
                                    index))
                (unquote (note-function (rest module-note)))))))

(def doctest
  (macro (form)
    (check-doctest-shape form)
    (module-symbol (nth form 1))
    (add-module-note (quote doctests)
                     (list (first form) (nth form 1)))
    (template (do))))

(def check-doctest-shape
  (fn (form)
    (if (doctest-call? form)
      form
      (fail "this use of `doctest` does not match its shape"
        form "write it as `(doctest module)`"))))

(def doctest-call?
  (fn (form)
    (if (value-eq (len form) 2)
      (symbol? (nth form 1))
      false)))

(header-shape (doctest module))

(document (doctest module)
  "Runs the docstring examples of `module` under `knave test`.

  The examples read in the scope of the module that writes the `doctest`.

  (doctest prelude/test)
  => ...")

(def program-doc-tests
  (fn (modules)
    (concat (mapped-concat own-doc-tests modules)
            (mapped-concat asked-doc-tests modules))))

(def own-doc-tests
  (fn (module) (module-doc-tests module module)))

(def asked-doc-tests
  (fn (module)
    (mapped-concat asked-module-doc-tests
                   (module-notes module (quote doctests)))))

(def asked-module-doc-tests
  (fn (asked)
    (if (loaded-module? (program-modules) (nth asked 1))
      (list)
      (module-doc-tests (module-symbol (nth asked 1))
                        (first asked)))))

(def loaded-module?
  (fn (modules path)
    (if (empty? modules)
      false
      (if (value-eq (symbol-name (first modules))
                    (symbol-name path))
        true
        (recur (rest modules) path)))))

(def module-doc-tests
  (fn (target context)
    (concat (mapped-concat (fn (note) (term-doc-test target context note))
                           (module-notes target docstrings-key))
            (mapped-concat (fn (text) (doc-test target context target text))
                           (counted-module-docstring target)))))

(def counted-module-docstring
  (fn (target)
    (local docstrings
      (module-notes target (quote module-docstrings)))
    (if (empty? docstrings)
      docstrings
      (list (first docstrings)))))

(def term-doc-test
  (fn (target context note)
    (doc-test target context
              (noted-doc-name note)
              (last-item note))))

(def noted-doc-name
  (fn (note) (nth note 1)))

(def last-item
  (fn (items)
    (nth items (number-sub (len items) 1))))

(def mapped-concat
  (fn (function items)
    (mapped-concat-onto function items (list))))

(def mapped-concat-onto
  (fn (function items found)
    (if (empty? items)
      found
      (recur function
             (rest items)
             (concat found (function (first items)))))))

(def doc-test
  (fn (target context term text)
    (local steps (docstring-steps context text))
    (if (empty? steps)
      (list)
      (list (list target
                  (template (fn () (splice steps) (do)))
                  (symbol context "doc:" (symbol-name term))
                  (string-trim-start (first (string-lines text)))
                  (form-location text)
                  steps)))))

(def docstring-steps
  (fn (context text)
    (mapped-concat (fn (block) (block-steps context text block))
                   (paragraphs (doc-lines (string-lines text)
                                          0
                                          (list)
                                          (list))
                               (list)
                               (list)))))

(def doc-lines
  (fn (remaining offset fence found)
    (if (empty? remaining)
      found
      (recur (rest remaining)
             (number-add offset
                         (number-add (string-length (first remaining)) 1))
             (fence-after fence (first remaining))
             (concat found
                     (list (doc-line fence (first remaining) offset)))))))

(def fence-after
  (fn (fence line)
    (if (empty? fence)
      (opening-fence line)
      (if (closes-fence? fence line) (list) fence))))

(def opening-fence
  (fn (line)
    (concat (fence-of line "`") (fence-of line "~"))))

(def fence-of
  (fn (line mark)
    (local run (leading-run (string-trim-start line) mark 0))
    (if (number-lt run minimum-fence-length)
      (list)
      (list mark run))))

(def minimum-fence-length 3)

(def leading-run
  (fn (text mark count)
    (if (value-eq (string-strip-prefix text mark) text)
      count
      (recur (string-strip-prefix text mark)
             mark
             (number-add count 1)))))

(def closes-fence?
  (fn (fence line)
    (local text (string-trim-start line))
    (local run (leading-run text (first fence) 0))
    (if (number-lt run (nth fence 1))
      false
      (value-eq (string-trim-end (string-drop text run)) ""))))

(def starts-with?
  (fn (line prefix)
    (bool-not (value-eq (string-strip-prefix (string-trim-start line) prefix)
                        (string-trim-start line)))))

(def doc-line
  (fn (fence line offset)
    (if (empty? (concat fence (fence-after fence line)))
      (list line offset)
      (list "" offset))))

(def line-text (fn (line) (first line)))

(def line-offset
  (fn (line) (nth line 1)))

(def blank-line?
  (fn (line)
    (value-eq (string-trim-start (line-text line)) "")))

(def paragraphs
  (fn (lines current found)
    (if (empty? lines)
      (closed-paragraph found current)
      (if (blank-line? (first lines))
        (recur (rest lines)
               (list)
               (closed-paragraph found current))
        (recur (rest lines)
               (concat current (list (first lines)))
               found)))))

(def closed-paragraph
  (fn (found current)
    (if (empty? current)
      found
      (concat found (list current)))))

(def block-steps
  (fn (context text lines)
    (local steps (block-forms context text lines (list)))
    (if (holds-example? steps) steps (list))))

(def holds-example?
  (fn (steps)
    (if (empty? steps)
      false
      (if (example-step? (first steps))
        true
        (recur (rest steps))))))

(def example-step?
  (fn (step)
    (if (list? step)
      (if (empty? step)
        false
        (if (symbol? (first step))
          (example-head? (first step))
          false))
      false)))

(def example-head?
  (fn (head)
    (if (same-binding? head (quote check-example))
      true
      (if (same-binding? head (quote run-example))
        true
        (same-binding? head (quote unreadable-example))))))

(def block-forms
  (fn (context text lines steps)
    (local state (block-state context text lines steps))
    (if (empty? (state-lines state))
      (state-steps state)
      (recur context text (state-lines state) (state-steps state)))))

(def state-lines
  (fn (state) (first state)))

(def state-steps
  (fn (state) (nth state 1)))

(def finished-block
  (fn (steps) (list (list) steps)))

(def rejected-block
  (fn () (finished-block (list))))

(def block-state
  (fn (context text lines steps)
    (code-form-state context text lines steps
                     (read-line-form context text (first lines)))))

(def read-line-form
  (fn (context text line)
    (read-form context text
               (number-add (line-offset line) (line-indent line)))))

(def code-form-state
  (fn (context text lines steps read)
    (if (empty? read)
      (rejected-block)
      (after-code context text
                  (lines-after lines (nth read 1))
                  steps
                  (first read)))))

(def lines-after
  (fn (lines end)
    (if (empty? lines)
      lines
      (if (number-lt (end-of-line (first lines)) end)
        (recur (rest lines) end)
        (prepend (list (nth (first lines) 0)
                       (nth (first lines) 1)
                       end)
                 (rest lines))))))

(def end-of-line
  (fn (line)
    (number-add (line-offset line)
                (string-length (line-text line)))))

(def after-code
  (fn (context text lines steps code)
    (if (form-ends-its-line? lines)
      (next-step context text (rest lines) steps code)
      (rejected-block))))

(def form-ends-its-line?
  (fn (lines)
    (if (empty? lines)
      false
      (rest-blank? (first lines)))))

(def rest-blank?
  (fn (line)
    (blank-text? (string-drop (line-text line)
                              (number-sub (nth line 2) (line-offset line))))))

(def blank-text?
  (fn (text)
    (local trimmed (string-trim-start text))
    (if (value-eq trimmed "")
      true
      (starts-with? trimmed comment-mark))))

(def comment-mark ";")

(def next-step
  (fn (context text lines steps code)
    (if (arrow-line? lines)
      (read-example context text lines steps code)
      (list lines (concat steps (list code))))))

(def arrow-line?
  (fn (lines)
    (if (empty? lines)
      false
      (starts-with? (line-text (first lines)) arrow))))

(def arrow "=> ")

(def read-example
  (fn (context text lines steps code)
    (local arrow-form (read-arrow context text (first lines)))
    (local read
      (read-form context text (result-offset (first lines))))
    (local remaining (result-lines lines read))
    (if (unchecked-result? remaining)
      (list (rest remaining)
            (concat steps (list (unchecked-step arrow-form code))))
      (compared-state steps arrow-form code read remaining))))

(def read-arrow
  (fn (context text line)
    (first (read-form context text
                      (number-add (line-offset line) (line-indent line))))))

(def result-offset
  (fn (line)
    (number-add (line-offset line)
                (number-add (line-indent line) (string-length arrow)))))

(def line-indent
  (fn (line)
    (number-sub (string-length (line-text line))
                (string-length (string-trim-start (line-text line))))))

(def result-lines
  (fn (lines read)
    (if (empty? read)
      lines
      (lines-after lines (nth read 1)))))

(def unchecked-result?
  (fn (lines)
    (if (empty? lines)
      false
      (ends-with-unchecked-mark? (string-trim-end (line-text (first lines)))))))

(def ends-with-unchecked-mark?
  (fn (text)
    (bool-not (value-eq (string-strip-suffix text unchecked-result-mark)
                        text))))

(def unchecked-result-mark "...")

(def compared-state
  (fn (steps arrow-form code read remaining)
    (if (if (empty? read) false (form-ends-its-line? remaining))
      (list (rest remaining)
            (concat steps
                    (list (example-step arrow-form code (first read)))))
      (finished-block (concat steps (list (unreadable-step code)))))))

(def example-step
  (fn (arrow-form code expected)
    (located arrow-form
             (template (check-example (unquote code) (unquote expected))))))

(def unchecked-step
  (fn (arrow-form code)
    (located arrow-form
             (template (run-example (unquote code))))))

(def unreadable-step
  (fn (code)
    (located code
             (template (unreadable-example (unquote code))))))

(def run-example
  (macro (form) (nth form 1)))

(def unreadable-example
  (macro (form)
    (fail "the result of this example does not read as one form"
      (nth form 1)
      "write the result as one form, end it with `...` to run the example without comparing its result, or put the example in a fenced code block to show it without running it"
      (quote (:code unreadable-doc-example
                    :label "the line after this form starts with `=> `")))))

(def check-example
  (macro (form)
    (local code (nth form 1))
    (local expected (nth form 2))
    (comparison-call (quote check-equal)
                     (list (form-location code)
                           (string (string code) " => " (string expected)))
                     (list (quote =) code expected)
                     (located-forms code (comparison-closure))
                     (list))))

(def located-forms
  (fn (place form)
    (if (list? form)
      (located place
               (map-list form
                         (fn (item) (located-forms place item))))
      (located place form))))

(def untested-option
  (fn (form)
    (if (value-eq (len form) 5)
      (list (nth form 4))
      (list))))

(def check-run-tests-shape
  (fn (form)
    (if (runner-call? form)
      form
      (fail "this use of `run-tests` does not match its shape"
        form
        "write it as `(run-tests :marker \"text\")` or `(run-tests :marker \"text\" :untested module)`"))))

(def runner-call?
  (fn (form)
    (if (value-eq (len form) 3)
      (marker-option? form)
      (if (value-eq (len form) 5)
        (if (marker-option? form) (untested-option? form) false)
        false))))

(def marker-option?
  (fn (form)
    (if (named-key? (nth form 1) "marker")
      (string? (nth form 2))
      false)))

(def untested-option?
  (fn (form)
    (if (named-key? (nth form 3) "untested")
      (symbol? (nth form 4))
      false)))

(def named-key?
  (fn (key name)
    (if (keyword? key)
      (value-eq (keyword-name key) name)
      false)))

(def program-tests
  (fn (modules)
    (if (empty? modules)
      (list)
      (concat (map-list (module-notes (first modules) (quote tests))
                        (fn (note)
                          (prepend (first modules) note)))
              (program-tests (rest modules))))))

(def test-full-name
  (fn (module-note)
    (string (symbol-name (first module-note))
            "/"
            (symbol-name (note-name (rest module-note))))))

(def test-run
  (fn (marker module-note)
    (local note (rest module-note))
    (template (run-test (unquote marker)
                        (unquote (test-full-name module-note))
                        (unquote (note-summary note))
                        (unquote (note-location note))
                        (unquote (note-function note))))))

(def untested-records
  (fn (marker option notes)
    (if (empty? option)
      (list)
      (untested-record marker
                       (first option)
                       (module-exports (first option))
                       (written-symbols (map-list (map-list notes rest)
                                                  note-body))))))

(def untested-record
  (fn (marker module exports written)
    (local untested (unwritten exports written))
    (list (template (note-untested (unquote marker)
                                   (unquote (symbol-name module))
                                   (unquote (len exports))
                                   (unquote (joined-names untested)))))))

(def written-symbols
  (fn (form)
    (if (list? form)
      (written-symbols-of (list) form)
      (if (symbol? form) (list form) (list)))))

(def written-symbols-of
  (fn (found forms)
    (if (empty? forms)
      found
      (recur (concat found (written-symbols (first forms)))
             (rest forms)))))

(def unwritten
  (fn (exports written)
    (if (empty? exports)
      (list)
      (if (written? (first exports) written)
        (unwritten (rest exports) written)
        (prepend (first exports)
                 (unwritten (rest exports) written))))))

(def written?
  (fn (export written)
    (if (empty? written)
      false
      (if (same-binding? export (first written))
        true
        (recur export (rest written))))))

(def joined-names
  (fn (names)
    (if (empty? names)
      ""
      (joined-onto (symbol-name (first names))
                   (rest names)))))

(def joined-onto
  (fn (joined names)
    (if (empty? names)
      joined
      (recur (string joined " " (symbol-name (first names)))
             (rest names)))))

(def check-true
  (rust "crate::rt::check_true({0}, {1}, {2})"
    (fn ((ref str) (ref str) bool) unit)))

(def check-true-with
  (rust "crate::rt::check_true_with({0}, {1}, {2}, {3})"
    (where ((m display))
      (fn ((ref str)
           (ref str)
           bool
           (fn-once () m))
        unit))))

(def check-equal
  (rust "crate::rt::check_equal({0}, {1}, {2}, {3}, {4})"
    (where ((a show) (b show))
      (fn ((ref str)
           (ref str)
           (ref a)
           (ref b)
           (fn ((ref a) (ref b)) bool))
        unit))))

(def check-equal-with
