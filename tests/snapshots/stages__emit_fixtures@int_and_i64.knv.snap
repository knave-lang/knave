input_file: tests/fixtures/emit/int_and_i64.knv
---
#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct Point {
    x: i64,
    y: i64,
}

fn make_point(x: i64, y: i64) -> Point {
    Point { x, y }
}

fn add(x: i64, y: i64) -> i64 {
    x + y
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let total: i64 = add(1, 2);
    let corner = make_point(3, 4);
    println!("{}", total);
    println!("{}", add(corner.x, corner.y));
    println!("{}", "int");
    println!("{}", "(fn (int int) int)");
    println!("{}", "point")
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
