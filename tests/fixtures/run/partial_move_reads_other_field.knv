(defstruct badge
  :text str
  :size u16)

(defstruct garage
  :name str
  :badge badge)

(defn main ()
  (local g
    (->garage (str "Leaf Garage")
              (->badge (str "open") 12)))
  (local b (assoc (:badge g) :size 14))
  (println (:text b)
           " "
           (:size b)
           " "
           (:name g)))
