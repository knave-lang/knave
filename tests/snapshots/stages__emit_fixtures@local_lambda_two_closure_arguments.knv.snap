fn main() {
    crate::rt::restore_default_sigpipe();
    let year: i64 = 2024;
    let model = "Nissan Leaf";
    let mut seen: Vec<i64> = vec![0_i64];
    let apply = |action: &mut dyn FnMut(i64)| action(year);
    apply(&mut |n: i64| println!("{}{}", model, n));
    apply(&mut |n: i64| seen.push(n));
    println!("{}", crate::rt::length(seen.len()))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn length(value: usize) -> i64 {
        match i64::try_from(value) {
            Ok(length) => length,
            Err(_) => too_long(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn too_long(value: usize) -> ! {
        panic!("length does not fit in int: {value}")
    }
}
