(trait named
  (name (fn ((ref self)) string)))

(defstruct user
  :name str)

(defstruct animal
  :name str)

(impl named user (name (u) (str "u")))

(defn hello (x)
  (str "hello " (:name x)))

(defn main ()
  (println (name (->user "ana")))
  (println (hello (->user "ana")))
  (println (hello (->animal "rex"))))
