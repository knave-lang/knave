(defstruct point
  :x int
  :y int)

(defstruct line
  :start point)

(defstruct span
  :start point)

(type start-x
  (where ((a (has :start point)))
    (fn ((ref a)) int)))

(defn start-x (l) (+ (:x (:start l)) 1))

(defn main ()
  (println (start-x (->line (->point 1 2))))
  (println (start-x (->span (->point 5 6)))))
