(trait first-match
  (first-match
    (fn ((ref self)) bool)))

(impl first-match (vec a)
  (first-match (items)
    (local item (at items 0))
    (local first (clone item))
    (do (local _first first) true)))

(defn checks ((counts (ref (vec int))))
  (first-match counts))

(defn main ()
  (local counts (vec 1 2))
  (println (checks (ref counts))))
