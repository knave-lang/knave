fn is_same(a: i64, b: i64) -> bool {
    a == b
}

fn recent(years: &[i64], floor: i64) -> i64 {
    let n: i64 = crate::rt::count(years.iter().filter(|y: &&i64| **y > floor));
    if is_same(floor, floor) { n } else { 0 }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let years: Vec<i64> = vec![2019_i64, 2021_i64, 2024_i64];
    println!("{}", recent(&years, 2020))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn count(items: impl Iterator) -> i64 {
        let counted = items.count();
        match i64::try_from(counted) {
            Ok(count) => count,
            Err(_) => count_overflow(counted),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn count_overflow(counted: usize) -> ! {
        panic!("attempt to count with overflow: the count is {counted}")
    }
}
