fn looped(items: &mut Vec<i64>) -> impl FnOnce() -> usize {
    items.push(1);
    let it = items.iter();
    || it.count()
}

fn matched(items: &mut Vec<i64>) -> impl FnOnce() -> usize {
    items.push(1);
    let it = items.iter();
    || it.count()
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut items: Vec<i64> = vec![0_i64];
    println!("{}", looped(&mut items)());
    println!("{}", matched(&mut items)())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
