(defn climb! (height)
  (set! height (+ height 1))
  (if (< height 5) (recur (+ height 1)) height))

(defn climb-counted! (height steps)
  (set! height (+ height 1))
  (if (< steps 3) (recur (+ height 1) (+ steps 1)) steps))

(defn climb-again! (height)
  (set! height (+ height 1))
  (if (< height 9) (climb-again! height) height))

(defn main ()
  (local floor 0)
  (println (climb! floor))
  (println floor)
  (println (climb-counted! floor 0))
  (println floor)
  (println (climb-again! floor))
  (println floor))
