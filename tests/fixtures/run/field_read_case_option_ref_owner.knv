(defstruct user
  :n (option int))

(defstruct animal
  :n (option int))

(defn has-n (x) (some? (:n x)))

(defn main ()
  (let (u (->user (some 1))
        a (->animal none))
    (println (has-n (ref u)))
    (println (has-n (ref a)))
    (println (count (filter (iter (vec u))
                      (fn (v) (has-n v)))))))
