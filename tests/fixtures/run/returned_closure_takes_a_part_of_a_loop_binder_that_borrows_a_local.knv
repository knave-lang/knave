(defn greeter (name)
  (fn () (println (str "hi " name))))

(enum (duo 'a 'b)
  (both (ref 'a string) (ref 'b str)))

(defn main ()
  (let (s (str "a")
        matched (greeter (loop (p (pair (ref (str "zz")) (as-str s)))
                           (match p ((pair _ b) b))))
        repeated (greeter (loop (p (pair (ref (str "zz")) (as-str s))
                                 i 0)
                            (if (< i 1)
                              (recur p (+ i 1))
                              (let-match ((pair _ b) p) b))))
        case (greeter (loop (d (duo/both (ref (str "zz")) (as-str s)))
                        (match d ((duo/both _ b) b))))
        through-local (greeter (let (q (pair (ref (str "zz")) (as-str s)))
                                 (loop (p q)
                                   (let-match ((pair _ b) p) b)))))
    (matched)
    (repeated)
    (case)
    (through-local)))
