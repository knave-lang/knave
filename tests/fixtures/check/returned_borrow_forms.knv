(defstruct car
  :make str
  :year u16)

(defstruct point
  :x i64
  :y i64)

(defstruct pin
  :at (ref point))

(struct (holder a) (held a))

(enum badge (titled str u16) plain)

(enum plaque
  (engraved (struct (text str) (count u16)))
  empty)

(defn grouped (year)
  (local make (str "Nissan"))
  (new car (make make) (year year)))

(defn pinned ()
  (local origin (->point 0 0))
  (->pin :at (ref origin)))

(defn titled (year)
  (local title (str "Leaf"))
  (badge/titled title year))

(defn held ()
  (local make (str "Nissan"))
  (new holder (held make)))

(defn stamped (year)
  (local make (str "Nissan"))
  (plaque/engraved make year))

(defn main ()
  (println (:year (grouped 2024))))
