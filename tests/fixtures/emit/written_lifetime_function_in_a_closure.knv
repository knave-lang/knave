(type lines-longer-than
  (where ('a)
    (fn ((ref 'a str) (ref str))
      (iterator (ref 'a str)))))

(defn lines-longer-than (text shortest)
  (filter (lines text)
    (fn (line)
      (> (len line) (len shortest)))))

(defn main ()
  (for-each (lines-longer-than "ab\nb" "b")
    (fn (part) (println part))))
