(defn walk! (steps rounds)
  (set! steps (+ steps 1))
  (if (> rounds 0)
    (recur rounds (- rounds 1))
    steps))

(defn walk-again! (steps rounds)
  (set! steps (+ steps 1))
  (if (> rounds 0)
    (walk-again! rounds (- rounds 1))
    steps))

(defn main ()
  (local laps 0)
  (local rounds 2)
  (println (walk! laps rounds))
  (println laps rounds)
  (println (walk-again! laps rounds))
  (println laps rounds))
