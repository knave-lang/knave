(defn main ()
  (local items (vec 3 5 8))
  (local count 2)
  (local counted (ref count))
  (println (deref (at items 0)))
  (println "count: " (deref counted))
  (println (str "last: " (deref (at items 2))))
  (prn (deref (at items 1)))
  (prn (deref counted))
  (println (pr-str (deref (at items 2)))))
