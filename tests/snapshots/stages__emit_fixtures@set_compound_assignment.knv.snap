input_file: tests/fixtures/emit/set_compound_assignment.knv
---
#[derive(Clone, PartialEq, Eq, Hash)]
struct Counter {
    hits: i64,
    misses: i64,
}

fn make_counter(hits: i64, misses: i64) -> Counter {
    Counter { hits, misses }
}

#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct Cursor {
    i: usize,
}

fn make_cursor(i: usize) -> Cursor {
    Cursor { i }
}

fn miss(tally: &mut Counter) -> i64 {
    tally.misses += 1;
    1
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut total: i64 = 1;
    total += 2;
    total += 3;
    total = 10 - total;
    total -= 2_i64 * 3_i64;
    let mut tally = make_counter(0, 4);
    tally.hits *= 3;
    tally.hits = tally.misses + 1;
    tally.misses = {
        let current = tally.misses;
        let value = miss(&mut tally);
        current - value
    };
    tally.misses = {
        let value = miss(&mut tally);
        value * tally.misses
    };
    let mut scores: Vec<i64> = vec![1_i64, 2_i64, 3_i64];
    scores[0] += scores[2];
    let order: Vec<usize> = vec![2_usize, 0_usize];
    scores[order[0]] += 1;
    let index: usize = 1;
    let by_index = &index;
    scores[*by_index] += 1;
    scores[index] += 1;
    let position = make_cursor(1);
    scores[position.i] += 1;
    scores[index + 1] += 1;
    let mut grid: Vec<Vec<i64>> = vec![vec![1_i64, 2_i64], vec![3_i64, 4_i64]];
    grid[index][0] *= 2;
    let step = || 2_i64;
    scores[1] = {
        let current = scores[1];
        let value = step();
        current + value
    };
    println!("{}{}{}{}", total, tally.hits, tally.misses, scores[0])
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}
}
