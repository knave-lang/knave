(def measure
  (rust "std::mem::size_of_val(&{&0})"
    (where ((a clone)) (fn (a) usize))
    ((ref str) "std::mem::size_of_val({0})")
    (i64 "std::mem::size_of_val({0})")
    (ord "std::mem::size_of_val({0})")))

(def shared-length
  (rust "std::mem::size_of_val(&{&0})"
    (where ((a clone)) (fn ((ref a)) usize))
    (clone "std::mem::size_of_val({0})")))

(def plus-shared
  (rust "{0} + &{1}"
    (where ((a clone)) (fn (a (ref a)) a))
    (i64 "{0} + {1}")))

(def both-bits
  (rust "{0} & {1}"
    (where ((a clone)) (fn (a a) a))
    (i64 "{0}&{1}")))

(rust-trait holds "crate::Holds"
  (with str (ref str))
  (where ((item partial-eq))
    (with (vec item) item))
  (where ((whole (holds part)) part)
    (with (ref whole) part)))

(def has?
  (rust "{0}.contains(&{&1})"
    (where ((whole (holds part)) part)
      (fn (whole part) bool))
    ((ref str) "{0}.contains({1})")))

(def matched-size
  (rust "match &{&0} {{ v => std::mem::size_of_val(v) }}"
    (where ((a clone)) (fn (a) usize))
    ((ref str) "match {0} {{ v => std::mem::size_of_val(v) }}")))

(def vector-length
  (rust "f({0}, &{&1})"
    (where ((a clone) b)
      (fn (a (vec b)) usize))
    (i64 "f({0}, {1})")))

(defn main () (println (measure 3)))
