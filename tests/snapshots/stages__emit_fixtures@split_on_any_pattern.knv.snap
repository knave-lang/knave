source: tests/stages.rs
expression: reports.report(path)
input_file: tests/fixtures/emit/split_on_any_pattern.knv
---
fn part_count<P: crate::rt::Separator>(text: &str, separator: P) -> i64 {
    crate::rt::count(crate::rt::Separator::split(separator, text))
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!("{}", part_count("a,b,c", ","));
    println!("{}", part_count("a b", 'x'));
    println!(
        "{}",
        part_count("a1b2c", |argument_0: char| argument_0.is_ascii_digit())
    );
    {
        let mut strings = Vec::new();
        strings.push(";".to_string());
        strings.iter().for_each(|separator: &String| {
            println!("{}", part_count("a;b", separator));
            println!("{}", crate::rt::count("a;b;c".split(separator)))
        })
    }
    {
        let mut literals = Vec::new();
        literals.push(",");
        literals.push(";");
        literals.iter().for_each(|separator: &&str| {
            println!("{}", part_count("a,b;c", separator));
            println!("{}", crate::rt::count("a,b;c".split(separator)))
        })
    }
    println!("{}", crate::rt::count("a,b".split(",")));
    println!("{}", crate::rt::count("a b".split(' ')));
    println!(
        "{}",
        crate::rt::count("a1b".split(|argument_0: char| argument_0.is_ascii_digit()))
    )
}

mod rt {
    pub trait Separator: Sized {
        type Parts<'a>: Iterator<Item = &'a str>;

        fn split<'a>(self, text: &'a str) -> Self::Parts<'a>;
    }

    impl<'s> Separator for &'s str {
        type Parts<'a> = std::str::Split<'a, &'s str>;

        fn split<'a>(self, text: &'a str) -> Self::Parts<'a> {
            text.split(self)
        }
    }

    impl<'s> Separator for &'s String {
        type Parts<'a> = std::str::Split<'a, &'s String>;

        fn split<'a>(self, text: &'a str) -> Self::Parts<'a> {
            text.split(self)
        }
    }

    impl<'s, 't> Separator for &'s &'t str {
        type Parts<'a> = std::str::Split<'a, &'s &'t str>;

        fn split<'a>(self, text: &'a str) -> Self::Parts<'a> {
            text.split(self)
        }
    }

    impl Separator for char {
        type Parts<'a> = std::str::Split<'a, char>;

        fn split<'a>(self, text: &'a str) -> Self::Parts<'a> {
            text.split(self)
        }
    }

    impl<F: FnMut(char) -> bool> Separator for F {
        type Parts<'a> = std::str::Split<'a, F>;

        fn split<'a>(self, text: &'a str) -> Self::Parts<'a> {
            text.split(self)
        }
    }

    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn count(items: impl Iterator) -> i64 {
        let counted = items.count();
        match i64::try_from(counted) {
            Ok(count) => count,
            Err(_) => count_overflow(counted),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn count_overflow(counted: usize) -> ! {
        panic!("attempt to count with overflow: the count is {counted}")
    }
}
