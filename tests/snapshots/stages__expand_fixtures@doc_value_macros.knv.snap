---
source: tests/stages.rs
expression: reports.report(path)
input_file: tests/fixtures/expand/doc_value_macros.knv
---
(def str-page "(str part ...)\n\nBuilds a [string] from its parts.\n\nA string literal part is literal text, and any other part prints with\n[display]. `(str x)` emits `x.to_string()`, and `str` as a value is that\none-part function, so `(map (iter years) str)` turns each year into a\n`string`.\n\n(str \"year \" 2026)\n=> \"year 2026\"\n\n(collect (map (iter (vec 1 2)) str))\n=> (vec (str 1) (str 2))")
(def get-page "(get collection key)\n\nReads a slice by index or a map by key.\n\nIt returns an [option] of a borrow, and `none` for a missing index or\nkey. `get` as a value is the slice reader.\n\n(local items (vec 10 20))\n(get items 1)\n=> (some (ref 20))\n\n(local prices (sorted-map \"pear\" 3))\n(get prices \"fig\")\n=> none")
(def push-page "(push! target item)\n\nAdds an item to a vector or a string.\n\nA vector takes an element, and a [string] takes a [char] or a\n`(ref str)`. `push!` as a value is the vector push.\n\n(local items (vec 1))\n(push! items 2)\n(clone items)\n=> (vec 1 2)\n\n(local word (str \"pe\"))\n(push! word (char \"a\"))\n(clone word)\n=> \"pea\"")
(def main (fn () ((rust "println!(\"{{}}{{}}{{}}\", {&0}, {&1}, {&2})" (where ((part-type-0 display) (part-type-1 display) (part-type-2 display)) (fn ((ref part-type-0) (ref part-type-1) (ref part-type-2)) unit))) str-page get-page push-page)))
