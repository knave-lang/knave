(defstruct user
  :xs (vec (vec int)))

(defstruct animal
  :xs (vec (vec int)))

(defn rows (x) (count (:xs x)))

(defn cells (x)
  (reduce (iter (:xs x)) 0
    (fn (acc r) (+ acc (count r)))))

(defn main ()
  (println (rows (->user (vec (vec 1 2) (vec 3)))))
  (println (cells (->animal (vec (vec 1 2) (vec 3))))))
