(defstruct pet
  :tags (vec int))

(defstruct owner
  :pet pet)

(defstruct keeper
  :pet pet)

(defn tag-pet! (x)
  (set-at! (:tags (:pet x)) 0 7)
  0)

(defn main ()
  (local o (->owner (->pet (vec 1))))
  (tag-pet! o)
  (prn (:tags (:pet o)))
  (local k (->keeper (->pet (vec 2))))
  (tag-pet! k)
  (prn (:tags (:pet k))))
