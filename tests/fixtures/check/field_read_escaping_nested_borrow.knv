(defstruct tag
  :label str)

(defstruct user
  :tag tag
  :nick (option str))

(defstruct animal
  :tag tag
  :nick (option str))

(defn tag-of (x) (:tag x))

(defn nick-of (x) (:nick x))

(defn main ()
  (println (:label (tag-of (->user (->tag "a") none))))
  (println (:label (tag-of (->animal (->tag "b") none))))
  (prn (nick-of (->user (->tag "a") (some "ana"))))
  (prn (nick-of (->animal (->tag "b") none))))
