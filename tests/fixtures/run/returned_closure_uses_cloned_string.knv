(defn greeter! (name)
  (set! name (str "pear"))
  (local value (clone name))
  (fn () (str value)))

(defn renamer! (name)
  (set! name (str "plum"))
  (fn () (str "fixed")))

(defn announcer ()
  (println "ready")
  (fn () 1))

(defn main ()
  (local name (str "apple"))
  (local greet (greeter! name))
  (println (greet) name)
  (local other (str "fig"))
  (local fixed (renamer! other))
  (println (fixed) other)
  (println ((announcer))))
