(use code number-gt number-sub)

(defmacro chains (times)
  ((fn (previous remaining)
     (if (number-gt remaining 0)
       (recur (fn () previous)
              (number-sub remaining 1))
       (quote 1)))
   (fn () 1)
   times))

(with-macro-steps 35000
                  (defn main () (println (chains 2000))))
