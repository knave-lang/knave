(defn scaled! (x f)
  (set! x (+ x 1))
  (local pad 0)
  (fn (y) (f (+ y x))))

(defn shifted! (x xs)
  (set! x (+ x 1))
  (local pad 0)
  (map (iter xs) (fn (i) (+ (deref i) x))))

(defn recorder! (x log)
  (set! x (+ x 1))
  (local pad 0)
  (fn (y) (push! log (+ y x)) (len log)))

(defn main ()
  (local a 1)
  (local g (scaled! a (fn (n) (* n 10))))
  (println (g 1))
  (local b 1)
  (local items (vec 1 2))
  (for-each (shifted! b items)
            (fn (n) (println n)))
  (println a b)
  (local c 1)
  (local entries (vec 0))
  (local record (recorder! c entries))
  (println (record 5) c))
