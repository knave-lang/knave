#[derive(Clone, Copy, PartialEq, Eq, Hash)]
struct Label {
    blank: bool,
}

fn make_label(blank: bool) -> Label {
    Label { blank }
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let first = make_label(false);
    let second = make_label(true);
    let mut labels = vec![&first];
    let r = &labels[0];
    let v = {
        let template_argument_0 = *r;
        template_argument_0.blank.then_some(template_argument_0)
    };
    labels.push(&second);
    println!("{}", v.is_none());
    println!("{}", crate::rt::length(labels.len()))
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn length(value: usize) -> i64 {
        match i64::try_from(value) {
            Ok(length) => length,
            Err(_) => too_long(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn too_long(value: usize) -> ! {
        panic!("length does not fit in int: {value}")
    }
}
