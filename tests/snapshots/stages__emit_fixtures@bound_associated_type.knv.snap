#[derive(Clone, PartialEq, Eq, Hash)]
struct Stack<A> {
    items: Vec<A>,
}

fn count<C: Container<Item = Item>, Item>(c: &C) -> i64 {
    c.size()
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        count(&Stack {
            items: vec![1_i64, 2_i64]
        })
    )
}

trait Container {
    type Item;
    fn size(&self) -> i64;
}

impl<A> Container for Stack<A> {
    type Item = A;
    fn size(&self) -> i64 {
        crate::rt::length(self.items.len())
    }
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn length(value: usize) -> i64 {
        match i64::try_from(value) {
            Ok(length) => length,
            Err(_) => too_long(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn too_long(value: usize) -> ! {
        panic!("length does not fit in int: {value}")
    }
}
