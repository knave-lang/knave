expression: reports.report(path)
input_file: tests/fixtures/emit/returned_closure_holds_borrow_through_binders.knv
---
fn looped(items: &mut Vec<i64>) -> impl FnOnce() -> i64 {
    items.push(1);
    let it = items.iter();
    move || crate::rt::count(it)
}

fn matched(items: &mut Vec<i64>) -> impl FnOnce() -> i64 {
    items.push(1);
    let it = items.iter();
    move || crate::rt::count(it)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut items: Vec<i64> = vec![0_i64];
    println!("{}", looped(&mut items)());
    println!("{}", matched(&mut items)())
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn count(items: impl Iterator) -> i64 {
        let counted = items.count();
        match i64::try_from(counted) {
            Ok(count) => count,
            Err(_) => count_overflow(counted),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn count_overflow(counted: usize) -> ! {
        panic!("attempt to count with overflow: the count is {counted}")
    }
}
