(rust-trait shown "std::fmt::Display"
  i64
  (where ((a shown)) (ref a)))

(def describe
  (rust "{0}.to_string()"
    (where ((a shown)) (fn ((ref a)) str))))

(type borrowed-text
  (fn ((ref (ref str))) str))

(defn borrowed-text (text) (describe text))

(defstruct (pair a b)
  :first a
  :second b)

(defn clone-units ()
  (clone (->pair (do) 1)))

(type one
  (where ((n shown)) (fn (n) n)))

(defn one (value) 1)

(type same?
  (where ((n shown)) (fn (n n) bool)))

(defn same? (left right) (= left right))

(rust-trait everything "Everything" (where (a) a))

(rust-trait labeled "std::fmt::Display" (ref str))

(def to-label
  (rust "{0}.to_string()"
    (where ((a labeled)) (fn (a) str))))

(defn label-of (text)
  (to-label (ref text)))
