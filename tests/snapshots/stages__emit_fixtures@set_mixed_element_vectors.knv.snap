input_file: tests/fixtures/emit/set_mixed_element_vectors.knv
---
fn replace_at<A>(items: &mut [A], index: i64, item: A) {
    items[crate::rt::index(index)] = item
}

fn main() {
    crate::rt::restore_default_sigpipe();
    let mut years: Vec<i64> = vec![2011_i64, 2019_i64];
    replace_at(&mut years, 1, 2024);
    let mut makes = vec!["Nissan", "Honda"];
    replace_at(&mut makes, 0, "Toyota");
    println!("{} {}", years[1], makes[0])
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn index(value: i64) -> usize {
        match usize::try_from(value) {
            Ok(index) => index,
            Err(_) => negative(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn negative(value: i64) -> ! {
        panic!("attempt to use a negative value as an index or a size: {value}")
    }
}
