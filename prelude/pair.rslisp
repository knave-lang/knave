(use prelude/macros document)

(export pair)

(enum (pair a b)
  (rust "({0}, {1})")
  (pair a b))

(def pair
  (rust "({0}, {1})"
    (where (a b) (fn (a b) (pair a b)))))

(document (pair a b)
  "Builds a pair of two values.

  `pair` is also the type `(pair a b)`, Rust's `(A, B)`. In a `match` or a
  `let-match`, `(pair x y)` is the pattern that binds the parts.")

(document (pair/pair a b)
  "Builds the `pair` variant of a pair.

  `pair` is the function for this call.")
