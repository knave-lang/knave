(use prelude/macros defmacro document module template)
(use prelude/internal/macros whole-pairs?)
(use prelude/syntax let)

(use code bool-not concat drop empty? fail field-keyword
          first keyword-name keyword? len list list? nth
          number-sub prepend rest string symbol symbol?
          value-eq)

(module "Returns structs and collections with new values at their keys.

  The call moves the value and returns it with the new values in place.")

(export assoc assoc-in update)

(defmacro assoc (value key more ...)
  "Returns a struct or a collection with new values at its keys.

  A keyword key sets a field, as in `(assoc point :x 1 :y 2)`. An unknown
  field is an error, and a keyword without a value is an error. The call moves
  each field it does not list, unless the field is `copy`.

  Any other key updates a vector or a map, as in `(assoc items 0 9)`. Keys and
  values come in pairs, and each pair updates the result of the one before.
  The call moves the collection.

  A vector index is a [usize], so an [i64] is an error, and the call panics
  when the index is out of bounds. A map key has the type of the map's keys: a
  string literal is a `(ref str)`, so a [string] key takes `(str \"name\")`,
  and a `(ref str)` key takes a literal or `(as-str name)`. A map adds a
  missing key.

  (assoc (vec 1 2) 0 9)
  => (vec 9 2)

  (len (assoc (sorted-map \"pear\" 3) \"fig\" 1))
  => 2"
  (local arguments (prepend key more))
  (if (keyword? key)
    (struct-update value arguments)
    (if (whole-pairs? arguments)
      (collection-updates value arguments)
      (unpaired-key-error value arguments))))

(defmacro update (value key more ...)
  (if (keyword? key)
    (field-update value key more)
    (collection-update value key more)))

(def field-update
  (fn (value key more)
    (if (value-eq (len more) 1)
      (field-update-once value key (first more))
      (field-update-error key more))))

(def field-update-once
  (fn (value key function)
    (local root (read-root value))
    (if (symbol? root)
      (field-replacement value key function)
      (list (quote let)
            (list (quote base) root)
            (field-replacement (rebased-read value root) key function)))))

(def field-replacement
  (fn (value key function)
    (list (quote new)
          (quote _)
          value
          (list key (list function (list key value))))))

(def field-update-error
  (fn (key more)
    (if (empty? more)
      (fail "this field update has no function"
        key
        "write a function after the field, as in `(update item :count neg)`"
        (template (:code update-arguments)))
      (fail "a field update takes no default, because the field always exists"
        (nth more 1)
        "drop the default"
        (template (:code update-arguments))))))

(def collection-update
  (fn (value key more)
    (if (value-eq (len more) 2)
      (list (quote map-at)
            (quote update)
            value key
            (first more)
            (nth more 1))
      (collection-update-error key more))))

(def collection-update-error
  (fn (key more)
    (local message
      "a map update takes a function and a default")
    (local help "write `(update map key function default)`")
    (if (value-eq (len more) 1)
      (fail message
        (first more)
        help
        (template (:code update-arguments
                         :label "no default follows this function")))
      (fail message key help (template (:code update-arguments))))))

(def struct-update
  (fn (value pairs)
    (concat (list (quote new) (quote _) value)
            (field-initializers pairs))))

(def field-initializers
  (fn (pairs)
    (if (empty? pairs)
      (list)
      (prepend (field-initializer (first pairs) (rest pairs))
               (field-initializers (drop pairs 2))))))

(def field-initializer
  (fn (key more)
    (if (keyword? key)
      (if (empty? more)
        (fail "this field has no value"
          key
          "write `:field value` pairs, as in (assoc leaf :year 2025)")
        (list key (first more)))
      (fail "a struct update takes only `:field value` pairs"
        key
        "update the collection in a separate `assoc`"))))

(def collection-updates
  (fn (value pairs)
    (if (empty? pairs)
      value
      (collection-updates (list (quote assoc-at)
                                value
                                (list (first pairs))
                                (nth pairs 1))
                          (drop pairs 2)))))

(def unpaired-key-error
  (fn (value arguments)
    (local message
      "a collection update takes keys and values in pairs")
    (local unpaired-key
      (nth arguments (number-sub (len arguments) 1)))
    (if (every-field-group? arguments)
      (fail message
        unpaired-key
        (string "to update a field, write "
                (concat (list (quote assoc) value)
                        (keyword-arguments arguments))))
      (fail message unpaired-key))))

(def every-field-group?
  (fn (arguments)
    (if (empty? arguments)
      true
      (if (field-group? (first arguments))
        (every-field-group? (rest arguments))
        false))))

(def field-group?
  (fn (form)
    (if (list? form)
      (if (value-eq (len form) 2)
        (field-name? (first form))
        false)
      false)))

(def field-name?
  (fn (form)
    (if (symbol? form)
      (bool-not (keyword? form))
      false)))

(def keyword-arguments
  (fn (arguments)
    (if (empty? arguments)
      (list)
      (concat (keyword-pair (first arguments))
              (keyword-arguments (rest arguments))))))

(def keyword-pair
  (fn (argument)
    (if (field-group? argument)
      (list (field-keyword (first argument))
            (nth argument 1))
      (list argument))))

(defmacro assoc-in (value (step ...) item)
  "Returns a struct or a collection with a new item at a path of steps.

  A keyword step names a field, as in `(assoc-in line (:start :x) 3)`, and the
  call moves each field the path does not change, unless it is `copy`.

  An index step names a vector element, as in `(assoc-in grid (1 0) 7)`. An
  index is a [usize], so an [i64] is an error, and the call panics when it is
  out of bounds. A keyword step after an index step is an error.

  A map key step names a map's value, as in `(assoc-in scores (\"ana\") 7)` or
  `(assoc-in team (:scores \"ana\") 7)`, and adds a missing key. It is the
  last step, and it follows only keyword steps. Its key has the type of the
  map's keys: a string literal is a `(ref str)`, so a [string] key takes
  `(str \"name\")`, and a `(ref str)` key takes a literal or `(as-str name)`.

  A path of only index or map key steps moves the collection.

  (assoc-in (vec (vec 1 2) (vec 3)) (1 0) 7)
  => (vec (vec 1 2) (vec 7))

  (local scores (assoc-in (sorted-map \"ana\" 1) (\"bo\") 7))
  (get scores \"bo\")
  => (some (ref 7))"
  (local root (read-root value))
  (if (bound-root? root value step)
    (list (quote let)
          (list (quote base) root)
          (path-update (rebased-read value root) step item))
    (path-update value step item)))

(def bound-root?
  (fn (root value path)
    (if (symbol? root)
      false
      (if (value-eq root value)
        (bool-not (empty? (keyword-steps path)))
        true))))

(def read-root
  (fn (form)
    (if (list? form)
      (if (value-eq (len form) 2)
        (if (keyword? (first form))
          (read-root (nth form 1))
          form)
        form)
      form)))

(def rebased-read
  (fn (form root)
    (if (value-eq form root)
      (quote base)
      (list (first form)
            (rebased-read (nth form 1) root)))))

(def keyword-steps
  (fn (path)
    (if (empty? path)
      path
      (if (keyword? (first path))
        path
        (keyword-steps (rest path))))))

(def path-update
  (fn (base path item)
    (local fields (keyword-steps path))
    (if (empty? fields)
      (list (quote assoc-at) base path item)
      (if (keyword? (first path))
        (field-step base (first path) (rest path) item)
        (fail "a field step cannot follow an index step"
          (first fields))))))

(def field-step
  (fn (base key path item)
    (local field
      (symbol (quote base) (keyword-name key)))
    (if (empty? path)
      (list (quote assoc) base key item)
      (list (quote let)
            (list field (path-update (list key base) path item))
            (list (quote assoc) base key field)))))

(document (update value key function default)
  "Applies a function to a field of a struct, or to the value at a map's key.

  With a keyword key, `(update item :count neg)` returns the struct with the
  field replaced by the function's result, and takes no default. The function
  takes the field as `(:count item)` reads it, which borrows a field that is
  not `copy`, so a function that owns its argument is an error. Rust itself
  could move the field, and RFC 0059 leaves that open. The call moves the
  struct's other fields. A base that reads fields from a name updates in
  place, and a base rooted in a call runs once.

  With any other key, the call applies the function to the value at the key
  and returns the map.

  `function` takes the value at `key`, or `default` when the key is missing,
  and the result is stored at `key`. `default` runs before the call, whether
  or not the call uses it. The call moves the map.

  `key` has the type of the map's keys: a string literal is a `(ref str)`, so
  a [string] key takes `(str \"name\")`, and a `(ref str)` key takes
  `(as-str name)`.

  (local scores (update (sorted-map \"ana\" 1) \"ana\" (fn (n) (+ n 1)) 0))
  (get scores \"ana\")
  => (some (ref 2))

  (local more (update scores \"bo\" (fn (n) (+ n 1)) 0))
  (get more \"bo\")
  => (some (ref 1))")
