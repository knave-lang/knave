(use code concat empty? first list list? rest same-binding?
          symbol?)

(use prelude/macros defmacro)
(use prelude/vec at)

(export set!)

(def set-place!
  (rust "*{0} = {1}"
    (where (a) (fn ((mut a) a) unit))))

(def at-form?
  (fn (form)
    (if (list? form)
      (if (empty? form)
        false
        (if (symbol? (first form))
          (same-binding? (first form) (quote at))
          false))
      false)))

(def at-base
  (fn (form)
    (if (at-form? form)
      (at-base (first (rest form)))
      form)))

(def at-indices
  (fn (form)
    (if (at-form? form)
      (concat (at-indices (first (rest form)))
              (list (first (rest (rest form)))))
      (list))))

(defmacro set! (target value)
  "Changes a local, a field or an element in place.

  The target is a name, a field read such as `(:x (:start line))`, an `at`
  form such as `(at (:items order) 0)`, or a `(mut a)`. A field of an `at`
  form, as in `(:x (at points 0))`, is an error, and so is any other target.

  An `at` index is a `usize`, so an `i64` is an error, and a vector panics
  when the index is out of bounds. A map panics on a missing key. A map key
  must fit the map's key type: a `(ref str)` key takes a literal or
  `(as-str name)`, and a `string` is an error.

  A `set!` of a whole parameter changes the caller's variable, for every
  type, unless the function also moves it: then the caller gives the value
  up. A parameter written by value, as `(count i64)`, and a closure's own
  parameter stay local to the body.

  A function cannot return a closure that uses a parameter it also changes,
  which is `L0517`. Copy the value into a local first, and use the local in
  the closure. Write `(local value start)` for a `copy` type,
  `(local value (deref start))` for a written `(mut i64)`, and
  `(local value (clone start))` for any other type. The closure's changes
  then reach only its own copy.

  It returns `unit`, which prints as `(do)`.

  (local total 1)
  (set! total 2)
  (= total 2)
  => true

  (local items (vec 1 2))
  (set! (at items 0) 9)
  (clone items)
  => (vec 9 2)

  ```
  (defn bump! (count)
    (set! count (+ count 1)))

  (local total 1)
  (bump! total)
  total
  => 2
  ```"
  (if (at-form? target)
    (list (quote set-at)
          (at-base target)
          (at-indices target)
          value)
    (list (quote set-place!) target value)))
