---
source: tests/stages.rs
expression: reports.report(path)
input_file: tests/fixtures/emit/generic_function_value_changed.knv
---
fn change(items: &mut Vec<i64>) -> i64 {
    items.push(1);
    crate::rt::length(items.len())
}

fn apply_one(f: impl FnOnce(Vec<i64>) -> i64, a: Vec<i64>) -> i64 {
    f(a)
}

fn main() {
    crate::rt::restore_default_sigpipe();
    println!(
        "{}",
        apply_one(|mut argument: Vec<i64>| change(&mut argument), Vec::new())
    )
}

mod rt {
    #[cfg(unix)]
    pub fn restore_default_sigpipe() {
        const SIGPIPE: i32 = 13;
        const DEFAULT_HANDLER: usize = 0;
        unsafe extern "C" {
            fn signal(signal: i32, handler: usize) -> usize;
        }
        unsafe {
            signal(SIGPIPE, DEFAULT_HANDLER);
        }
    }

    #[cfg(not(unix))]
    pub fn restore_default_sigpipe() {}

    #[inline]
    #[track_caller]
    pub fn length(value: usize) -> i64 {
        match i64::try_from(value) {
            Ok(length) => length,
            Err(_) => too_long(value),
        }
    }

    #[cold]
    #[inline(never)]
    #[track_caller]
    fn too_long(value: usize) -> ! {
        panic!("length does not fit in int: {value}")
    }
}
