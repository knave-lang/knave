(defstruct user
  :name str)

(defstruct animal
  :name str)

(deftrait has-name
  (label (fn ((ref self)) string)))

(impl has-name user
  (label (self) (str "u")))

(defn hello (x)
  (str "hello " (:name x)))

(defn main ()
  (println (label (->user "a")))
  (println (hello (->user "ana")))
  (println (hello (->animal "rex"))))
