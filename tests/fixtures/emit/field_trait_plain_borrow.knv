(defstruct user
  :name str)

(defstruct animal
  :name str)

(type uppercase-name
  (where ((a (has :name (ref str))))
    (fn ((ref a)) string)))

(defn uppercase-name (x)
  (upper-case (:name x)))

(type hello
  (where ((a (has :name (ref str))))
    (fn ((ref a)) string)))

(defn hello (x)
  (str "hello " (:name x)))

(defn main ()
  (println (uppercase-name (->user "ana")))
  (println (uppercase-name (->animal "rex")))
  (println (hello (->user "ana")))
  (println (hello (->animal "rex"))))
