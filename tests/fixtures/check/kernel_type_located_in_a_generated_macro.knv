(use code located)

(defmacro define-macro (name params body)
  (template (defmacro (unquote name) (unquote params)
              (do (unquote body)))))

(define-macro make-float
              (place)
              (template (defstruct (unquote (located place (quote float)))
                          :n bool)))

(make-float (here))

(defn main () (println 1))
