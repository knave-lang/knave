(defenum unnamed-variant 3)

(defenum keyword-variant :circle)

(defenum struct-payload
  (labeled (struct (text str))))

(defenum field-after-type (labeled str :size f64))

(defenum type-after-field (labeled :text str f64))

(defenum field-without-type (labeled :text :size f64))

(defenum last-field-without-type (labeled :text))

(defenum late-rust
  circle
  (rust "Path"))

(defenum path-only
  (rust "Holder")
  (hold i64))

(defenum two-string-clause
  (rust "Holder" "Other")
  circle)

(defenum word-clause
  (rust "Holder" plain)
  circle)

(defenum 3 circle)
