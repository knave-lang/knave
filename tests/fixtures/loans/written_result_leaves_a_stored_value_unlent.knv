(type keep-other! (where ('a 'b) (fn ((mut (vec (ref 'a str))) (ref 'a str) (ref 'b str)) (ref 'b str))))
(defn keep-other! (names name other) (push! names name) other)
(defn main ()
  (local ns (vec "x"))
  (local t (str "a"))
  (local u (str "u"))
  (local r (keep-other! ns (as-str t) (as-str u)))
  (push! t (char "b"))
  (println r))
